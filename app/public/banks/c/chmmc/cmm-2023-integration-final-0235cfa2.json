{"chmmc-cmm-2023-integration-final-01":{"prompt":"Evaluate $\\displaystyle\\int_{1}^{e} \\frac{\\cos(\\ln x)}{x}\\,dx$.","answer":"sin(1)","answerDisplay":"$\\sin 1$"},"chmmc-cmm-2023-integration-final-02":{"prompt":"Find $\\displaystyle\\int \\frac{\\cos x\\,\\csc x}{\\cot x}\\,dx$ (include $+C$).","answer":"$x+C$"},"chmmc-cmm-2023-integration-final-03":{"prompt":"Find $\\displaystyle\\int \\sin(\\cos(\\cos x))\\cdot\\sin(\\cos x)\\cdot\\sin x\\,dx$ (include $+C$).","answer":"$-\\cos(\\cos(\\cos x))+C$"},"chmmc-cmm-2023-integration-final-04":{"prompt":"Evaluate $\\displaystyle\\int_{-1}^{1} x^2\\sqrt[3]{x^3+1}\\,dx$.","answer":"cbrt(2)/2","answerDisplay":"$\\frac{\\sqrt[3]{2}}{2}$"},"chmmc-cmm-2023-integration-final-05":{"prompt":"Find $\\displaystyle\\int \\sqrt{\\sec x}\\cdot\\tan x\\,dx$ (include $+C$).","answer":"$2\\sqrt{\\sec x}+C$"},"chmmc-cmm-2023-integration-final-06":{"prompt":"Find $\\displaystyle\\int e^{e^x+x}\\,dx$ (include $+C$).","answer":"$e^{e^x}+C$"},"chmmc-cmm-2023-integration-final-07":{"prompt":"Evaluate $\\displaystyle\\int_{1}^{10} \\left(e^{\\ln x}+\\ln e^{x}\\right)\\,dx$.","answer":"99"},"chmmc-cmm-2023-integration-final-08":{"prompt":"Evaluate $\\displaystyle\\int_{-2023}^{2023} \\frac{\\sin x}{x^2+1}\\,dx$.","answer":"0"},"chmmc-cmm-2023-integration-final-09":{"prompt":"Evaluate $\\displaystyle\\int_{0}^{1} \\frac{x}{x^4+1}\\,dx$.","answer":"pi/8","answerDisplay":"$\\frac{\\pi}{8}$"},"chmmc-cmm-2023-integration-final-10":{"prompt":"Find $\\displaystyle\\int \\frac{1}{x\\sqrt{1-(\\ln x)^2}}\\,dx$ (include $+C$).","answer":"$\\arcsin(\\ln x)+C$"},"chmmc-cmm-2023-integration-final-11":{"prompt":"Find $\\displaystyle\\int \\frac{1}{e^x+e^{-x}}\\,dx$ (include $+C$).","answer":"$\\arctan(e^x)+C$"},"chmmc-cmm-2023-integration-final-12":{"prompt":"Evaluate $\\displaystyle\\int_{0}^{1} (x-1)^2(x+1)^2(x^2+1)^2(x^4+1)^2\\,dx$.","answer":"128/153","answerDisplay":"$\\frac{128}{153}$"},"chmmc-cmm-2023-integration-final-13":{"prompt":"Evaluate $\\displaystyle\\int_{\\frac13}^{3} \\ln\\!\\left(e^{\\lfloor 1/x\\rfloor}\\right)\\,dx$.","answer":"5/6","answerDisplay":"$\\frac56$"},"chmmc-cmm-2023-integration-final-14":{"prompt":"Evaluate $\\displaystyle\\int_{-\\infty}^{\\infty} \\frac{x\\,e^{-x^2}}{\\ln(x^2+2)}\\,dx$.","answer":"0"},"chmmc-cmm-2023-integration-final-15":{"prompt":"Evaluate $\\displaystyle\\int_{0}^{3} \\left(\\lceil x\\rceil\\cdot x^{\\lceil x\\rceil}-\\lfloor x\\rfloor\\right)\\,dx$.","answer":"611/12","answerDisplay":"$\\frac{611}{12}$"},"chmmc-cmm-2023-integration-final-16":{"prompt":"Evaluate $\\displaystyle\\int_{0}^{1} \\sin\\!\\left(\\sqrt[3]{x}\\right)\\,dx$.","answer":"6*sin(1)+3*cos(1)-6","answerDisplay":"$6\\sin 1+3\\cos 1-6$"},"chmmc-cmm-2023-integration-final-17":{"prompt":"Evaluate $\\displaystyle\\int_{0}^{2\\pi} \\max\\{\\sin x,\\cos x\\}\\,dx$.","answer":"2*sqrt(2)","answerDisplay":"$2\\sqrt2$"},"chmmc-cmm-2023-integration-final-18":{"prompt":"Find $\\displaystyle\\int \\cos x\\,\\csc x\\,\\cot x\\,dx$ (include $+C$).","answer":"$-x-\\cot x+C$"},"chmmc-cmm-2023-integration-final-19":{"prompt":"Find $\\displaystyle\\int \\frac{-x\\,e^{\\frac{-1}{1-x^2}}}{(1-x^2)^2}\\,dx$ (include $+C$).","answer":"$\\frac12e^{-\\frac1{1-x^2}}+C$"},"chmmc-cmm-2023-integration-final-20":{"prompt":"Find $\\displaystyle\\int \\frac{x^{-1/2}}{1+x^{1/3}}\\,dx$ (include $+C$).","answer":"$6x^{1/6}-6\\arctan\\left(x^{1/6}\\right)+C$"},"chmmc-cmm-2023-integration-final-21":{"prompt":"Find $\\displaystyle\\int \\frac{x^2+\\cos^2x}{(1+x^2)\\sin^2x}\\,dx$ (include $+C$).","answer":"$-\\arctan x-\\cot x+C$"},"chmmc-cmm-2023-integration-final-22":{"prompt":"Find $\\displaystyle\\int \\frac{e^{2x}-1}{\\sqrt{e^{3x}+e^{x}}}\\,dx$ (include $+C$).","answer":"$2\\sqrt{e^x+e^{-x}}+C$ (equivalently $2e^{-x}\\sqrt{e^{3x}+e^x}+C$)"},"chmmc-cmm-2023-integration-final-23":{"prompt":"Find $\\displaystyle\\int \\frac{\\sin(\\ln x)}{x^3}\\,dx$ (include $+C$).","answer":"$-\\frac{\\cos(\\ln x)+2\\sin(\\ln x)}{5x^2}+C$"},"chmmc-cmm-2023-integration-final-24":{"prompt":"Evaluate $\\displaystyle\\int_{0}^{1} x\\ln^2x\\,dx$.","answer":"1/4","answerDisplay":"$\\frac14$"},"chmmc-cmm-2023-integration-final-25":{"prompt":"Find $\\displaystyle\\int \\left(x^2\\cos\\frac1x+\\frac x3\\sin\\frac1x\\right)\\,dx$ (include $+C$).","answer":"$\\frac{x^3}3\\cos\\frac1x+C$"},"chmmc-cmm-2023-integration-final-26":{"prompt":"Evaluate $\\displaystyle\\int_{1}^{e} \\left(2\\ln x+(\\ln x)^2\\right)\\,dx$.","answer":"e","answerDisplay":"$e$"},"chmmc-cmm-2023-integration-final-27":{"prompt":"Evaluate $\\displaystyle\\int_0^3\\max\\left\\{\\sqrt{1-(x-1)^2},\\ \\sqrt{1-(x-2)^2}\\right\\}dx$.","answer":"2*pi/3+sqrt(3)/4","answerDisplay":"$\\frac{2\\pi}{3}+\\frac{\\sqrt3}{4}$","reviewNote":"Official key sqrt(3)/4+pi/6 is wrong (about 0.957; the solution computes an overlap area, never subtracts it from pi, and the overlap itself is miscomputed). Direct integration and numerics give 2*pi/3+sqrt(3)/4 (about 2.527), stored here."},"chmmc-cmm-2023-integration-final-28":{"prompt":"Find $\\displaystyle\\int \\frac{e^x-1}{e^x+1}\\,dx$ (include $+C$).","answer":"$2\\ln(e^x+1)-x+C$ (equivalently $2\\ln(e^{-x}+1)+x+C$)"},"chmmc-cmm-2023-integration-final-29":{"prompt":"Evaluate $\\displaystyle\\int_{0}^{1} 2^{\\lfloor\\log_2x\\rfloor}\\,dx$.","answer":"1/3","answerDisplay":"$\\frac13$"},"chmmc-cmm-2023-integration-final-30":{"prompt":"Evaluate $\\displaystyle\\int_{0}^{1} \\frac{x^2-2x}{x^3+1}\\,dx$.","answer":"ln(2)-2*pi*sqrt(3)/9","answerDisplay":"$\\ln2-\\frac{2\\pi\\sqrt3}{9}$"},"chmmc-cmm-2023-integration-final-31":{"prompt":"Evaluate $\\displaystyle\\int_{0}^{\\pi/4} \\frac{\\tan x+2\\sec^2x+2\\tan x\\sec^2x}{\\tan x+\\sec^2x}\\,dx$.","answer":"pi/4+ln(3)","answerDisplay":"$\\frac{\\pi}{4}+\\ln 3$"},"chmmc-cmm-2023-integration-final-32":{"prompt":"Evaluate $\\displaystyle\\int_{0}^{1} (x^6+x^4+x^2)\\sqrt{2x^4+3x^2+6}\\,dx$.","answer":"11*sqrt(11)/18","answerDisplay":"$\\frac{11\\sqrt{11}}{18}$"},"chmmc-cmm-2023-integration-final-33":{"prompt":"Evaluate the Riemann-Stieltjes integral $\\displaystyle\\int_0^3(x^2+1)\\,d\\lfloor x\\rfloor$.","answer":"17"},"chmmc-cmm-2023-integration-final-34":{"prompt":"Evaluate $\\displaystyle\\int_{0}^{\\pi} \\frac{1-\\sin x}{1+\\sin x}\\,dx$.","answer":"4-pi","answerDisplay":"$4-\\pi$"},"chmmc-cmm-2023-integration-final-35":{"prompt":"Find $\\displaystyle\\int \\frac{e^{3x}(6x-5)}{(2x-1)^2}\\,dx$ (include $+C$).","answer":"$\\frac{e^{3x}}{2x-1}+C$"},"chmmc-cmm-2023-integration-final-36":{"prompt":"Evaluate $\\displaystyle\\int_{1}^{2} \\frac{9x+4}{x^5+3x^2+x}\\,dx$.","answer":"ln(80/23)","answerDisplay":"$\\ln\\frac{80}{23}$"},"chmmc-cmm-2023-integration-final-37":{"prompt":"Find $\\displaystyle\\int \\ln(x^2+1)\\,dx$ (include $+C$).","answer":"$x\\ln(x^2+1)-2x+2\\arctan x+C$"},"chmmc-cmm-2023-integration-final-38":{"prompt":"Find $\\displaystyle\\int \\frac{(x^2+1)(x^2+4)}{(x^2+2)(x^2+3)}\\,dx$ (include $+C$).","answer":"$x-\\sqrt2\\arctan\\frac{x}{\\sqrt2}+\\frac2{\\sqrt3}\\arctan\\frac{x}{\\sqrt3}+C$"},"chmmc-cmm-2023-integration-final-39":{"prompt":"Evaluate $\\displaystyle\\int_{0}^{1} \\lfloor\\log_{2023}x\\rfloor\\,dx$.","answer":"-2023/2022","answerDisplay":"$-\\frac{2023}{2022}$"},"chmmc-cmm-2023-integration-final-40":{"prompt":"Find $\\displaystyle\\int \\frac{x-1}{\\sqrt{2x^2-3}}\\,dx$ (include $+C$).","answer":"$\\frac{\\sqrt{2x^2-3}}2-\\frac{\\ln\\left|\\sqrt{2x^2-3}+\\sqrt2\\,x\\right|}{\\sqrt2}+C$"}}