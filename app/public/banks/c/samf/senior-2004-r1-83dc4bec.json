{"samf-senior-2004-r1-01":{"prompt":"$(0.2)^4$ equals","choices":[{"key":"A","text":"$0.8$"},{"key":"B","text":"$0.16$"},{"key":"C","text":"$0.0016$"},{"key":"D","text":"$0.000016$"},{"key":"E","text":"$0.0008$"}],"answer":"C"},"samf-senior-2004-r1-02":{"prompt":"The height of the tallest building on earth is about","choices":[{"key":"A","text":"$400$ m"},{"key":"B","text":"$40$ m"},{"key":"C","text":"$4\\,000$ m"},{"key":"D","text":"$4$ m"},{"key":"E","text":"$40\\,000$ m"}],"answer":"A"},"samf-senior-2004-r1-03":{"prompt":"$\\dfrac{37^2+111}{37}$ equals","choices":[{"key":"A","text":"$4$"},{"key":"B","text":"$40$"},{"key":"C","text":"$113$"},{"key":"D","text":"$148$"},{"key":"E","text":"$37$"}],"answer":"B"},"samf-senior-2004-r1-04":{"prompt":"$\\dfrac{4444^4}{2222^4}$ equals","choices":[{"key":"A","text":"$8888$"},{"key":"B","text":"$2222^4$"},{"key":"C","text":"$2$"},{"key":"D","text":"$2222$"},{"key":"E","text":"$16$"}],"answer":"E"},"samf-senior-2004-r1-05":{"prompt":"Four identical circles fit inside a square as shown. Their centres are the vertices of the smaller square. If the smaller square has area 4, then the area of the larger square is","image":"qimages/samf/senior-2004-r1/q05.webp","choices":[{"key":"A","text":"$16$"},{"key":"B","text":"$8$"},{"key":"C","text":"$4\\sqrt2$"},{"key":"D","text":"$12$"},{"key":"E","text":"$4\\pi$"}],"answer":"A"},"samf-senior-2004-r1-06":{"prompt":"$1-\\dfrac{1-\\dfrac{1/2}{1+1/2}}{1+\\dfrac{1+1/2}{1-1/2}}$ equals","choices":[{"key":"A","text":"$\\frac79$"},{"key":"B","text":"$\\frac56$"},{"key":"C","text":"$\\frac12$"},{"key":"D","text":"$\\frac13$"},{"key":"E","text":"$\\frac34$"}],"answer":"B"},"samf-senior-2004-r1-07":{"prompt":"If $17x+51y=85$, then $13x+39y$ is","choices":[{"key":"A","text":"impossible to determine"},{"key":"B","text":"$61$"},{"key":"C","text":"$63$"},{"key":"D","text":"$65$"},{"key":"E","text":"$67$"}],"answer":"D"},"samf-senior-2004-r1-08":{"prompt":"In the sequence $\\ldots,k,m,n,p,0,1,1,2,3,5,8,\\ldots$ each term is the sum of the two terms on its left. The value of $k$ is","choices":[{"key":"A","text":"$-2$"},{"key":"B","text":"$3$"},{"key":"C","text":"$-3$"},{"key":"D","text":"$2$"},{"key":"E","text":"$-1$"}],"answer":"C"},"samf-senior-2004-r1-09":{"prompt":"$2004^2-2003\\times2005$ equals","choices":[{"key":"A","text":"$0$"},{"key":"B","text":"$1$"},{"key":"C","text":"$-1$"},{"key":"D","text":"$2004$"},{"key":"E","text":"$2001$"}],"answer":"B"},"samf-senior-2004-r1-10":{"prompt":"For how many integer values of $n$ is $\\dfrac{n+3}{n-1}$ an integer?","choices":[{"key":"A","text":"$7$"},{"key":"B","text":"$6$"},{"key":"C","text":"$5$"},{"key":"D","text":"$2$"},{"key":"E","text":"$8$"}],"answer":"B"},"samf-senior-2004-r1-11":{"prompt":"In the diagram $ABCD$ is a rectangle with $AB=\\sqrt3$ and $BC=1$. $AFED$ and $FBGH$ are squares. The length of $HE$ is","image":"qimages/samf/senior-2004-r1/q11.webp","choices":[{"key":"A","text":"$2-\\sqrt3$"},{"key":"B","text":"$2\\sqrt3-3$"},{"key":"C","text":"$\\frac{\\sqrt3}{6}$"},{"key":"D","text":"$7\\sqrt3-12$"},{"key":"E","text":"$\\sqrt3+2$"}],"answer":"A"},"samf-senior-2004-r1-12":{"prompt":"The number of prime numbers $p$ such that $p+1$ is a square is","choices":[{"key":"A","text":"$1$"},{"key":"B","text":"$0$"},{"key":"C","text":"$4$"},{"key":"D","text":"$3$"},{"key":"E","text":"infinite"}],"answer":"A"},"samf-senior-2004-r1-13":{"prompt":"If $2^2\\times3^3\\times4^4\\times5^{11}$ is multiplied out, then the sum of the digits is","choices":[{"key":"A","text":"$9$"},{"key":"B","text":"$207$"},{"key":"C","text":"$14$"},{"key":"D","text":"$135$"},{"key":"E","text":"$814$"}],"answer":"A"},"samf-senior-2004-r1-14":{"prompt":"$ABCD$ is a parallelogram. $F$ is the midpoint of $AD$ and $N$ is the midpoint of $AB$. The ratio of the area of $\\triangle AFN$ to the area of quadrilateral $FNCD$ is","image":"qimages/samf/senior-2004-r1/q14.webp","choices":[{"key":"A","text":"$\\frac27$"},{"key":"B","text":"$\\frac16$"},{"key":"C","text":"$\\frac15$"},{"key":"D","text":"$\\frac14$"},{"key":"E","text":"$\\frac13$"}],"answer":"C"},"samf-senior-2004-r1-15":{"prompt":"The number of natural numbers less than $100\\,000$ which have 9 as their first digit is","choices":[{"key":"A","text":"$10\\,000$"},{"key":"B","text":"$11\\,110$"},{"key":"C","text":"$10\\,001$"},{"key":"D","text":"$9\\,999$"},{"key":"E","text":"$11\\,111$"}],"answer":"E"},"samf-senior-2004-r1-16":{"prompt":"The diagram shows a regular 9-sided polygon. The size of angle $FAE$, in degrees, is","image":"qimages/samf/senior-2004-r1/q16.webp","choices":[{"key":"A","text":"$10$"},{"key":"B","text":"$20$"},{"key":"C","text":"$30$"},{"key":"D","text":"$40$"},{"key":"E","text":"$25$"}],"answer":"B"},"samf-senior-2004-r1-17":{"prompt":"The right-angled triangle $ABC$ has sides with lengths $a$ and $b$ as shown. The ratio of the area of the shaded square to the area of triangle $ABC$ is","image":"qimages/samf/senior-2004-r1/q17.webp","choices":[{"key":"A","text":"$\\frac{ab}{a+b}$"},{"key":"B","text":"$\\frac{ab}{(b-a)^2}$"},{"key":"C","text":"$\\frac{2ab}{a^2+b^2}$"},{"key":"D","text":"$\\frac{2ab}{(a+b)^2}$"},{"key":"E","text":"$\\frac{ab}{(a+b)^2}$"}],"answer":"D"},"samf-senior-2004-r1-18":{"prompt":"$\\sqrt{2+\\sqrt3}-\\sqrt{2-\\sqrt3}$ equals","choices":[{"key":"A","text":"$2$"},{"key":"B","text":"$\\sqrt2$"},{"key":"C","text":"$\\sqrt3$"},{"key":"D","text":"$1$"},{"key":"E","text":"$12\\frac14$"}],"answer":"B"},"samf-senior-2004-r1-19":{"prompt":"In the diagram, $MP$ is the perpendicular bisector of $BC$ and the length of $AB$ is 1. The length of $MP$ is","image":"qimages/samf/senior-2004-r1/q19.webp","choices":[{"key":"A","text":"$\\frac{a}{\\sqrt{2a^2-1}}$"},{"key":"B","text":"$a\\sqrt{4a^2-1}$"},{"key":"C","text":"$\\frac{a}{\\sqrt{4a^2+1}}$"},{"key":"D","text":"$\\frac{a}{\\sqrt{4a^2-1}}$"},{"key":"E","text":"$\\frac12$"}],"answer":"D"},"samf-senior-2004-r1-20":{"prompt":"A semi-circle is inscribed in an isosceles right-angled triangle as shown (legs of length 1). The radius of the semi-circle is","image":"qimages/samf/senior-2004-r1/q20.webp","choices":[{"key":"A","text":"$\\frac1{\\sqrt2}$"},{"key":"B","text":"$3-2\\sqrt2$"},{"key":"C","text":"$\\frac12$"},{"key":"D","text":"$2-\\sqrt2$"},{"key":"E","text":"$\\sqrt2-1$"}],"answer":"E"}}