{"smt-2025-integration-bee-01":{"prompt":"Evaluate $\\int\\frac{1}{x+\\sqrt x}\\,dx$.","answer":"$2\\ln\\left(\\sqrt x+1\\right)+C$"},"smt-2025-integration-bee-02":{"prompt":"Evaluate $\\int_0^\\infty\\frac{4x}{1+x^4}\\,dx$.","answer":"pi","answerDisplay":"$\\pi$"},"smt-2025-integration-bee-03":{"prompt":"Evaluate $\\int_1^\\infty\\frac{1}{x^2\\sqrt{x^2-1}}\\,dx$.","answer":"1"},"smt-2025-integration-bee-04":{"prompt":"Evaluate $\\int_1^\\infty\\left(\\ln\\left(1+\\frac1x\\right)-\\frac1{x+1}\\right)dx$.","answer":"1-ln(2)","answerDisplay":"$1-\\ln2$"},"smt-2025-integration-bee-05":{"prompt":"Evaluate $\\int\\frac{\\sin^4\\theta}{\\cos\\theta}\\,d\\theta$.","answer":"$-\\frac{\\sin^3\\theta}{3}-\\sin\\theta+\\ln|\\sec\\theta+\\tan\\theta|+C$"},"smt-2025-integration-bee-06":{"prompt":"Evaluate $\\int_0^\\infty\\left(2-\\frac{x}{\\sqrt{x^2+\\pi^2}}-\\frac{x}{\\sqrt{x^2+e^2}}\\right)dx$.","answer":"e+pi","answerDisplay":"$e+\\pi$"},"smt-2025-integration-bee-07":{"prompt":"Evaluate $\\int_{-1}^{8}\\sqrt x\\,\\sin\\left(\\tan^{-1}(\\sqrt x)\\right)dx$.","answer":"12"},"smt-2025-integration-bee-08":{"prompt":"Evaluate $\\int\\frac{\\sin2x}{1+\\cos x}\\,dx$.","answer":"$2\\ln(1+\\cos x)-2\\cos x+C$"},"smt-2025-integration-bee-09":{"prompt":"Evaluate $\\int\\frac{x+1}{x^2+x\\ln x}\\,dx$.","answer":"$\\ln|x+\\ln x|+C$"},"smt-2025-integration-bee-10":{"prompt":"Evaluate $\\int_0^{3/2}\\sqrt{1+\\sqrt{x^2+\\sqrt{x^6+\\sqrt{x^{14}+\\sqrt{x^{30}+\\cdots}}}}}\\,dx$.","answer":"3/2+ln(2)","answerDisplay":"$\\frac32+\\ln2$"},"smt-2025-integration-bee-11":{"prompt":"Evaluate $\\int_0^{3/2}\\cfrac{1}{x+\\cfrac{1}{x+\\cdots}}\\,dx$.","answer":"3/8+ln(2)","answerDisplay":"$\\frac38+\\ln2$","reviewNote":"Official key says 16 ln 2 + 3, but numerical integration gives 1.0681 = 3/8 + ln 2; stored the verified value."},"smt-2025-integration-bee-12":{"prompt":"Evaluate $\\int_0^{\\pi}\\frac{6+6\\cos^2x}{1+3\\sin^2x}\\,dx$.","answer":"5*pi","answerDisplay":"$5\\pi$"},"smt-2025-integration-bee-13":{"prompt":"Evaluate $\\int_0^1\\left(\\sqrt{x+x^3}+\\sqrt{x+\\sqrt[3]x}\\right)dx$.","answer":"4*sqrt(2)/3","answerDisplay":"$\\frac{4\\sqrt2}{3}$"},"smt-2025-integration-bee-14":{"prompt":"Evaluate $\\int_0^{\\pi/4}\\sum_{n=2}^{\\infty}\\left(\\frac1{\\sqrt{n-\\sec^2x}}-\\frac1{\\sqrt{n-\\tan^2x}}\\right)dx$.","answer":"pi/(2*sqrt(2))","answerDisplay":"$\\frac{\\pi}{2\\sqrt2}$"},"smt-2025-integration-bee-15":{"prompt":"Evaluate $\\int_{\\pi/4}^{\\pi/2}\\frac{4\\log^2\\left(\\csc^2x\\right)}{\\tan x}\\,dx$. (Here $\\log$ is the natural logarithm.)","answer":"2*ln(2)^3/3","answerDisplay":"$\\frac23\\ln^32$","acceptedAnswers":["2*ln(2)/3"],"reviewNote":"Official key says log^2(2), which is the value if the integrand had log (not log squared). As printed, log^2(csc^2 x) gives (2/3)ln^3 2 (natural log). If log means log base 2, the value is (2/3)ln 2, accepted as an alternative."},"smt-2025-integration-bee-16":{"prompt":"Evaluate $\\int e^{17x}\\left(\\cos^3x-3\\sin^2x\\cos x\\right)dx$.","answer":"$\\frac{e^{17x}\\left(17\\cos3x+3\\sin3x\\right)}{298}+C$"},"smt-2025-integration-bee-17":{"prompt":"Evaluate $\\int e^{x\\tan^{-1}(x)}\\frac{\\tan^{-1}(x)}{\\sqrt{x^2+1}}\\,dx$.","answer":"$e^{x\\tan^{-1}x-\\frac12\\ln(x^2+1)}+C=\\dfrac{e^{x\\tan^{-1}x}}{\\sqrt{x^2+1}}+C$"},"smt-2025-integration-bee-18":{"prompt":"Evaluate $\\int_0^{\\varphi}e^{x-\\frac1x}(x+1)^2\\,dx$. (Here $\\varphi=\\frac{1+\\sqrt5}2$ is the golden ratio.)","answer":"(3+sqrt(5))/2*e","answerDisplay":"$\\varphi^2e=\\frac{3+\\sqrt5}{2}e$"},"smt-2025-integration-bee-19":{"prompt":"Evaluate $\\int\\left(\\frac1{x^5+x^3}-\\frac{3\\tan^{-1}(x)}{x^4}\\right)dx$.","answer":"$\\dfrac{\\tan^{-1}(x)}{x^3}+C$"},"smt-2025-integration-bee-20":{"prompt":"Evaluate $\\int_0^{\\pi/4}\\frac{1}{\\sqrt[4]2+\\sqrt{1+\\tan x}}\\,dx$.","answer":"pi/(8*2^(1/4))","answerDisplay":"$\\frac{\\pi}{8\\sqrt[4]{2}}$"}}