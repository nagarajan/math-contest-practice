xt":"5"}],"answer":"C","topics":["number-theory"],"difficulty":2,"p":0,"n":17},{"id":"samf-junior-1998-r2-15","points":7,"type":"mc","prompt":"How many black tiles will be required to build the $15^{\\text{th}}$ figure in the given pattern?","image":"qimages/samf/junior-1998-r2/q15.webp","choices":[{"key":"A","text":"403"},{"key":"B","text":"365"},{"key":"C","text":"481"},{"key":"D","text":"421"},{"key":"E","text":"225"}],"answer":"D","topics":["patterns"],"difficulty":3,"p":1,"n":15},{"id":"samf-junior-1998-r2-19","points":7,"type":"mc","prompt":"The houses and trees in the diagram are all in a straight line. In each of the six houses lives a child. At which tree should the children meet so that the sum of the distances they walk to that tree is a minimum?","image":"qimages/samf/junior-1998-r2/q19.webp","choices":[{"key":"A","text":"A"},{"key":"B","text":"B"},{"key":"C","text":"C"},{"key":"D","text":"D"},{"key":"E","text":"Impossible to determine."}],"answer":"D","topics":["logic","geometry"],"difficulty":3,"p":1,"n":19},{"id":"samf-junior-1999-r2-07","points":5,"type":"mc","prompt":"Three parties contested an election with 100 000 voters who all cast valid votes. One of the parties won the election, obtaining more votes than either of the other two parties. What is the smallest number of votes this party could have obtained?","choices":[{"key":"A","text":"33 333"},{"key":"B","text":"33 334"},{"key":"C","text":"50 000"},{"key":"D","text":"50 001"},{"key":"E","text":"66 667"}],"answer":"B","topics":["arithmetic","logic"],"difficulty":2,"p":2,"n":7},{"id":"samf-junior-2000-r2-15","points":5,"wrongPoints":-1,"type":"mc","prompt":"The length of the diagonal of a square is $d$. The area of the square is","image":"qimages/samf/junior-2000-r2/q15.webp","choices":[{"key":"A","text":"$\\frac12d^2$"},{"key":"B","text":"$\\frac{d^2}{\\sqrt2}$"},{"key":"C","text":"$d^2$"},{"key":"D","text":"$\\sqrt2\\,d^2$"},{"key":"E","text":"$2d^2$"}],"answer":"A","topics":["geometry"],"difficulty":2,"p":3,"n":15},{"id":"samf-junior-2001-r1-10","points":5,"type":"mc","prompt":"$2001$ people stand in a queue at a voting station. There are at least $3$ women between any two men. The largest possible number of men in the queue is","choices":[{"key":"A","text":"$500$"},{"key":"B","text":"$501$"},{"key":"C","text":"$502$"},{"key":"D","text":"$667$"},{"key":"E","text":"$668$"}],"answer":"B","topics":["counting","patterns"],"difficulty":2,"p":4,"n":10}]}