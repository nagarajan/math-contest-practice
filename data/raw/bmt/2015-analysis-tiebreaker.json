  "type": "numeric",
  "prompt": "Compute $$\\int_{-1}^{1}\\frac{x^2}{1+2015^x}\\,dx.$$",
  "image": null,
  "choices": null,
  "answer": "1/3",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Symmetrise",
    "body": "Let $f(x)=\\frac{x^2}{1+2015^x}$. Then $f(-x)=\\frac{x^2}{1+2015^{-x}}=\\frac{x^22015^x}{2015^x+1}$, so $f(x)+f(-x)=x^2$. Therefore $\\int_{-1}^1f=\\frac12\\int_{-1}^1(f(x)+f(-x))dx=\\frac12\\int_{-1}^1x^2dx=\\frac12\\cdot\\frac23=\\frac13$.\n\n**Answer: $\\frac13$**"
   }
  ],
  "topics": [
   "calculus"
  ],
  "difficulty": 2,
  "duplicateOf": null,
  "reviewNote": null,
  "answerDisplay": "$\\frac{1}{3}$"
 },
 {
  "id": "bmt-2015-analysis-tiebreaker-03",
  "bank": "bmt",
  "source": {
   "contest": "Berkeley Math Tournament",
   "paper": "2015 Analysis Tiebreaker",
   "year": 2015,
   "number": 3,
   "url": "https://berkeley.mt/archives/bmt-2015/AnaS2015Tb.pdf"
  },
  "grade": "9-12",
  "points": null,
  "timeMinutes": null,
  "type": "self",
  "prompt": "Let $a_1,a_2,\\dots,a_k$ be real numbers for some natural number $k$. Find $$\\lim_{n\\to\\infty}\\left(\\frac{(a_1)^n+(a_2)^n+\\dots+(a_k)^n}{k}\\right)^{1/n}.$$",
  "image": null,
  "choices": null,
  "answer": "$\\max_i|a_i|$ (for $a_i\\ge0$, or along even $n$)",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Squeeze",
    "body": "Let $M=\\max_i|a_i|$ and assume $M>0$. Along even $n$ (or if all $a_i\\ge0$ for every $n$), $\\frac{M^n}{k}\\le\\frac{\\sum a_i^n}{k}\\le M^n$, so the $n$th root lies between $M\\,k^{-1/n}$ and $M$, and both bounds tend to $M$. If all $a_i=0$ the limit is $0$.\n\nSo the limit is $\\max_i|a_i|$. (For odd $n$ with negative terms the sum can be negative or cancel, and the limit need not exist; the intended reading is $\\max a_i$ for non-negative $a_i$, i.e. $\\max_i|a_i|$.)\n\n**Answer: $\\max_i|a_i|$**"
   }
  ],
  "topics": [
   "calculus",
   "analysis"
  ],
  "difficulty": 2,
  "duplicateOf": null,
  "reviewNote": "As printed (real a_i, all n) the limit need not exist, e.g. a_1=-2, k=1; the answer given is the intended max|a_i| (valid for non-negative a_i or even n). No official key available."
 }
