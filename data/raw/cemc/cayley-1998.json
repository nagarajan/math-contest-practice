 {
  "id": "cemc-cayley-1998-20",
  "bank": "cemc",
  "source": {
   "contest": "Cayley Contest (CEMC)",
   "paper": "1998 Cayley Contest (Grade 10)",
   "year": 1998,
   "number": 20,
   "url": "https://cemc.uwaterloo.ca/sites/default/files/documents/1998/1998CayleyContest.pdf"
  },
  "grade": "10",
  "points": 6,
  "timeMinutes": null,
  "type": "mc",
  "prompt": "Each side of square $ABCD$ is 8. A circle is drawn through $A$ and $D$ so that it is tangent to $BC$. What is the radius of this circle?",
  "image": "qimages/cemc/cayley-1998/q20.webp",
  "choices": [
   {
    "key": "A",
    "text": "4"
   },
   {
    "key": "B",
    "text": "5"
   },
   {
    "key": "C",
    "text": "6"
   },
   {
    "key": "D",
    "text": "$4\\sqrt2$"
   },
   {
    "key": "E",
    "text": "5.25"
   }
  ],
  "answer": "B",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Coordinates",
    "body": "Let $D=(0,0)$, $A=(0,8)$, and $BC$ be the line $x=8$. The centre is on the perpendicular bisector of $AD$, the line $y=4$, and is at distance $r$ from $x=8$, so it is $(8-r,4)$. Its distance to $D$ is $r$: $(8-r)^2+16=r^2$, so $80-16r=0$ and $r=5$.\n\n**Answer: (B) 5**"
   },
   {
    "title": "Right triangle",
    "body": "Let $O$ be the centre and $M$ the midpoint of $AD$; $OM\\perp AD$. The tangent point on $BC$ is level with $M$, so $OM=8-r$ and $MD=4$. Pythagoras in $\\triangle OMD$: $(8-r)^2+4^2=r^2$, giving $r=5$ (a $3$-$4$-$5$ triangle).\n\n**Answer: (B) 5**"
   }
  ],
  "topics": [
   "geometry"
  ],
  "difficulty": 2,
  "duplicateOf": null,
  "reviewNote": null
 },
 {
  "id": "cemc-cayley-1998-21",
  "bank": "cemc",
  "source": {
   "contest": "Cayley Contest (CEMC)",
