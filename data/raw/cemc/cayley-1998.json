  "timeMinutes": null,
  "type": "mc",
  "prompt": "A wheel of radius 8 rolls along the diameter of a semicircle of radius 25 until it bumps into this semicircle. What is the length of the portion of the diameter that cannot be touched by the wheel?",
  "image": "qimages/cemc/cayley-1998/q22.webp",
  "choices": [
   {
    "key": "A",
    "text": "8"
   },
   {
    "key": "B",
    "text": "12"
   },
   {
    "key": "C",
    "text": "15"
   },
   {
    "key": "D",
    "text": "17"
   },
   {
    "key": "E",
    "text": "20"
   }
  ],
  "answer": "E",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Where the wheel stops",
    "body": "Let $O$ be the centre of the semicircle. When the wheel touches the semicircle, its centre $W$ is at height $8$ and $OW=25-8=17$ (the circles are tangent internally). The horizontal distance from $O$ to $W$ is $\\sqrt{17^2-8^2}=15$, and the wheel touches the diameter directly below $W$.\n\nSo the wheel can touch only points within $15$ of $O$. On each side $25-15=10$ is untouched, a total of $20$.\n\n**Answer: (E) 20**"
   }
  ],
