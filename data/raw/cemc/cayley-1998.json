   },
   {
    "key": "B",
    "text": "6"
   },
   {
    "key": "C",
    "text": "7"
   },
   {
    "key": "D",
    "text": "3"
   },
   {
    "key": "E",
    "text": "4"
   }
  ],
  "answer": "B",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Range of totals",
    "body": "Boys: $3$ to $9$. Girls: $15$ to $22$. The class size can be any whole number from $3+15=18$ to $9+22=31$. It must also be more than $25$: sizes $26,27,28,29,30,31$, which is $6$ sizes.\n\n**Answer: (B) 6**"
   }
  ],
