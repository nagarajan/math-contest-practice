  },
  "grade": "10",
  "points": 5,
  "timeMinutes": null,
  "type": "mc",
  "prompt": "In the diagram, $ABCD$ is a rectangle with $DC=12$. If the area of triangle $BDC$ is 30, what is the perimeter of rectangle $ABCD$?",
  "image": "qimages/cemc/cayley-1998/q05.webp",
  "choices": [
   {
    "key": "A",
    "text": "34"
   },
   {
    "key": "B",
    "text": "44"
   },
   {
    "key": "C",
    "text": "30"
   },
   {
    "key": "D",
    "text": "29"
   },
   {
    "key": "E",
    "text": "60"
   }
  ],
  "answer": "A",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Find the width",
    "body": "Triangle $BDC$ has area $\\frac12\\cdot DC\\cdot BC=6\\cdot BC=30$, so $BC=5$. The perimeter is $2(12+5)=34$.\n\n**Answer: (A) 34**"
   },
   {
    "title": "Half the rectangle",
    "body": "The diagonal splits the rectangle into two equal triangles, so the rectangle's area is $60$. Then $BC=60\\div12=5$ and the perimeter is $12+5+12+5=34$.\n\n**Answer: (A) 34**"
   }
  ],
  "topics": [
   "geometry",
   "measurement"
  ],
  "difficulty": 1,
  "duplicateOf": null,
  "reviewNote": null
 },
