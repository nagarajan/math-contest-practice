  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Equal opposite sides",
    "body": "In a parallelogram $\\overrightarrow{WX}=\\overrightarrow{ZY}$. From $W(-1,3)$ to $X(5,3)$ is $6$ units right. So $Y$ is $6$ units right of $Z(4,-8)$: $t=10$.\n\n**Answer: (C) 10**"
   },
   {
    "title": "Midpoints of diagonals",
    "body": "The diagonals $WY$ and $XZ$ bisect each other, so their midpoints agree: $\\frac{-1+t}{2}=\\frac{5+4}{2}$, giving $t=10$.\n\n**Answer: (C) 10**"
   }
  ],
