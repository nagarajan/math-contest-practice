    "timeMinutes": null,
    "type": "mc",
    "prompt": "$ABC$ is an isosceles triangle in which $\\angle A = 92°$. $CB$ is extended to a point $D$. What is the size of $\\angle ABD$?",
    "image": "qimages/cemc/gauss8-1999/q14.webp",
    "choices": [
      {
        "key": "A",
        "text": "88°"
      },
      {
        "key": "B",
        "text": "44°"
      },
      {
        "key": "C",
        "text": "92°"
      },
      {
        "key": "D",
        "text": "136°"
      },
      {
        "key": "E",
        "text": "158°"
      }
    ],
    "answer": "D",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Base angles, then a straight line",
        "body": "The equal angles are at $B$ and $C$: each is $\\frac{180° - 92°}{2} = 44°$. $\\angle ABD$ and $\\angle ABC$ form a straight line, so $\\angle ABD = 180° - 44° = 136°$.\n\n**Answer: (D) 136°**"
      },
      {
        "title": "Exterior angle",
        "body": "An exterior angle equals the sum of the two opposite interior angles: $\\angle ABD = \\angle A + \\angle C = 92° + 44° = 136°$.\n\n**Answer: (D) 136°**"
      }
    ],
    "topics": [
      "geometry"
    ],
    "difficulty": 2,
    "duplicateOf": null,
    "reviewNote": null
  },
