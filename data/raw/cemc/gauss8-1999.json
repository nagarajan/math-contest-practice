      },
      {
        "key": "D",
        "text": "a multiple of 4"
      },
      {
        "key": "E",
        "text": "a multiple of 3"
      }
    ],
    "answer": "B",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Use the middle number",
        "body": "Call the middle number $m$. The seven numbers are $m-3, \\dots, m+3$, and the $-3, -2, -1$ cancel the $+1, +2, +3$. The sum is $7m$, always a multiple of $7$.\n\nThe others fail: $1+2+\\dots+7 = 28$ is even and not a multiple of $3$; $2+3+\\dots+8 = 35$ is odd and not a multiple of $4$.\n\n**Answer: (B) a multiple of 7**"
      }
    ],
