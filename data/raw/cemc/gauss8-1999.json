    "points": 6,
    "timeMinutes": null,
    "type": "mc",
    "prompt": "The expression $n!$ means the product of the positive integers from 1 to $n$. For example, $5! = 1 \\times 2 \\times 3 \\times 4 \\times 5$. The value of $6! - 4!$ is",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "2"
      },
      {
        "key": "B",
        "text": "18"
      },
      {
        "key": "C",
        "text": "30"
      },
      {
        "key": "D",
        "text": "716"
      },
      {
        "key": "E",
        "text": "696"
      }
    ],
    "answer": "E",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Compute",
        "body": "$6! = 720$ and $4! = 24$, so $6! - 4! = 696$.\n\n**Answer: (E) 696**"
      },
      {
        "title": "Factor",
        "body": "$6! - 4! = 4!(6 \\times 5 - 1) = 24 \\times 29 = 696$.\n\n**Answer: (E) 696**"
      }
    ],
    "topics": [
      "arithmetic"
    ],
