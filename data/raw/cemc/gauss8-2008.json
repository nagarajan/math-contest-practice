    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Look at the carries",
        "body": "Tens column: $x + x$ (plus a possible carry) must end in 1. Since $2x$ is even, there must be a carry of 1 from the units column. So $y + 3 = 10 + x$, which gives $y - x = 7$.\n\n**Answer: (C) 7**"
      },
      {
        "title": "Find the digits",
        "body": "Try $x = 0$, $y = 7$: $307 + 703 = 1010$. ✓ So $y - x = 7$.\n\n**Answer: (C) 7**"
      }
