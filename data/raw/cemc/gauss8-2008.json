        "text": "\\$55.00"
      },
      {
        "key": "B",
        "text": "\\$57.75"
      },
      {
        "key": "C",
        "text": "\\$60.50"
      },
      {
        "key": "D",
        "text": "\\$63.25"
      },
      {
        "key": "E",
        "text": "\\$66.00"
      }
    ],
    "answer": "D",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Revenue minus cost",
        "body": "Revenue: $55 \\times 8 = 440$ dollars. Cost: $55 \\times 6.85 = 376.75$ dollars. Profit: $440 - 376.75 = 63.25$ dollars.\n\n**Answer: (D) \\$63.25**"
      },
      {
        "title": "Profit per pizza",
        "body": "Each pizza earns $8.00 - 6.85 = 1.15$ dollars profit. $55 \\times 1.15 = 63.25$ dollars.\n\n**Answer: (D) \\$63.25**"
      }
    ],
