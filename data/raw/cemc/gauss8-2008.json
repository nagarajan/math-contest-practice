        "text": "12"
      },
      {
        "key": "E",
        "text": "1"
      }
    ],
    "answer": "B",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Compute",
        "body": "$(1 + 2)^2 = 9$ and $1^2 + 2^2 = 5$, so the value is $9 - 5 = 4$.\n\n**Answer: (B) 4**"
      },
      {
        "title": "Expand",
        "body": "$(1 + 2)^2 = 1^2 + 2 \\cdot 1 \\cdot 2 + 2^2$, so the difference is $2 \\cdot 1 \\cdot 2 = 4$.\n\n**Answer: (B) 4**"
      }
    ],
