    "choices": null,
    "answer": "pi/2",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "King's rule",
        "body": "Replace $x$ by $\\pi-x$: $\\cos(\\pi-x)=-\\cos x$, so $I=\\int_0^\\pi\\frac{e^{-\\cos x}}{e^{\\cos x}+e^{-\\cos x}}dx$. Adding, $2I=\\int_0^\\pi1\\,dx=\\pi$, so $I=\\frac\\pi2$.\n\n**Answer: $\\frac\\pi2$**"
      }
    ],
