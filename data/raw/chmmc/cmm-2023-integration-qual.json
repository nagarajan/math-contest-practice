    "choices": null,
    "answer": "-ln(2)",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Floor takes values $0$ and $-1$",
        "body": "On $\\left[\\frac1{k+1},\\frac1k\\right]$ the angle $\\frac\\pi x$ ranges over $[k\\pi,(k+1)\\pi]$. There $\\sin$ is $\\le0$ when $k$ is odd (floor $=-1$ except at endpoints) and $\\ge0$ when $k$ is even (floor $=0$, except where $\\sin=1$, a null set). Hence\n$$\\int_0^1=-\\sum_{k\\text{ odd}}\\left(\\frac1k-\\frac1{k+1}\\right)=-\\left(1-\\frac12+\\frac13-\\cdots\\right)=-\\ln2.$$\n\n**Answer: $-\\ln2$**"
      }
