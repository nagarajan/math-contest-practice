  "prompt": "Evaluate $$\\int_0^6|x-3|\\,dx.$$",
  "image": null,
  "choices": null,
  "answer": "9",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Two triangles",
    "body": "The graph of $|x-3|$ on $[0,6]$ consists of two right triangles with base $3$ and height $3$, each of area $\\frac92$. Total $9$.\n\n**Answer: 9**"
   },
   {
    "title": "Split the integral",
    "body": "$\\int_0^3(3-x)dx+\\int_3^6(x-3)dx=\\frac92+\\frac92=9$.\n\n**Answer: 9**"
   }
  ],
