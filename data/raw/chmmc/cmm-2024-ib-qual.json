  "answer": "14/3-2*ln(2)",
  "acceptedAnswers": null,
  "answerUnit": null,
  "answerDisplay": "$\\frac{14}{3}-2\\ln 2$",
  "solutions": [
   {
    "title": "Split the fraction",
    "body": "$\\frac{x\\sqrt x-1}{x}=\\sqrt x-\\frac1x$. Then $\\int_1^4\\sqrt x\\,dx=\\frac23(8-1)=\\frac{14}3$ and $\\int_1^4\\frac{dx}x=\\ln4=2\\ln2$.\n\n**Answer: $\\frac{14}3-2\\ln2$**"
   }
  ],
