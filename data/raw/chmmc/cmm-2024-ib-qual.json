  "answer": "-8/5",
  "acceptedAnswers": null,
  "answerUnit": null,
  "answerDisplay": "$-\\frac85$",
  "solutions": [
   {
    "title": "Power rule",
    "body": "$\\int_0^1 4x\\,dx=2$ and $\\int_0^1 6x^{2/3}dx=6\\cdot\\frac35=\\frac{18}5$. So the integral is $2-\\frac{18}5=-\\frac85$.\n\n**Answer: $-\\frac85$**"
   }
