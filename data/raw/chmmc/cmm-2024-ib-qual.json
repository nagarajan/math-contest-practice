  "type": "numeric",
  "prompt": "Evaluate $$\\int_e^{e^2}\\left(\\ln(\\ln x)+\\frac1{\\ln x}\\right)dx.$$",
  "image": null,
  "choices": null,
  "answer": "e^2*ln(2)",
  "acceptedAnswers": null,
  "answerUnit": null,
  "answerDisplay": "$e^2\\ln 2$",
  "solutions": [
   {
    "title": "Integration by parts",
    "body": "Let $x=e^u$: the integral becomes $\\int_1^2\\left(\\ln u+\\frac1u\\right)e^u\\,du$. Integrating $e^u\\ln u$ by parts gives $\\left[e^u\\ln u\\right]_1^2-\\int_1^2\\frac{e^u}u\\,du$, which cancels the other term exactly. The value is $e^2\\ln2-e\\ln1=e^2\\ln2$.\n\n**Answer: $e^2\\ln2$**"
   },
   {
    "title": "Product rule",
    "body": "$\\frac{d}{dx}\\left(x\\ln\\ln x\\right)=\\ln\\ln x+\\frac1{\\ln x}$, so the integral is $\\left[x\\ln\\ln x\\right]_e^{e^2}=e^2\\ln2-e\\ln1=e^2\\ln2$.\n\n**Answer: $e^2\\ln2$**"
   }
  ],
  "topics": [
   "calculus"
  ],
  "difficulty": 2,
  "duplicateOf": null,
  "reviewNote": null
 },
