    "prompt": "Find an antiderivative: $$\\int \\operatorname{arcsec}(\\sqrt x)\\,dx$$",
    "image": null,
    "choices": null,
    "answer": "$x\\operatorname{arcsec}\\sqrt x-\\sqrt{x-1}+C$",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Solution",
        "body": "By parts with $u=\\operatorname{arcsec}\\sqrt x$, $dv=dx$: $\\frac{d}{dx}\\operatorname{arcsec}\\sqrt x=\\frac1{2x\\sqrt{x-1}}$, so $\\int=x\\operatorname{arcsec}\\sqrt x-\\int\\frac{dx}{2\\sqrt{x-1}}=x\\operatorname{arcsec}\\sqrt x-\\sqrt{x-1}+C$."
      }
    ],
    "topics": [
