    "prompt": "Evaluate $$\\int_0^1\\left((1-x^{25})^{1/20}-(1-x^{20})^{1/25}\\right)dx$$",
    "image": null,
    "choices": null,
    "answer": "0",
    "acceptedAnswers": null,
    "answerUnit": null,
    "answerDisplay": "$0$",
    "solutions": [
      {
        "title": "Solution",
        "body": "The curves $y=(1-x^{25})^{1/20}$ and $y=(1-x^{20})^{1/25}$ are inverse functions of each other on $[0,1]$ ($y^{20}+x^{25}=1\\iff x^{25}+y^{20}=1$), so each integral equals the area of the same region $\\{x^{25}+y^{20}\\le1\\}$ in the first quadrant. The difference is $0$."
      }
    ],
