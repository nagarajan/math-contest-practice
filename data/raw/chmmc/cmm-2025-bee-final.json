    "prompt": "Find an antiderivative: $$\\int xe^x(\\sin x+\\cos x)\\,dx$$",
    "image": null,
    "choices": null,
    "answer": "$xe^x\\sin x-\\frac{e^x(\\sin x-\\cos x)}2+C$",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Solution",
        "body": "$\\frac{d}{dx}(xe^x\\sin x)=e^x\\sin x+xe^x(\\sin x+\\cos x)$, so $\\int xe^x(\\sin x+\\cos x)dx=xe^x\\sin x-\\int e^x\\sin x\\,dx=xe^x\\sin x-\\frac{e^x(\\sin x-\\cos x)}2+C$. (Over $[0,1]$ this equals $\\frac{e(\\sin1+\\cos1)-1}2$, the value shown on the official answer slide.)"
      }
    ],
    "topics": [
      "calculus"
    ],
    "difficulty": 2,
    "duplicateOf": null,
    "reviewNote": "The slide prints no limits (an indefinite integral), but the official answer slide gives (e(sin 1 + cos 1) - 1)/2, the value for the interval 0 to 1; an antiderivative is stored here."
  },
