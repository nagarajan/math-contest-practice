  "timeMinutes": null,
  "type": "numeric",
  "prompt": "Evaluate $$\\int_{-1}^{1}\\frac{\\cos x}{\\arctan x}\\,dx$$ (The integral is understood as a principal value.)",
  "image": null,
  "choices": null,
  "answer": "0",
  "acceptedAnswers": null,
  "answerUnit": null,
  "answerDisplay": "$0$",
  "solutions": [
   {
    "title": "Solution",
    "body": "The integrand is odd ($\\cos$ even, $\\arctan$ odd), so over the symmetric interval the contributions cancel: $0$. (Near $0$ the integrand behaves like $1/x$, so the integral is understood as a symmetric/principal-value integral.)\n\n**Answer: 0**"
   }
  ],
  "topics": [
   "calculus"
  ],
  "difficulty": 1,
  "duplicateOf": null,
  "reviewNote": "The integrand behaves like 1/x at 0, so the integral exists only as a Cauchy principal value; the official answer 0 is that value."
 },
