  "answer": "e^(9/4)*sqrt(pi)",
  "acceptedAnswers": null,
  "answerUnit": null,
  "answerDisplay": "$e^{9/4}\\sqrt\\pi$",
  "solutions": [
   {
    "title": "Solution",
    "body": "Complete the square: $-x^2+3x=-(x-\\frac32)^2+\\frac94$. Then $\\int e^{-(x-3/2)^2}dx\\cdot e^{9/4}=\\sqrt\\pi\\,e^{9/4}$.\n\n**Answer: $\\sqrt\\pi\\,e^{9/4}$**"
   }
