  "type": "numeric",
  "prompt": "Evaluate $$\\int_{\\pi/2}^{\\pi}\\sqrt{1+\\cos x}\\,dx$$",
  "image": null,
  "choices": null,
  "answer": "2*sqrt(2)-2",
  "acceptedAnswers": null,
  "answerUnit": null,
  "answerDisplay": "$2\\sqrt2-2$",
  "solutions": [
   {
    "title": "Solution",
    "body": "$1+\\cos x=2\\cos^2\\frac x2$ and $\\cos\\frac x2\\ge0$ on $[\\frac\\pi2,\\pi]$, so $\\sqrt{1+\\cos x}=\\sqrt2\\cos\\frac x2$ and the integral is $2\\sqrt2\\left[\\sin\\frac x2\\right]_{\\pi/2}^{\\pi}=2\\sqrt2\\left(1-\\frac{\\sqrt2}2\\right)=2\\sqrt2-2$.\n\n**Answer: $2\\sqrt2-2$**"
   }
  ],
  "topics": [
   "calculus"
  ],
