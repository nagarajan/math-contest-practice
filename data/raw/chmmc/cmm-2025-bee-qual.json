  "type": "numeric",
  "prompt": "Evaluate $$\\int_4^5\\frac{2x+1}{(x-1)(x-2)(x-3)}\\,dx$$",
  "image": null,
  "choices": null,
  "answer": "(23*ln(2)-13*ln(3))/2",
  "acceptedAnswers": null,
  "answerUnit": null,
  "answerDisplay": "$\\frac{23\\ln2-13\\ln3}{2}$",
  "solutions": [
   {
    "title": "Solution",
    "body": "Partial fractions: $\\frac{2x+1}{(x-1)(x-2)(x-3)}=\\frac{3/2}{x-1}-\\frac5{x-2}+\\frac{7/2}{x-3}$ (residues $\\frac{3}{2},-5,\\frac72$). Antiderivative $\\frac32\\ln(x-1)-5\\ln(x-2)+\\frac72\\ln(x-3)$. At $5$: $\\frac32\\ln4-5\\ln3+\\frac72\\ln2=\\frac{13}2\\ln2-5\\ln3$; at $4$: $\\frac32\\ln3-5\\ln2$. Difference: $\\frac{23}{2}\\ln2-\\frac{13}{2}\\ln3$.\n\n**Answer: $\\frac{23\\ln2-13\\ln3}2$**"
   }
  ],
  "topics": [
   "calculus"
  ],
  "difficulty": 2,
  "duplicateOf": null,
  "reviewNote": null
 },
