  "type": "numeric",
  "prompt": "Evaluate $$\\int_0^\\pi\\sin^5x\\,dx$$",
  "image": null,
  "choices": null,
  "answer": "16/15",
  "acceptedAnswers": null,
  "answerUnit": null,
  "answerDisplay": "$\\frac{16}{15}$",
  "solutions": [
   {
    "title": "Solution",
    "body": "Write $\\sin^5x=(1-\\cos^2x)^2\\sin x$ and let $u=\\cos x$: $\\int_{-1}^{1}(1-u^2)^2du=2\\left(1-\\frac23+\\frac15\\right)=\\frac{16}{15}$.\n\n**Answer: $\\frac{16}{15}$**"
   }
  ],
  "topics": [
   "calculus"
  ],
  "difficulty": 1,
  "duplicateOf": null,
  "reviewNote": "The boxed header of the official solution says 8/15, but its own computation (and ours) gives 16/15."
 },
 {
