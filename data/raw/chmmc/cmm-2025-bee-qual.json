  "type": "numeric",
  "prompt": "Evaluate $$\\int_0^{3/2}\\lfloor x+\\lfloor2x\\rfloor\\rfloor\\,dx$$",
  "image": null,
  "choices": null,
  "answer": "2",
  "acceptedAnswers": null,
  "answerUnit": null,
  "answerDisplay": "$2$",
  "solutions": [
   {
    "title": "Solution",
    "body": "Since $\\lfloor2x\\rfloor$ is an integer, $\\lfloor x+\\lfloor2x\\rfloor\\rfloor=\\lfloor x\\rfloor+\\lfloor2x\\rfloor$. On $[0,\\frac12)$ it is $0$; on $[\\frac12,1)$ it is $0+1=1$; on $[1,\\frac32)$ it is $1+2=3$. Integral $=\\frac12\\cdot1+\\frac12\\cdot3=2$.\n\n**Answer: 2**"
   }
  ],
  "topics": [
   "calculus"
  ],
  "difficulty": 2,
  "duplicateOf": null,
  "reviewNote": null
 },
