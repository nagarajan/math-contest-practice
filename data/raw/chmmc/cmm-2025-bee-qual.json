  "type": "numeric",
  "prompt": "Evaluate $$\\int_{-3}^{3}\\frac{x^4}{1+e^{-x}}\\,dx$$",
  "image": null,
  "choices": null,
  "answer": "243/5",
  "acceptedAnswers": null,
  "answerUnit": null,
  "answerDisplay": "$\\frac{243}{5}$",
  "solutions": [
   {
    "title": "Solution",
    "body": "Let $I$ be the integral. Substituting $x\\to-x$ gives $I=\\int_{-3}^3\\frac{x^4}{1+e^{x}}dx$. Adding: $2I=\\int_{-3}^3x^4\\left(\\frac1{1+e^{-x}}+\\frac1{1+e^{x}}\\right)dx=\\int_{-3}^3x^4dx=\\frac{2\\cdot3^5}5$, so $I=\\frac{243}5$.\n\n**Answer: $\\frac{243}5$**"
   }
  ],
  "topics": [
   "calculus"
  ],
  "difficulty": 1,
  "duplicateOf": null,
  "reviewNote": null
 },
 {
