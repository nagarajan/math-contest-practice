  "type": "numeric",
  "prompt": "Evaluate $$\\int_0^\\infty x^7e^{-x^2}\\,dx$$",
  "image": null,
  "choices": null,
  "answer": "3",
  "acceptedAnswers": null,
  "answerUnit": null,
  "answerDisplay": "$3$",
  "solutions": [
   {
    "title": "Solution",
    "body": "Let $u=x^2$, $du=2x\\,dx$: the integral is $\\frac12\\int_0^\\infty u^3e^{-u}\\,du=\\frac12\\Gamma(4)=\\frac{3!}2=3$.\n\n**Answer: 3**"
   }
  ],
  "topics": [
