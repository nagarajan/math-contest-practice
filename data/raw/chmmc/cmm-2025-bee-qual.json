  "type": "numeric",
  "prompt": "Evaluate $$\\int_0^1xe^{x^2+e^{x^2}}\\,dx$$",
  "image": null,
  "choices": null,
  "answer": "(e^e-e)/2",
  "acceptedAnswers": null,
  "answerUnit": null,
  "answerDisplay": "$\\frac{e^e-e}{2}$",
  "solutions": [
   {
    "title": "Solution",
    "body": "$\\frac{d}{dx}e^{e^{x^2}}=e^{e^{x^2}}e^{x^2}\\cdot2x=2xe^{x^2+e^{x^2}}$. So the integral is $\\frac12\\left[e^{e^{x^2}}\\right]_0^1=\\frac{e^e-e}2$.\n\n**Answer: $\\frac{e^e-e}2$**"
   }
  ],
  "topics": [
   "calculus"
  ],
  "difficulty": 2,
