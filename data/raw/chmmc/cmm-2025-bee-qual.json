  "type": "numeric",
  "prompt": "Evaluate $$\\int_0^1\\big(\\sin(\\ln x)+\\cos(\\ln x)\\big)\\,dx$$",
  "image": null,
  "choices": null,
  "answer": "0",
  "acceptedAnswers": null,
  "answerUnit": null,
  "answerDisplay": "$0$",
  "solutions": [
   {
    "title": "Solution",
    "body": "Put $x=e^u$: $\\int_{-\\infty}^0e^u(\\sin u+\\cos u)\\,du$. Since $\\frac{d}{du}\\big(e^u\\sin u\\big)=e^u(\\sin u+\\cos u)$, the integral is $\\big[e^u\\sin u\\big]_{-\\infty}^0=0$.\n\n**Answer: 0**"
   }
  ],
  "topics": [
   "calculus"
  ],
  "difficulty": 1,
  "duplicateOf": null,
  "reviewNote": null
 },
 {
