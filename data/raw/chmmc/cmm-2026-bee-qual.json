  "type": "numeric",
  "prompt": "Evaluate $$\\int_0^1x\\left\\lfloor\\frac1x\\right\\rfloor dx$$",
  "image": null,
  "choices": null,
  "answer": "pi^2/12",
  "acceptedAnswers": null,
  "answerUnit": null,
  "answerDisplay": "$\\frac{\\pi^2}{12}$",
  "solutions": [
   {
    "title": "Solution",
    "body": "On $(\\frac1{n+1},\\frac1n]$, $\\lfloor1/x\\rfloor=n$ and $\\int x\\,dx=\\frac12\\left(\\frac1{n^2}-\\frac1{(n+1)^2}\\right)$. So $I=\\frac12\\sum_{n\\ge1}n\\left(\\frac1{n^2}-\\frac1{(n+1)^2}\\right)=\\frac12\\sum_{n\\ge1}\\left(\\frac1n-\\frac1{n+1}+\\frac1{(n+1)^2}\\right)=\\frac12\\left(1+\\frac{\\pi^2}6-1\\right)=\\frac{\\pi^2}{12}$."
   }
  ],
  "topics": [
