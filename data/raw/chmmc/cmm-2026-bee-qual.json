  "prompt": "Evaluate $$\\int_0^{10}\\left|3x^2-12\\right|dx$$",
  "image": null,
  "choices": null,
  "answer": "912",
  "acceptedAnswers": null,
  "answerUnit": null,
  "answerDisplay": "$912$",
  "solutions": [
   {
    "title": "Solution",
    "body": "The sign changes at $x=2$: $\\int_0^2(12-3x^2)dx=24-8=16$ and $\\int_2^{10}(3x^2-12)dx=[x^3-12x]_2^{10}=880+16=896$. Total $912$."
   }
  ],
