  "prompt": "Find an antiderivative: $$\\int \\frac{dx}{x+\\sqrt[3]x}$$",
  "image": null,
  "choices": null,
  "answer": "$\\frac32\\ln\\left(x^{2/3}+1\\right)+C$",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Solution",
    "body": "Let $u=\\sqrt[3]x$, $dx=3u^2du$: $\\int\\frac{3u^2}{u^3+u}du=3\\int\\frac u{u^2+1}du=\\frac32\\ln(u^2+1)$."
   }
  ],
