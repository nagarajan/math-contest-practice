  "type": "numeric",
  "prompt": "Evaluate $$\\int_{-\\pi/2}^{0}\\frac{dx}{\\sqrt{1-\\sin x}}$$",
  "image": null,
  "choices": null,
  "answer": "sqrt(2)*ln(sqrt(2)+1)",
  "acceptedAnswers": null,
  "answerUnit": null,
  "answerDisplay": "$\\sqrt2\\ln(1+\\sqrt2)$",
  "solutions": [
   {
    "title": "Solution",
    "body": "Put $x=-y$: $\\int_0^{\\pi/2}\\frac{dy}{\\sqrt{1+\\sin y}}$. $1+\\sin y=2\\sin^2\\left(\\frac y2+\\frac\\pi4\\right)$, so the integrand is $\\frac1{\\sqrt2\\sin(y/2+\\pi/4)}$, with antiderivative $\\sqrt2\\ln\\tan\\left(\\frac y4+\\frac\\pi8\\right)$. From $0$ to $\\frac\\pi2$: $\\sqrt2\\big(\\ln\\tan\\frac\\pi4-\\ln\\tan\\frac\\pi8\\big)=-\\sqrt2\\ln(\\sqrt2-1)=\\sqrt2\\ln(\\sqrt2+1)$."
   }
  ],
