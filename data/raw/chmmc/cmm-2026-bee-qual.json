  "prompt": "Evaluate $$\\int_1^e\\frac{\\ln x}{x^3}\\,dx$$",
  "image": null,
  "choices": null,
  "answer": "(e^2-3)/(4*e^2)",
  "acceptedAnswers": null,
  "answerUnit": null,
  "answerDisplay": "$\\frac{e^2-3}{4e^2}$",
  "solutions": [
   {
    "title": "Solution",
    "body": "By parts, $\\int\\frac{\\ln x}{x^3}dx=-\\frac{\\ln x}{2x^2}-\\frac1{4x^2}$. From $1$ to $e$: $\\left(-\\frac1{2e^2}-\\frac1{4e^2}\\right)-\\left(-\\frac14\\right)=\\frac14-\\frac3{4e^2}=\\frac{e^2-3}{4e^2}$."
   }
  ],
