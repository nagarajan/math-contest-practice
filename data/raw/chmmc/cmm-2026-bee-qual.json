  "prompt": "Evaluate $$\\int_{-\\infty}^{\\infty}\\frac{e^{-x^2}}{1+e^x}\\,dx$$",
  "image": null,
  "choices": null,
  "answer": "sqrt(pi)/2",
  "acceptedAnswers": null,
  "answerUnit": null,
  "answerDisplay": "$\\frac{\\sqrt\\pi}2$",
  "solutions": [
   {
    "title": "Solution",
    "body": "Pair $x$ with $-x$: $\\frac1{1+e^x}+\\frac1{1+e^{-x}}=1$, so $2I=\\int_{-\\infty}^\\infty e^{-x^2}dx=\\sqrt\\pi$."
   }
  ],
