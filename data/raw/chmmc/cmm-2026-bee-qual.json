  "prompt": "Evaluate $$\\int_0^6\\sqrt{x+\\sqrt{x+\\sqrt{x+\\cdots}}}\\,dx$$",
  "image": null,
  "choices": null,
  "answer": "40/3",
  "acceptedAnswers": null,
  "answerUnit": null,
  "answerDisplay": "$\\frac{40}3$",
  "solutions": [
   {
    "title": "Solution",
    "body": "The nested radical $y$ satisfies $y^2=x+y$, so $y=\\frac{1+\\sqrt{1+4x}}2$. $\\int_0^6y\\,dx=3+\\frac12\\cdot\\frac{(1+4x)^{3/2}}6\\Big|_0^6=3+\\frac{125-1}{12}=\\frac{40}3$."
   }
  ],
