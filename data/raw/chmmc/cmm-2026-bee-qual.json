  "prompt": "Evaluate $$\\int_{-1}^{1}(x+x^2+x^4+x^8)\\sin x\\,dx$$",
  "image": null,
  "choices": null,
  "answer": "2*(sin(1)-cos(1))",
  "acceptedAnswers": null,
  "answerUnit": null,
  "answerDisplay": "$2(\\sin1-\\cos1)$",
  "solutions": [
   {
    "title": "Solution",
    "body": "$\\sin x$ is odd, so $x^2\\sin x$, $x^4\\sin x$, $x^8\\sin x$ are odd and integrate to $0$; $x\\sin x$ is even: $2\\int_0^1x\\sin x\\,dx=2[\\sin x-x\\cos x]_0^1=2(\\sin1-\\cos1)$."
   }
  ],
