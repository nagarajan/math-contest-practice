    },
    "grade": "11-12",
    "points": 3,
    "timeMinutes": null,
    "type": "mc",
    "prompt": "A chain of operations is displayed in the diagram. How many different real values can the number $N$ take?",
    "image": "qimages/kangaroo/ca-2012-g1112/q08.webp",
    "choices": [
      {
        "key": "A",
        "text": "0"
      },
      {
        "key": "B",
        "text": "1"
      },
      {
        "key": "C",
        "text": "2"
      },
      {
        "key": "D",
        "text": "4"
      },
      {
        "key": "E",
        "text": "infinitely many"
      }
    ],
    "answer": "B",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Simplify the chain",
        "body": "Starting with 1: add $N$ to get $1 + N$; multiply by $N$: $N + N^2$; subtract $N$: $N^2$; divide by $N$ (so $N \\ne 0$): $N$. The result must be 5, so $N = 5$ — exactly one value.\n\n**Answer: (B) 1**"
      },
      {
        "title": "Work backwards",
        "body": "Before dividing by $N$ the number was $5N$; before subtracting $N$ it was $6N$; this equals $(1+N)N$, so $N^2 + N = 6N$, i.e. $N(N - 5) = 0$. $N = 0$ is impossible (division by 0), so $N = 5$ only.\n\n**Answer: (B) 1**"
      }
    ],
    "topics": [
      "algebra"
    ],
    "difficulty": 1,
    "duplicateOf": null,
    "reviewNote": null
