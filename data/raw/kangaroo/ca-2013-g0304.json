    "type": "mc",
    "prompt": "Monica arrived in the Kangaroo Camp on July 25th in the morning and left the camp on August 3rd in the afternoon. How many nights did she sleep in the camp?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "7"
      },
      {
        "key": "B",
        "text": "9"
      },
      {
        "key": "C",
        "text": "10"
      },
      {
        "key": "D",
        "text": "30"
      },
      {
        "key": "E",
        "text": "8"
      }
    ],
    "answer": "B",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Count the nights",
        "body": "Nights in July: the nights after 25, 26, 27, 28, 29, 30 and 31 July → 7 nights. Nights in August: after 1 and 2 August → 2 nights. She leaves on 3 August, so $7 + 2 = 9$ nights.\n\n**Answer: (B) 9**"
      },
      {
        "title": "Count the days",
        "body": "From 25 July to 3 August is $6 + 3 = 9$ days later (July has 31 days: 25 → 31 is 6 days, then 3 more). Each day she moves on she has slept one night: 9 nights.\n\n**Answer: (B) 9**"
      }
    ],
