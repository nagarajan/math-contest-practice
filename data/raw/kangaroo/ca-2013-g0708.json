  "timeMinutes": null,
  "type": "mc",
  "prompt": "How many zeros are there at the end of the number $201325 \\times 201326 \\times 201317$?",
  "image": null,
  "choices": [
   {
    "key": "A",
    "text": "0"
   },
   {
    "key": "B",
    "text": "1"
   },
   {
    "key": "C",
    "text": "2"
   },
   {
    "key": "D",
    "text": "4"
   },
   {
    "key": "E",
    "text": "8"
   }
  ],
  "answer": "B",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Count factors 2 and 5",
    "body": "Each zero at the end needs one factor $10 = 2 \\times 5$.\n\n- $201325 = 25 \\times 8053$, and 8053 is not divisible by 5: two factors 5, no factor 2.\n- $201326 = 2 \\times 100663$, and 100663 is odd: one factor 2, no factor 5.\n- $201317$ is odd and does not end in 0 or 5: no factor 2 or 5.\n\nThe product has $2^1$ and $5^2$, so only one factor 10.\n\n**Answer: (B) 1**"
   }
  ],
