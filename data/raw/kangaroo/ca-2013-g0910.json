    ],
    "answer": "B",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Find the rectangle",
        "body": "The long cut goes from the top-left corner down to the bottom side; it has length $5 + 10 = 15$ and drops by the height 9. By Pythagoras its horizontal extent is $\\sqrt{15^2 - 9^2} = 12$.\n\nThe short vertical cut stands on this line one third of the way along it ($5$ of $15$), so it is $\\frac13 \\cdot 12 = 4$ from the left side. The top side is therefore $4 + 12 = 16$ long.\n\nThe rectangle is $16 \\times 9$ with area $144$. The square made from the same pieces has the same area, so its side is $12$ and its perimeter $48$.\n\n**Answer: (B) 48**"
      }
    ],
