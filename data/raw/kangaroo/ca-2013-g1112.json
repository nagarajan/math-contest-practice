      "url": "https://api.mathkangaroo.ca/api/v1/media/2013/2013gr1112e.pdf"
    },
    "grade": "11-12",
    "points": 5,
    "timeMinutes": null,
    "type": "mc",
    "prompt": "We have many white cubes and many black cubes, all of the same size. We want to build a rectangular prism composed of exactly 2013 of these cubes so that they are placed alternating a white cube and a black cube in all directions. If we start putting a black cube in one of the eight corners of the prism, how many black squares will we see on the exterior surface of the solid?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "887"
      },
      {
        "key": "B",
        "text": "888"
      },
      {
        "key": "C",
        "text": "890"
      },
      {
        "key": "D",
        "text": "892"
      },
      {
        "key": "E",
        "text": "It depends on the dimensions of the prism"
      }
    ],
    "answer": "C",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Count face by face",
        "body": "$2013 = 3\\cdot 11\\cdot 61$, so (taking a genuinely three-dimensional prism) the dimensions are $3\\times 11\\times 61$. All dimensions are odd, so with a black cube in one corner, all eight corners are black, and every face is an odd $\\times$ odd chessboard with black corners. Such an $m\\times n$ board has $\\frac{mn + 1}{2}$ black squares.\n\n- Two $3\\times 11$ faces: $2\\cdot 17 = 34$\n- Two $3\\times 61$ faces: $2\\cdot 92 = 184$\n- Two $11\\times 61$ faces: $2\\cdot 336 = 672$\n\nTotal $34 + 184 + 672 = 890$.\n\n**Answer: (C) 890**"
      }
    ],
    "topics": [
      "counting",
      "spatial"
    ],
    "difficulty": 3,
    "duplicateOf": null,
    "reviewNote": "Official answer C (890) assumes the prism is 3 x 11 x 61. Prisms with a side of length 1 (e.g. 1 x 33 x 61 gives 2110) would give other counts, which arguably supports (E)."
  },
