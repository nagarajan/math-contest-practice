    "type": "mc",
    "prompt": "There were some candies in a bowl. Sally took half of the candies. Then Tom took half of the candies left in the bowl. After that, Clara took half of the remaining candies. In the end there were 6 candies in the bowl. How many candies were there in the bowl at the beginning?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "12"
      },
      {
        "key": "B",
        "text": "18"
      },
      {
        "key": "C",
        "text": "20"
      },
      {
        "key": "D",
        "text": "24"
      },
      {
        "key": "E",
        "text": "48"
      }
    ],
    "answer": "E",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Work backwards",
        "body": "Before Clara: $2 \\times 6 = 12$. Before Tom: $2 \\times 12 = 24$. Before Sally: $2 \\times 24 = 48$.\n\n**Answer: (E) 48**"
      },
      {
        "title": "Check",
        "body": "48 → Sally takes 24, leaving 24 → Tom takes 12, leaving 12 → Clara takes 6, leaving 6 ✓.\n\n**Answer: (E) 48**"
      }
    ],
