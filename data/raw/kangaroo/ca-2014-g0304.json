    ],
    "answer": "B",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Match the ends",
        "body": "The tile on the left of the shaded square (the 3rd tile) ends at the **bottom** of its right side. The tile on the right (the 5th tile) starts in the **middle** of its left side. So the missing tile must go from the bottom of its left side up to the middle of its right side. That is tile (B).\n\n**Answer: (B)**"
      },
      {
        "title": "Rule out",
        "body": "(A) and (E) go corner to corner, so they would end at the top or start at the top. (C) goes the wrong way (from the middle down to the bottom). (D) is a straight middle line and would not meet the line at the bottom left. Only (B) connects.\n\n**Answer: (B)**"
      }
    ],
