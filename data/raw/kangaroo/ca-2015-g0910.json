    },
    "grade": "9-10",
    "points": 3,
    "timeMinutes": null,
    "type": "mc",
    "prompt": "There are 30 problems in the MathQ competition for pupils. Two points are scored for each correct answer. If a pupil omits to solve a problem, he/she gets 0 points on it. One point is lost by a pupil for each wrong answer. Mark answered 25 problems and got 5 points. How many wrong answers did he have?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "25"
      },
      {
        "key": "B",
        "text": "20"
      },
      {
        "key": "C",
        "text": "15"
      },
      {
        "key": "D",
        "text": "10"
      },
      {
        "key": "E",
        "text": "5"
      }
    ],
    "answer": "C",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Two equations",
        "body": "Let $r$ be the number of right and $w$ the number of wrong answers. Then $r + w = 25$ and $2r - w = 5$. Adding: $3r = 30$, so $r = 10$ and $w = 15$.\n\n**Answer: (C) 15**"
      },
      {
        "title": "Start from all wrong",
        "body": "If all 25 answers were wrong he would have $-25$ points. Turning one wrong answer into a right one changes the score by $+3$. To reach $5$ he needs $\\frac{5 - (-25)}{3} = 10$ right answers, so $25 - 10 = 15$ wrong ones.\n\n**Answer: (C) 15**"
      }
    ],
    "topics": [
      "algebra",
      "arithmetic"
    ],
    "difficulty": 1,
    "duplicateOf": null,
    "reviewNote": null
  },
