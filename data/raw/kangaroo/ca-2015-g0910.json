  {
    "id": "kangaroo-ca-2015-g0910-20",
    "bank": "kangaroo",
    "source": {
      "contest": "Canadian Math Kangaroo",
      "paper": "Grade 9-10",
      "year": 2015,
      "url": "https://api.mathkangaroo.ca/api/v1/media/2015/2015gr0910e.pdf",
