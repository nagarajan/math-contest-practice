  {
    "id": "kangaroo-ca-2016-g0910-27",
    "bank": "kangaroo",
    "source": {
      "contest": "Canadian Math Kangaroo",
      "paper": "Grade 9-10",
      "year": 2016,
      "url": "https://api.mathkangaroo.ca/api/v1/media/2016/2016gr0910e.pdf",
