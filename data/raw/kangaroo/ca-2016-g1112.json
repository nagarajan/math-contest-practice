  "points": 3,
  "timeMinutes": null,
  "type": "mc",
  "prompt": "Anne the Kangaroo has glued some blocks together as shown on the right. She is rotating the construction in her paws to see it from different angles. Which of the following can she not see?",
  "image": "qimages/kangaroo/ca-2016-g1112/q02.webp",
  "choices": [
   {
    "key": "A",
    "text": ""
   },
   {
    "key": "B",
    "text": ""
   },
   {
    "key": "C",
    "text": ""
   },
   {
    "key": "D",
    "text": ""
   },
   {
    "key": "E",
    "text": ""
   }
  ],
  "answer": "D",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Follow the chain of cubes",
    "body": "The construction is a single chain of cubes made of straight pieces that meet at right angles: a short piece at the front, a long straight row along the bottom, a short column going up at the end of the row, and a short row at the top that is parallel to the first piece. Rotating the construction never changes the lengths of the pieces, the order in which they follow each other, or the way each piece turns relative to the previous one.\n\nIn (A), (B), (C) and (E) you can trace the same chain (same piece lengths, same turns) seen from a different direction. In (D) the pieces are arranged differently, so (D) is a different solid: it cannot be obtained by rotating the construction.\n\n**Answer: (D)**"
   }
  ],
  "topics": [
   "spatial"
  ],
  "difficulty": 1,
  "duplicateOf": null,
  "reviewNote": "Spatial-visualisation problem; answer taken from the official key, not independently verified from the pictures."
 },
 {
  "id": "kangaroo-ca-2016-g1112-03",
  "bank": "kangaroo",
  "source": {
   "contest": "Canadian Math Kangaroo",
   "paper": "Grade 11-12",
   "year": 2016,
   "url": "https://api.mathkangaroo.ca/api/v1/media/2016/2016gr1112e.pdf",
   "number": 3
  },
  "grade": "11-12",
  "points": 3,
  "timeMinutes": null,
  "type": "mc",
  "prompt": "Let $a_n$ be a geometric progression with $a_{2015} = 2015!$ and $a_{2016} = 2016!$. What is the value of $a_{2017}$?",
  "image": null,
  "choices": [
   {
    "key": "A",
    "text": "2017!"
   },
   {
    "key": "B",
    "text": "$2016 \\cdot 2016!$"
   },
   {
    "key": "C",
    "text": "2015!"
   },
   {
    "key": "D",
    "text": "2017"
   },
   {
    "key": "E",
    "text": "2016"
   }
  ],
  "answer": "B",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Common ratio",
    "body": "The ratio is $q = \\frac{a_{2016}}{a_{2015}} = \\frac{2016!}{2015!} = 2016$. So $a_{2017} = q \\cdot a_{2016} = 2016 \\cdot 2016!$.\n\n**Answer: (B) $2016 \\cdot 2016!$**"
   },
   {
    "title": "Middle term",
    "body": "In a geometric progression the middle of three consecutive terms satisfies $a_{2016}^2 = a_{2015}a_{2017}$, so $a_{2017} = \\frac{(2016!)^2}{2015!} = 2016! \\cdot 2016$. (Note it is *not* $2017!$, which would be $2017 \\cdot 2016!$.)\n\n**Answer: (B) $2016 \\cdot 2016!$**"
   }
  ],
  "topics": [
   "sequences-series"
  ],
  "difficulty": 1,
  "duplicateOf": null,
  "reviewNote": null
 },
