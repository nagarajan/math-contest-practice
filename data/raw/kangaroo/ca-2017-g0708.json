    "solutions": [
      {
        "title": "Add up the detentions",
        "body": "9 hours 10 minutes $= 550$ minutes $= 10 \\times 55$. After being late $n$ times, Simon has spent $10(1 + 2 + \\dots + n)$ minutes, so $1 + 2 + \\dots + n = 55$. Since $1 + 2 + \\dots + 10 = 55$, he was late 10 times.\n\n**Answer: (C) 10**"
      },
      {
        "title": "Running total",
        "body": "Totals in minutes: 10, 30, 60, 100, 150, 210, 280, 360, 450, 550 — the 10th late arrival brings it to 550 minutes.\n\n**Answer: (C) 10**"
      }
