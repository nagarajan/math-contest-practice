  {
    "id": "kangaroo-ca-2017-g0910-30",
    "bank": "kangaroo",
    "source": {
      "contest": "Canadian Math Kangaroo",
      "paper": "Grade 9-10",
      "year": 2017,
      "url": "https://api.mathkangaroo.ca/api/v1/media/2017/2017gr0910e.pdf",
