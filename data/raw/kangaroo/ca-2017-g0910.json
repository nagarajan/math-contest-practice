    "timeMinutes": null,
    "type": "mc",
    "prompt": "How many pairs $(a, b)$ of digits $a$ and $b$ satisfy the condition that the product $\\overline{30a} \\cdot \\overline{7b8}$ of the three-digit numbers $\\overline{30a}$ and $\\overline{7b8}$ is positive and divisible by 15?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "1"
      },
      {
        "key": "B",
        "text": "4"
      },
      {
        "key": "C",
        "text": "10"
      },
      {
        "key": "D",
        "text": "14"
      },
      {
        "key": "E",
        "text": "100"
      }
    ],
    "answer": "D",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Divisible by 5 and by 3",
        "body": "The product is always positive. \n\n**By 5:** $\\overline{7b8}$ ends in 8, so it has no factor 5; hence $5 \\mid \\overline{30a}$, i.e. $a \\in \\{0, 5\\}$.\n\n**By 3:** 3 is prime, so it must divide one of the factors. $\\overline{30a}$ has digit sum $3 + a$ and $\\overline{7b8}$ has digit sum $15 + b$, so we need $3 \\mid a$ or $3 \\mid b$.\n- $a = 0$: always fine — any $b$: 10 pairs.\n- $a = 5$: need $3 \\mid b$, i.e. $b \\in \\{0, 3, 6, 9\\}$: 4 pairs.\n\nTotal $10 + 4 = 14$.\n\n**Answer: (D) 14**"
      }
    ],
    "topics": [
      "number-theory",
      "counting"
    ],
    "difficulty": 2,
