  "grade": "11-12",
  "points": 5,
  "timeMinutes": null,
  "type": "mc",
  "prompt": "In a sequence of six numbers, the first number is 4 and the last number is 47. Each number after the second equals the sum of the previous two numbers. S is the sum of the six numbers in this sequence. In which interval does S lie?",
  "image": null,
  "choices": [
   {
    "key": "A",
    "text": "51 to 90"
   },
   {
    "key": "B",
    "text": "91 to 100"
   },
   {
    "key": "C",
    "text": "101 to 110"
   },
   {
    "key": "D",
    "text": "111 to 120"
   },
   {
    "key": "E",
    "text": "121 to 160"
   }
  ],
  "answer": "D",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Find the second number",
    "body": "Call the second number $b$. The sequence is $4,\\ b,\\ 4 + b,\\ 4 + 2b,\\ 8 + 3b,\\ 12 + 5b$. From $12 + 5b = 47$: $b = 7$. The numbers are $4, 7, 11, 18, 29, 47$ and $S = 116$, which lies between 111 and 120.\n\n**Answer: (D) 111 to 120**"
   },
   {
    "title": "Sum equals four times the fifth term",
    "body": "For any sequence of this type with terms $a, b, a+b, a+2b, 2a+3b, 3a+5b$, the sum is $8a + 12b = 4(2a + 3b)$, i.e. four times the fifth term. Here the last term gives $12 + 5b = 47$, so $b = 7$, the fifth term is $8 + 21 = 29$ and $S = 4 \\cdot 29 = 116$.\n\n**Answer: (D) 111 to 120**"
   }
  ],
  "topics": [
   "sequences-series",
   "algebra"
  ],
  "difficulty": 3,
  "duplicateOf": null,
  "reviewNote": null
 },
