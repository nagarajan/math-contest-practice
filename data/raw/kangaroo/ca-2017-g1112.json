  "type": "mc",
  "prompt": "What is the probability that a natural number not divisible by 9 is divisible by 3?",
  "image": null,
  "choices": [
   {
    "key": "A",
    "text": "$\\frac{1}{3}$"
   },
   {
    "key": "B",
    "text": "$\\frac{2}{9}$"
   },
   {
    "key": "C",
    "text": "$\\frac{4}{9}$"
   },
   {
    "key": "D",
    "text": "$\\frac{3}{8}$"
   },
   {
    "key": "E",
    "text": "$\\frac{1}{4}$"
   }
  ],
  "answer": "E",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Look at remainders mod 9",
    "body": "Whether a number is divisible by 3 or 9 depends only on its remainder when divided by 9, and all 9 remainders are equally frequent. Not divisible by 9: remainders $1, 2, \\dots, 8$ (8 cases). Among these, divisible by 3: remainders 3 and 6 (2 cases). Probability $\\frac28 = \\frac14$.\n\n**Answer: (E) $\\frac14$**"
   },
   {
    "title": "Conditional probability",
    "body": "$P(3 \\mid n) = \\frac13$ and $P(9 \\mid n) = \\frac19$. \"Divisible by 3 but not by 9\" has probability $\\frac13 - \\frac19 = \\frac29$, and \"not divisible by 9\" has probability $\\frac89$. So the conditional probability is $\\frac{2/9}{8/9} = \\frac14$.\n\n**Answer: (E) $\\frac14$**"
   }
  ],
  "topics": [
   "probability",
   "number-theory"
  ],
  "difficulty": 1,
  "duplicateOf": null,
  "reviewNote": null
 },
