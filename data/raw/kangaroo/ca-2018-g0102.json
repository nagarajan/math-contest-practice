    ],
    "answer": "D",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Look for the plus",
        "body": "Every shape must contain the plus sign: one square with a square on each of its four sides.\n\nIn shapes A, B, C and E you can find such a plus, and the squares left over form the other piece. Shape D is a top row with two legs and a gap between them. No square in D has neighbours on all four sides, so the plus does not fit anywhere in it.\n\n**Answer: (D)**"
      }
    ],
