    "solutions": [
      {
        "title": "Find each age",
        "body": "Sister: $6 - 1 = 5$. Brother: $6 + 1 = 7$. Sum: $5 + 6 + 7 = 18$.\n\n**Answer: (C) 18**"
      },
      {
        "title": "Balance out",
        "body": "One is a year younger and one a year older, so together the three are as old as three 6-year-olds: $3 \\times 6 = 18$.\n\n**Answer: (C) 18**"
      }
