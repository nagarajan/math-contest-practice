    "solutions": [
      {
        "title": "Count different digits",
        "body": "The date is 17 03 2018. The digits are 1, 7, 0, 3, 2, 0, 1, 8. The different ones are 0, 1, 2, 3, 7, 8 — that is 6 stamps (a stamp can be used twice).\n\n**Answer: (B) 6**"
      },
      {
        "title": "Cross out repeats",
        "body": "8 digits are printed; 0 and 1 each appear twice, so $8 - 2 = 6$ different stamps.\n\n**Answer: (B) 6**"
      }
