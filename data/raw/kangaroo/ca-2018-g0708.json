    "choices": [
      {
        "key": "A",
        "text": "ROOT"
      },
      {
        "key": "B",
        "text": "BOOM"
      },
      {
        "key": "C",
        "text": "BOOT"
      },
      {
        "key": "D",
        "text": "LOOT"
      },
      {
        "key": "E",
        "text": "TOOT"
      }
    ],
    "answer": "E",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Check each letter",
        "body": "Written vertically, the word is symmetric exactly when **every letter** has a vertical line of symmetry. O, T and M have one; R, B and L do not. ROOT has R, BOOM and BOOT have B, LOOT has L. Only TOOT works.\n\n**Answer: (E) TOOT**"
      }
    ],
