      },
      {
        "key": "E",
        "text": "$12\\pi$"
      }
    ],
    "answer": "B",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Radius first",
        "body": "$\\pi r^2 = 144\\pi$ gives $r=12$. The circumference is $2\\pi\\cdot12 = 24\\pi$, and one sixth of it is $4\\pi$.\n\n**Answer: (B) $4\\pi$**"
      },
