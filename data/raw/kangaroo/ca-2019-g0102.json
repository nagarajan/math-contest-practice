    "prompt": "Jutta throws five regular dice. The total number of dots is 15. Four dice are as shown on the right. How many dots must there be on the fifth die?",
    "image": "qimages/kangaroo/ca-2019-g0102/q07.webp",
    "choices": [
      {
        "key": "A",
        "text": "1"
      },
      {
        "key": "B",
        "text": "2"
      },
      {
        "key": "C",
        "text": "3"
      },
      {
        "key": "D",
        "text": "4"
      },
      {
        "key": "E",
        "text": "5"
      }
    ],
    "answer": "E",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Add, then take away",
        "body": "The four dice show $4 + 2 + 1 + 3 = 10$ dots. The fifth die must show $15 - 10 = 5$.\n\n**Answer: (E) 5**"
      },
      {
        "title": "Count on",
        "body": "Start at 10 (the four dice) and count up to 15: 11, 12, 13, 14, 15 — that is 5 more.\n\n**Answer: (E) 5**"
      }
    ],
