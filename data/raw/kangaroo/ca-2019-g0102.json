    "type": "mc",
    "prompt": "Maya Bee was gathering pollen from all of the flowers that lie inside the rectangle, but are outside the triangle. From how many flowers did she collect pollen?",
    "image": "qimages/kangaroo/ca-2019-g0102/q06.webp",
    "choices": [
      {
        "key": "A",
        "text": "6"
      },
      {
        "key": "B",
        "text": "9"
      },
      {
        "key": "C",
        "text": "13"
      },
      {
        "key": "D",
        "text": "17"
      },
      {
        "key": "E",
        "text": "20"
      }
    ],
    "answer": "B",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Two parts of the rectangle",
        "body": "The part of the rectangle that is outside the triangle has two pieces:\n\n- the top piece, above the triangle: 6 orange flowers;\n- the bottom piece, below the triangle: 3 blue flowers.\n\n$6 + 3 = 9$ flowers.\n\n**Answer: (B) 9**"
      },
      {
        "title": "Cross out",
        "body": "Look only at the flowers inside the green rectangle and cross out those that are also inside the blue triangle. 9 flowers are left: 6 at the top and 3 at the bottom.\n\n**Answer: (B) 9**"
      }
    ],
