    "type": "mc",
    "prompt": "Amalia's machine converts one red token into three white tokens and one white token into two red tokens. Amalia has three red tokens and one white token. She uses the machine three times to convert three of her tokens. What is the smallest number of tokens she can end up with?",
    "image": "qimages/kangaroo/ca-2019-g0102/q18.webp",
    "choices": [
      {
        "key": "A",
        "text": "7"
      },
