    "prompt": "Clara wrote a hidden message to her friend by replacing each letter, as shown. How would RANGO be written?",
    "image": "qimages/kangaroo/ca-2019-g0102/q08.webp",
    "choices": [
      {
        "key": "A",
        "text": "*#%$+"
      },
      {
