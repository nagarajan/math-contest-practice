    "type": "mc",
    "prompt": "If any digit of a given 4-digit number is deleted, the resulting 3-digit number is a divisor of the original number. How many 4-digit numbers have this property?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "5"
      },
      {
        "key": "B",
