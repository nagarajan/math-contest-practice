    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Pick a price",
        "body": "Let the price in shop C be 100. Then B is 20% lower: 80. A is 25% higher than B: $80 \\cdot 1.25 = 100$. D is 30% higher than C: 130.\n\nSo A has the same price as C, and D is 30% higher than A.\n\n**Answer: (A)**"
      },
      {
        "title": "Multiply the factors",
        "body": "$A = 1.25 \\, B = 1.25 \\cdot 0.8 \\, C = C$ and $D = 1.3 \\, C = 1.3 \\, A$.\n\n**Answer: (A)**"
      }
    ],
