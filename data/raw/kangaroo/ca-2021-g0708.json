    "type": "mc",
    "prompt": "In a regular hexagon, three diagonals were drawn as shown. What is the area of the hexagon if the painted area is 20?",
    "image": "qimages/kangaroo/ca-2021-g0708/q10.webp",
    "choices": [
      {
        "key": "A",
        "text": "40"
      },
      {
        "key": "B",
        "text": "48"
      },
      {
        "key": "C",
        "text": "52"
      },
      {
        "key": "D",
        "text": "54"
      },
      {
        "key": "E",
        "text": "60"
      }
    ],
    "answer": "B",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Measure in small triangles",
        "body": "Let $T$ be the area of one of the six equilateral triangles that make up the regular hexagon. The two short diagonals cut off two triangles at the left and right corners; each has two sides of the hexagon with a $120^\\circ$ angle between them and has area $T$. The rectangle between the short diagonals has area $6T - 2T = 4T$.\n\nThe long diagonal cuts the rectangle and each corner triangle in half. The painted part is half the rectangle ($2T$) plus half a corner triangle ($\\tfrac12 T$), so $\\tfrac52 T = 20$, $T = 8$ and the hexagon has area $6 \\cdot 8 = 48$.\n\n**Answer: (B) 48**"
      }
    ],
    "topics": [
      "geometry"
    ],
    "difficulty": 1,
