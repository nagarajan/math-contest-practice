        "text": "The price in shop D is 30% higher than in shop A."
      },
      {
        "key": "B",
        "text": "The price in shop A is 30% higher than in shop D."
      },
      {
        "key": "C",
        "text": "Prices in shops A and D are equal."
      },
      {
        "key": "D",
        "text": "The price in shop D is 35% higher than in shop A."
      },
      {
        "key": "E",
        "text": "The price in shop A is 35% higher than in shop D."
      }
    ],
