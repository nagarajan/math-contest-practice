 {
  "id": "kangaroo-ca-2023-g1112-21",
  "bank": "kangaroo",
  "source": {
   "contest": "Canadian Math Kangaroo",
   "paper": "Grade 11-12",
   "year": 2023,
   "url": "https://api.mathkangaroo.ca/api/v1/media/2023/2023gr1112e.pdf",
