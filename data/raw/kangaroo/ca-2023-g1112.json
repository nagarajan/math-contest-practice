  "timeMinutes": null,
  "type": "mc",
  "prompt": "How many positive integer roots does the equation $\\sqrt{x^2-45} + \\sqrt{50-x^2} = x - 4$ have?",
  "image": null,
  "choices": [
   {
    "key": "A",
    "text": "0"
   },
   {
    "key": "B",
    "text": "1"
   },
   {
    "key": "C",
    "text": "2"
   },
   {
    "key": "D",
    "text": "3"
   },
   {
    "key": "E",
    "text": "4"
   }
  ],
  "answer": "B",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Domain first",
    "body": "Both square roots must be defined: $x^2 \\ge 45$ and $x^2 \\le 50$. The only positive integer with $45 \\le x^2 \\le 50$ is $x = 7$ ($x^2 = 49$). Check: $\\sqrt{4} + \\sqrt{1} = 3 = 7 - 4$. ✓ So there is exactly one positive integer root.\n\n**Answer: (B) 1**"
   }
  ],
  "topics": [
