    "answerUnit": null,
    "solutions": [
      {
        "title": "Substitute",
        "body": "$9 \\,@\\, 4 = 9^2 + \\frac{2 \\cdot 9}{4} = 81 + \\frac{18}{4} = \\frac{324}{4} + \\frac{18}{4} = \\frac{342}{4} = \\frac{171}{2}$.\n\n**Answer: $\\frac{171}{2}$**"
      },
      {
