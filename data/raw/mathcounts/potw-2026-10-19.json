    "grade": "6-8",
    "points": null,
    "timeMinutes": null,
    "type": "numeric",
    "prompt": "A crate of 9 pumpkins is divided into two groups. The mean weight of the 5 pumpkins that each weigh more than 10 pounds is 12 pounds. The mean weight of the 4 pumpkins that each weigh less than 10 pounds is 3 pounds. What is the mean weight for this crate of 9 pumpkins?",
    "image": null,
    "choices": null,
    "answer": "8",
    "acceptedAnswers": null,
    "answerUnit": "pounds",
    "solutions": [
      {
        "title": "Total weight",
        "body": "$5 \\times 12 + 4 \\times 3 = 60 + 12 = 72$ pounds; $72 \\div 9 = 8$ pounds.\n\n**Answer: 8 pounds**"
      },
      {
        "title": "Weighted average",
        "body": "Mean $= \\frac{5}{9}(12) + \\frac{4}{9}(3) = \\frac{60 + 12}{9} = 8$.\n\n**Answer: 8 pounds**"
      }
    ],
    "topics": [
      "statistics"
