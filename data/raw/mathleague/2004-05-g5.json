    "answer": "C",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Split each number",
        "body": "$200 + 300 + 400 = (100+100) + (200+100) + (300+100) = 100 + 200 + 300 + 300$. The missing number is 300.\n\n**Answer: (C) 300**"
      },
      {
        "title": "Compute both sides",
        "body": "The left side is 900. On the right, $100 + 200 + 300 = 600$, so the missing number is $900 - 600 = 300$.\n\n**Answer: (C) 300**"
      }
    ],
