    "answerUnit": null,
    "solutions": [
      {
        "title": "Dozens first",
        "body": "Two dozen is $2 \\times 12 = 24$. Two fewer than 24 is $24 - 2 = 22$.\n\n**Answer: (D) 22**"
      },
      {
        "title": "Careful reading",
        "body": "\"2 fewer than 2-dozen\" means start at 24 and go down 2, giving 22 (not 2 fewer than one dozen, which would be 10).\n\n**Answer: (D) 22**"
      }
    ],
