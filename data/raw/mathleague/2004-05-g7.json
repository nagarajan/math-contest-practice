    "solutions": [
      {
        "title": "Find the sides",
        "body": "The sides add to $15$ and multiply to 56. Since $7\\times8=56$ and $7+8=15$, the sides are 7 and 8. They differ by 1.\n\n**Answer: (A) 1**"
      },
      {
        "title": "Algebra",
        "body": "Let the sides be $x$ and $15-x$ with $x(15-x)=56$. Then $x^2-15x+56=0$, so $(x-7)(x-8)=0$ and the sides are 7 and 8.\n\n**Answer: (A) 1**"
      }
