    "answerUnit": null,
    "solutions": [
      {
        "title": "Track the angle",
        "body": "At 4:30 the hands are $45^\\circ$ apart (the hour hand is at $135^\\circ$, the minute hand at $180^\\circ$). Each minute the minute hand moves $6^\\circ$ and the hour hand $0.5^\\circ$, so the angle grows $5.5^\\circ$ per minute. At 4:38 it is $45+8\\times5.5=89^\\circ$ (acute); at 4:39 it is $94.5^\\circ$ (obtuse).\n\n**Answer: (D) 4:39**"
      }
