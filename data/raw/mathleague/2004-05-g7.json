    "type": "mc",
    "prompt": "If 84 players split themselves into teams, how many more teams can they form by splitting into teams of 4 instead of teams of 6?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "5"
      },
      {
        "key": "B",
        "text": "6"
      },
      {
        "key": "C",
        "text": "7"
      },
      {
        "key": "D",
        "text": "14"
      }
    ],
    "answer": "C",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Count the teams",
        "body": "With 6 per team there are $84\\div6=14$ teams; with 4 per team there are $84\\div4=21$ teams. The difference is $21-14=7$.\n\n**Answer: (C) 7**"
      },
      {
        "title": "Per-12 grouping",
        "body": "Every 12 players make 2 teams of 6 or 3 teams of 4, which is 1 more team. $84=7\\times12$, so there are 7 more teams.\n\n**Answer: (C) 7**"
      }
    ],
    "topics": [
      "arithmetic"
    ],
