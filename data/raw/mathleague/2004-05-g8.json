    "prompt": "I wear my headphones only on cloudy days. The day after each cloudy day is a sunny day. I wear my headphones at most \\underline{\\;?\\;} times in a week.",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "3"
      },
      {
        "key": "B",
        "text": "4"
      },
      {
        "key": "C",
        "text": "5"
      },
      {
        "key": "D",
        "text": "6"
      }
    ],
    "answer": "B",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Alternate days",
        "body": "Cloudy days cannot be next to each other. Taking Sunday, Tuesday, Thursday and Saturday as cloudy gives 4 days.\n\n**Answer: (B) 4**"
      },
      {
        "title": "Upper bound",
        "body": "Split the 7 days into the pairs (Sun, Mon), (Tue, Wed), (Thu, Fri) and the single day Sat. Each pair holds at most one cloudy day, so there are at most $3+1=4$ cloudy days.\n\n**Answer: (B) 4**"
      }
    ],
