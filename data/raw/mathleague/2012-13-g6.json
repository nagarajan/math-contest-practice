        "text": "21"
      },
      {
        "key": "D",
        "text": "34"
      }
    ],
    "answer": "C",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Subtract one at a time",
        "body": "Taking away $43 + 21$ is the same as taking away 43 and then taking away 21. So the blank is 21.\n\n**Answer: (C) 21**"
      },
      {
        "title": "Compute",
        "body": "Left side: $65 - 64 = 1$. Right side: $65 - 43 = 22$, and $22 - 21 = 1$. So the blank is 21.\n\n**Answer: (C) 21**"
      }
    ],
