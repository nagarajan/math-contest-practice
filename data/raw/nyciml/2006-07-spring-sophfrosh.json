  "type": "numeric",
  "prompt": "Arturo drives from home to school and averages $30$ mph. If he returns on the same route, compute what his average rate must be on the return trip in order to average $40$ mph for the entire round trip.",
  "image": null,
  "choices": null,
  "answer": "60",
  "acceptedAnswers": null,
  "answerUnit": "mph",
  "solutions": [
   {
    "title": "Use a convenient distance",
    "body": "Say the route is $60$ miles. Going takes $2$ hours. For an average of $40$ mph over $120$ miles, the whole trip takes $3$ hours, so the return takes $1$ hour: $60$ mph.\n\n**Answer: 60 mph**"
   },
   {
    "title": "Harmonic mean",
    "body": "For equal distances the average speed is the harmonic mean: $\\frac{2}{\\frac1{30} + \\frac1v} = 40$, so $\\frac1{30} + \\frac1v = \\frac1{20}$ and $\\frac1v = \\frac1{60}$, $v = 60$.\n\n**Answer: 60 mph**"
   }
  ],
  "topics": [
   "rates"
  ],
  "difficulty": 1,
  "duplicateOf": null,
  "reviewNote": null
 },
