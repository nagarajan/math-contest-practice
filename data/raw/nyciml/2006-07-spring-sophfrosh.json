  "timeMinutes": null,
  "type": "numeric",
  "prompt": "An isosceles trapezoid has sides of length $5$, $5$, $7$ and $13$. Compute the length of a diagonal of the trapezoid.",
  "image": null,
  "choices": null,
  "answer": "2*sqrt(29)",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Drop altitudes",
    "body": "The bases are $7$ and $13$ and the legs are $5$. Dropping altitudes from the ends of the short base cuts off $\\frac{13 - 7}{2} = 3$ on each side, so the height is $\\sqrt{25 - 9} = 4$. A diagonal spans horizontally $13 - 3 = 10$ and vertically $4$, so its length is $\\sqrt{100 + 16} = \\sqrt{116} = 2\\sqrt{29}$.\n\n**Answer: $2\\sqrt{29}$**"
   },
   {
    "title": "Ptolemy's theorem",
    "body": "An isosceles trapezoid is cyclic, so Ptolemy gives $d^2 = 7\\cdot13 + 5\\cdot5 = 116$, and $d = 2\\sqrt{29}$.\n\n**Answer: $2\\sqrt{29}$**"
   }
  ],
  "topics": [
   "geometry"
  ],
  "difficulty": 1,
  "duplicateOf": null,
  "reviewNote": null,
  "answerDisplay": "$2\\sqrt{29}$"
 },
