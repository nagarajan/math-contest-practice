  "type": "numeric",
  "prompt": "Fifteen balls are numbered consecutively $1$ to $15$. If $2$ different balls are picked at random, compute the probability that their sum is odd.",
  "image": null,
  "choices": null,
  "answer": "8/15",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Odd plus even",
    "body": "The sum is odd exactly when one ball is odd and one is even. There are $8$ odd and $7$ even numbers, so $8\\cdot7 = 56$ such pairs out of $\\binom{15}{2} = 105$: probability $\\frac{56}{105} = \\frac{8}{15}$.\n\n**Answer: $\\frac{8}{15}$**"
   },
   {
    "title": "Sequential draws",
    "body": "Whatever the first ball, the second must have the other parity. $P = \\frac{8}{15}\\cdot\\frac7{14} + \\frac{7}{15}\\cdot\\frac{8}{14} = \\frac{112}{210} = \\frac8{15}$.\n\n**Answer: $\\frac{8}{15}$**"
   }
  ],
  "topics": [
   "probability"
  ],
  "difficulty": 1,
  "duplicateOf": null,
  "reviewNote": null,
  "answerDisplay": "$\\frac{8}{15}$"
 },
