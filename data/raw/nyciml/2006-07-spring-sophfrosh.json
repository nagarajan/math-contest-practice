  "solutions": [
   {
    "title": "Shift and subtract",
    "body": "Let $N = 0.26333\\ldots$. Then $1000N = 263.333\\ldots$ and $100N = 26.333\\ldots$, so $900N = 237$ and $N = \\frac{237}{900} = \\frac{79}{300}$.\n\n**Answer: $\\frac{79}{300}$**"
   },
   {
    "title": "Split the decimal",
    "body": "$0.26\\overline3 = 0.26 + 0.00\\overline3 = \\frac{26}{100} + \\frac{1}{300} = \\frac{78 + 1}{300} = \\frac{79}{300}$.\n\n**Answer: $\\frac{79}{300}$**"
   }
  ],
