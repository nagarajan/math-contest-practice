  "grade": "9-12",
  "points": 1,
  "timeMinutes": null,
  "type": "numeric",
  "prompt": "Dan, Shravan, and Jake attempt to clean their room for the first time in six months. It would take Dan 3 hours to clean it by himself. It would take Shravan 10 hours and Jake 15 hours to clean the room. How long does it take the three of them together to clean the room?",
  "image": null,
  "choices": null,
  "answer": "2",
  "acceptedAnswers": null,
  "answerUnit": "hours",
  "solutions": [
   {
    "title": "Add rates",
    "body": "Per hour they clean $\\frac13+\\frac1{10}+\\frac1{15}=\\frac{10+3+2}{30}=\\frac12$ of the room, so together they need 2 hours.\n\n**Answer: 2 hours**"
   }
  ],
  "topics": [
   "rates",
   "fractions-decimals"
  ],
  "difficulty": 1,
  "duplicateOf": null,
  "reviewNote": null
 },
 {
  "id": "rmt-2004-alg-07",
  "bank": "rmt",
  "source": {
   "contest": "Rice Math Tournament",
   "paper": "Algebra",
   "year": 2004,
