 {
  "id": "rmt-2004-alg-04",
  "bank": "rmt",
  "source": {
   "contest": "Rice Math Tournament",
   "paper": "Algebra",
   "year": 2004,
   "number": 4,
   "url": "https://www.ruf.rice.edu/~eulers/tests/2004/alg-problems.pdf"
  },
  "grade": "9-12",
  "points": 1,
  "timeMinutes": null,
  "type": "self",
  "prompt": "Given that $x>0$, $y>0$, $z>0$ and\n$$xy-3x-7y+15=0,\\quad xz-2x-7z+8=0,\\quad yz-2y-3z+2=0,$$\nsolve for $x$, $y$, and $z$.",
  "image": null,
  "choices": null,
  "answer": "$x=10,\\ y=5,\\ z=4$",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Factor",
    "body": "The equations are $(x-7)(y-3)=6$, $(x-7)(z-2)=6$, $(y-3)(z-2)=4$. Multiplying, $\\left[(x-7)(y-3)(z-2)\\right]^2=144$, so the product is $\\pm12$, giving $x-7=\\pm3$, $y-3=\\pm2$, $z-2=\\pm2$ (same signs). The negative choice gives $z=0$, not allowed. So $x=10$, $y=5$, $z=4$.\n\n**Answer: $(x,y,z)=(10,5,4)$**"
   }
  ],
  "topics": [
   "algebra"
  ],
  "difficulty": 2,
  "duplicateOf": null,
  "reviewNote": null
 },
