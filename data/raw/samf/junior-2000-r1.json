      },
      {
        "key": "E",
        "text": "33"
      }
    ],
    "answer": "B",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Totals",
        "body": "The original total was $3\\times18=54$ and the new total is $3\\times23=69$. The total went up by 15, so the new number 38 is 15 more than the original one: $38-15=23$.\n\n**Answer: (B) 23**"
      }
