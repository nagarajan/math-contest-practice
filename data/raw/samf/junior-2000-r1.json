    "type": "mc",
    "prompt": "In the figure, CBA and CDE are straight lines. If $\\angle ABD=110^\\circ$ and $\\angle EDB=130^\\circ$, then $\\hat C$ equals",
    "image": "qimages/samf/junior-2000-r1/q04.webp",
    "choices": [
      {
        "key": "A",
        "text": "$30^\\circ$"
      },
      {
        "key": "B",
        "text": "$40^\\circ$"
      },
      {
        "key": "C",
        "text": "$50^\\circ$"
      },
      {
        "key": "D",
        "text": "$60^\\circ$"
      },
      {
        "key": "E",
        "text": "$70^\\circ$"
      }
    ],
    "answer": "D",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Angles on straight lines",
        "body": "$\\angle CBD=180^\\circ-110^\\circ=70^\\circ$ and $\\angle CDB=180^\\circ-130^\\circ=50^\\circ$. In triangle BCD: $\\hat C=180^\\circ-70^\\circ-50^\\circ=60^\\circ$.\n\n**Answer: (D) $60^\\circ$**"
      },
      {
        "title": "Exterior angle",
        "body": "$\\angle EDB=130^\\circ$ is exterior to triangle BCD, so equals $\\hat C+\\angle CBD=\\hat C+70^\\circ$. Thus $\\hat C=60^\\circ$.\n\n**Answer: (D) $60^\\circ$**"
      }
    ],
    "topics": [
      "geometry"
    ],
    "difficulty": 1,
    "duplicateOf": null,
    "reviewNote": null
  },
