        "text": "10 000"
      },
      {
        "key": "E",
        "text": "100 000"
      }
    ],
    "answer": "A",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Row sums are cubes",
        "body": "Row 1: $1$. Row 2: $3+5=8$. Row 3: $7+9+11=27$. Row 4: $13+15+17+19=64$. The row sums are $1^3,2^3,3^3,4^3$. (The row $n$ has $n$ odd numbers with middle value $n^2$, so the sum is $n\\cdot n^2$.) For $n=100$: $100^3=1\\,000\\,000$.\n\n**Answer: (A) 1 000 000**"
      }
    ],
