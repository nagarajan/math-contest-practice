    "answerUnit": null,
    "solutions": [
      {
        "title": "Compare volumes",
        "body": "Box A: $10\\times4\\times6=240\\text{ cm}^3$. Box B: $2\\times5\\times1=10\\text{ cm}^3$. $240\\div10=24$ boxes. (They do fit: Box B's 2, 5, 1 cm sides divide 10, 4 ... e.g. arrange the 5 cm side along the 10 cm side and 1 cm along 4 cm, and 2 cm along 6 cm: $2\\times4\\times3=24$.)\n\n**Answer: (A) 24**"
      }
