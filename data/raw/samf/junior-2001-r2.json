    "type": "mc",
    "prompt": "From the numbers $1;2;3;4;\\dots500$ a sequence is formed by deleting numbers so that no two remaining numbers have a sum which is a multiple of $7$. The maximum number of numbers in this sequence is",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "$216$"
      },
      {
        "key": "B",
        "text": "$217$"
      },
