        "text": "$20$"
      },
      {
        "key": "D",
        "text": "$24$"
      },
      {
        "key": "E",
        "text": "$30$"
      }
    ],
    "answer": "C",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Compute both times",
        "body": "At $60$ km/h: $120\\div60=2$ h $=120$ min. At $72$ km/h: $120\\div72=\\frac53$ h $=100$ min.\n\nDifference: $20$ minutes.\n\n**Answer: (C) 20**"
      }
    ],
