    "prompt": "How many non-isosceles triangles of perimeter $23$ units can be formed with sides of whole number units?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "$6$"
      },
      {
        "key": "B",
        "text": "$8$"
      },
