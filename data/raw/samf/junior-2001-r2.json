      }
    ],
    "answer": "D",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Weeks",
        "body": "$75=10\\times7+5$. Ten full weeks contain exactly $10$ Fridays. The $5$ extra days can contain one more Friday if the period starts on a Friday (or within the first few days so that a Friday falls in them), but never two.\n\nMaximum: $10+1=11$.\n\n**Answer: (D) 11**"
      }
