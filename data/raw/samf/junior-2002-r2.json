    "type": "mc",
    "prompt": "Two friends Petros and Sammy have pocket money in the ratio $3:5$. Each one spends R30. The ratio changes to $1:2$. The total amount the two friends started off with is",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "R210"
      },
      {
        "key": "B",
        "text": "R240"
      },
      {
        "key": "C",
        "text": "R270"
      },
      {
        "key": "D",
        "text": "R300"
      },
      {
        "key": "E",
        "text": "R330"
      }
    ],
    "answer": "B",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Equation",
        "body": "Let Petros have $3k$ and Sammy $5k$. After spending: $(3k-30):(5k-30)=1:2$, so $2(3k-30)=5k-30$, $6k-60=5k-30$, $k=30$.\n\nTotal $=8k=$ R240.\n\n**Answer: (B) R240**"
      }
    ],
    "topics": [
      "algebra",
      "money"
    ],
    "difficulty": 2,
