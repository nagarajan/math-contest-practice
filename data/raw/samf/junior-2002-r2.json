      },
      {
        "key": "B",
        "text": "$7x-1$"
      },
      {
        "key": "C",
        "text": "$111x-1$"
      },
      {
        "key": "D",
        "text": "$61x-10$"
      },
      {
        "key": "E",
        "text": "$\\frac52x-1$"
      }
    ],
    "answer": "D",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Place values",
        "body": "Number $=100\\cdot\\frac x2+10(x-1)+x=50x+10x-10+x=61x-10$.\n\n**Answer: (D) $61x-10$**"
      }
    ],
