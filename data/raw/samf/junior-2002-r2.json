    "type": "mc",
    "prompt": "Virginia is making $5$-digit arrangements from the digits $2$ and $4$. An example of such an arrangement is $22442$. She was told that the first digit cannot be a $4$. How many such arrangements are there?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "$16$"
      },
      {
        "key": "B",
        "text": "$24$"
      },
      {
        "key": "C",
        "text": "$20$"
      },
      {
        "key": "D",
        "text": "$8$"
      },
      {
        "key": "E",
        "text": "$32$"
      }
    ],
    "answer": "A",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Count",
        "body": "The first digit must be $2$. Each of the other $4$ digits can be $2$ or $4$ freely, giving $2^4=16$ arrangements.\n\n**Answer: (A) 16**"
      }
    ],
    "topics": [
      "counting"
    ],
