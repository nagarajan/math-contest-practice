    "answerUnit": null,
    "solutions": [
      {
        "title": "Divisors of 15",
        "body": "$x-1$ must divide $15$, so $x-1\\in\\{\\pm1,\\pm3,\\pm5,\\pm15\\}$. The smallest value is $x-1=-15$, i.e. $x=-14$.\n\n**Answer: (B) $-14$**"
      }
