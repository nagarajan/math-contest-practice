      },
      {
        "key": "E",
        "text": "more than R13"
      }
    ],
    "answer": "C",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Read the graph",
        "body": "On the horizontal axis find the mark labelled 15/01/02 and go straight up to the curve. The curve is at a height between the gridlines $11$ and $12$ (a little over $11.5$).\n\n**Answer: (C) between R11 and R12**"
      }
    ],
