    "prompt": "The units digit of $2^{2000}+2^{2001}+2^{2002}$ is",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "$0$"
      },
      {
        "key": "B",
        "text": "$2$"
      },
      {
        "key": "C",
        "text": "$4$"
      },
      {
        "key": "D",
        "text": "$6$"
      },
      {
        "key": "E",
        "text": "$8$"
      }
    ],
    "answer": "B",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Cycle of units digits",
        "body": "The units digits of powers of $2$ repeat with period $4$: $2,4,8,6,2,4,8,6,\\dots$. Since $2000\\equiv0\\pmod4$, $2^{2000}$ ends in $6$, $2^{2001}$ in $2$ and $2^{2002}$ in $4$.\n\n$6+2+4=12$, so the units digit is $2$.\n\n**Answer: (B) 2**"
      }
    ],
    "topics": [
