    "type": "mc",
    "prompt": "A supermarket always prices its goods at 'so many Rands and ninety-nine cents'. If a shopper who has bought different items has to pay R41.71, how many items did she buy?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "$41$"
      },
      {
        "key": "B",
        "text": "$39$"
      },
      {
        "key": "C",
        "text": "$30$"
      },
      {
        "key": "D",
        "text": "$19$"
      },
      {
        "key": "E",
        "text": "$29$"
      }
    ],
    "answer": "E",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Look at the cents",
        "body": "If she buys $k$ items, the cents add up to $99k$ cents and the Rand parts add whole Rands. So $99k\\equiv71\\pmod{100}$, i.e. $-k\\equiv71$, so $k\\equiv29\\pmod{100}$. Since $41.71$ is small, $k=129$ is impossible ($129\\times0.99>41.71$), so $k=29$.\n\nCheck: $29\\times0.99=28.71$, leaving R13 for the Rand parts, which is possible.\n\n**Answer: (E) 29**"
      }
    ],
    "topics": [
      "number-theory",
      "money"
    ],
    "difficulty": 2,
    "duplicateOf": null,
    "reviewNote": null,
    "wrongPoints": -1
  },
