        "key": "A",
        "text": "$9\\pi$"
      },
      {
        "key": "B",
        "text": "$12\\pi$"
      },
      {
        "key": "C",
        "text": "$15\\pi$"
      },
      {
        "key": "D",
        "text": "$18\\pi$"
      },
      {
        "key": "E",
        "text": "$21\\pi$"
      }
    ],
    "answer": "B",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Fill the tank",
        "body": "When the tank is full the space above the liquid has height $h=0$ and the liquid surface is the top of the tank, with radius $r$ equal to the tank's radius. So $0=21-\\frac72r$, giving $r=6$.\n\nThe circumference is $2\\pi\\times6=12\\pi$ metres.\n\n**Answer: (B) $12\\pi$**"
      }
    ],
