    "type": "mc",
    "prompt": "Which one of the following is an odd number?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "$2001^2+3$"
      },
      {
        "key": "B",
        "text": "$2002^2+10$"
      },
      {
        "key": "C",
        "text": "$2003^2+7$"
      },
      {
        "key": "D",
        "text": "$2004^2+1$"
      },
      {
        "key": "E",
        "text": "$2005^2+9$"
      }
    ],
    "answer": "D",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Parity",
        "body": "An odd number squared is odd, an even number squared is even.\n\n- $2001^2+3$: odd $+$ odd $=$ even.\n- $2002^2+10$: even $+$ even $=$ even.\n- $2003^2+7$: odd $+$ odd $=$ even.\n- $2004^2+1$: even $+$ odd $=$ odd.\n- $2005^2+9$: odd $+$ odd $=$ even.\n\n**Answer: (D) $2004^2+1$**"
      }
    ],
    "topics": [
      "number-theory"
