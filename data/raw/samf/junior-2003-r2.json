    "type": "mc",
    "prompt": "The pie chart shows the breakdown of the $500$ runs scored by one of the South African batsmen over the last three years. The percentage of runs in $2003$ is",
    "image": "qimages/samf/junior-2003-r2/q03.webp",
    "choices": [
      {
        "key": "A",
        "text": "$45\\%$"
      },
      {
        "key": "B",
        "text": "$20\\%$"
      },
      {
        "key": "C",
        "text": "$15\\%$"
      },
      {
        "key": "D",
        "text": "$65\\%$"
      },
      {
        "key": "E",
        "text": "$35\\%$"
      }
    ],
    "answer": "E",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Percentages add to 100",
        "body": "The year $2002$ has $225$ runs, which is $\\frac{225}{500}=45\\%$. The year $2001$ has $20\\%$. So $2003$ has $100\\%-45\\%-20\\%=35\\%$.\n\n**Answer: (E) 35%**"
      }
    ],
    "topics": [
      "statistics",
      "fractions-decimals"
    ],
