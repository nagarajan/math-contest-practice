    "type": "mc",
    "prompt": "A three-digit number is divisible by 8, 12 and 30. The smallest possible number is:",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "108"
      },
      {
        "key": "B",
        "text": "120"
      },
      {
        "key": "C",
        "text": "240"
      },
      {
        "key": "D",
        "text": "360"
      },
      {
        "key": "E",
        "text": "480"
      }
    ],
    "answer": "B",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Lowest common multiple",
        "body": "$8=2^3$, $12=2^2\\cdot3$, $30=2\\cdot3\\cdot5$, so the lcm is $2^3\\cdot3\\cdot5=120$. This is already a three-digit number, so the smallest such number is $120$.\n\n**Answer: (B) 120**"
      }
    ],
