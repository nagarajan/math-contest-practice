    "points": 5,
    "timeMinutes": null,
    "type": "mc",
    "prompt": "The product of two consecutive whole numbers is $p$. The square of the larger number minus the smaller number is:",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "$\\frac p2$"
      },
      {
        "key": "B",
        "text": "$p-1$"
      },
      {
        "key": "C",
        "text": "$p^2$"
      },
      {
        "key": "D",
        "text": "$p+1$"
      },
      {
        "key": "E",
        "text": "$2p+1$"
      }
    ],
    "answer": "D",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Algebra",
        "body": "Let the numbers be $x$ and $x+1$, so $p=x(x+1)=x^2+x$. Then $(x+1)^2-x=x^2+2x+1-x=x^2+x+1=p+1$.\n\n**Answer: (D) $p+1$**"
      },
      {
        "title": "Test",
        "body": "$2,3$: $p=6$, $3^2-2=7=p+1$. $3,4$: $p=12$, $16-3=13=p+1$.\n\n**Answer: (D) $p+1$**"
      }
    ],
    "topics": [
      "algebra"
    ],
    "difficulty": 2,
    "duplicateOf": null,
    "reviewNote": null
  },
