    "choices": [
      {
        "key": "A",
        "text": "6"
      },
      {
        "key": "B",
        "text": "10"
      },
      {
        "key": "C",
        "text": "4"
      },
      {
        "key": "D",
        "text": "8"
      },
      {
        "key": "E",
        "text": "9"
      }
    ],
    "answer": "B",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Count paths",
        "body": "Every route has $3$ steps east and $2$ steps south in some order: $\\binom52=10$ routes.\n\n**Answer: (B) 10**"
      },
      {
        "title": "Add up the ways",
        "body": "Write at each corner the number of routes to it: the top row and left column have $1$ each; every other corner is the sum of the one above and to the left. The grid is $1,1,1,1\\,/\\,1,2,3,4\\,/\\,1,3,6,10$, so the bottom-right corner has $10$.\n\n**Answer: (B) 10**"
      }
    ],
