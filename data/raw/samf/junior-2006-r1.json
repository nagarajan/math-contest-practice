      {
        "key": "A",
        "text": "3"
      },
      {
        "key": "B",
        "text": "5"
      },
      {
        "key": "C",
        "text": "7"
      },
      {
        "key": "D",
        "text": "9"
      },
      {
        "key": "E",
        "text": "11"
      }
    ],
    "answer": "C",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Worst case",
        "body": "In the worst case she draws two beads of each colour (six beads) without three of a kind. The seventh bead must give three of one colour. With only six beads she could still have two of each colour, so $7$ beads are needed.\n\n**Answer: (C) 7**"
      }
    ],
