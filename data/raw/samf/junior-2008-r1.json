    "type": "mc",
    "prompt": "Five protractors cost the same as seven set squares. The cost of five protractors and a set square is equal to R62.00. What would one pay for 28 such set squares?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "R197"
      },
      {
        "key": "B",
        "text": "R207"
      },
      {
        "key": "C",
        "text": "R217"
      },
      {
        "key": "D",
        "text": "R227"
      },
      {
        "key": "E",
        "text": "R237"
      }
    ],
    "answer": "C",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Replace the protractors",
        "body": "Five protractors cost the same as 7 set squares, so 5 protractors and 1 set square cost the same as 8 set squares: $8s=62$, $s=7.75$. Then $28s=28\\times7.75=217$.\n\n**Answer: (C) R217**"
      },
      {
        "title": "Scale up",
        "body": "$8s=62$, so $4s=31$ and $28s=7\\times4s=7\\times31=217$.\n\n**Answer: (C) R217**"
      }
    ],
    "topics": [
