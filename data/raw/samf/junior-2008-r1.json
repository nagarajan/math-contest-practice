        "text": "21"
      },
      {
        "key": "D",
        "text": "22"
      },
      {
        "key": "E",
        "text": "23"
      }
    ],
    "answer": "D",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Use the LCM",
        "body": "A number divisible by 6 and 9 is divisible by $\\text{lcm}(6,9)=18$. The multiples of 18 between 100 and 500 run from $6\\times18=108$ to $27\\times18=486$, which is $27-6+1=22$ numbers.\n\n**Answer: (D) 22**"
      }
    ],
