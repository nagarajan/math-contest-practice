    "timeMinutes": null,
    "type": "mc",
    "prompt": "Consider the following 4 numbers: $a, b, c, d$. $b$ is greater than $a$ by $\\frac15$, $b$ is less than $c$ by $\\frac16$ and $d$ is greater than $a$ by $\\frac12$. If $a+b+c+d=9\\frac1{15}$ then find the value of $a$.",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "1"
      },
      {
        "key": "B",
        "text": "2"
      },
      {
        "key": "C",
        "text": "3"
      },
      {
        "key": "D",
        "text": "4"
      },
      {
        "key": "E",
        "text": "5"
      }
    ],
    "answer": "B",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Express everything in terms of a",
        "body": "$b=a+\\frac15$, $c=b+\\frac16=a+\\frac{11}{30}$, $d=a+\\frac12$. So $a+b+c+d=4a+\\frac{6+11+15}{30}=4a+\\frac{32}{30}=4a+1\\frac1{15}$.\n\nThen $4a=9\\frac1{15}-1\\frac1{15}=8$ and $a=2$.\n\n**Answer: (B) 2**"
      }
    ],
    "topics": [
      "algebra",
      "fractions-decimals"
    ],
    "difficulty": 2,
    "duplicateOf": null,
    "reviewNote": null
