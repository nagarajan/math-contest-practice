    "type": "mc",
    "prompt": "Consider the following numbers: 16; 13; 10; 8. Two numbers are selected from the above set and added. The remaining two numbers are selected from the above set and added. These two sums are subtracted. How many different positive answers are possible?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "7"
      },
      {
        "key": "B",
        "text": "6"
      },
      {
        "key": "C",
        "text": "5"
      },
      {
        "key": "D",
        "text": "4"
      },
      {
        "key": "E",
        "text": "3"
      }
    ],
    "answer": "E",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "List the splits",
        "body": "The set can be split into two pairs in only 3 ways, each giving one positive difference:\n\n- $\\{16,13\\}$ and $\\{10,8\\}$: $29-18=11$\n- $\\{16,10\\}$ and $\\{13,8\\}$: $26-21=5$\n- $\\{16,8\\}$ and $\\{13,10\\}$: $24-23=1$\n\nThere are 3 different positive answers.\n\n**Answer: (E) 3**"
      }
    ],
