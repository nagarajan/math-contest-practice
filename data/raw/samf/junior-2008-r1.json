      },
      {
        "key": "E",
        "text": "434 888"
      }
    ],
    "answer": "A",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Subtract the two products",
        "body": "$13\\,278-13\\,129=149$, so $2918\\times149=2918\\times13\\,278-2918\\times13\\,129=38\\,745\\,204-38\\,310\\,422=434\\,782$.\n\n**Answer: (A) 434 782**"
      },
      {
        "title": "Direct check",
        "body": "$2918\\times149=2918\\times150-2918=437\\,700-2918=434\\,782$.\n\n**Answer: (A) 434 782**"
