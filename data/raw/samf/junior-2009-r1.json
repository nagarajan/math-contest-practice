      },
      {
        "key": "E",
        "text": "95"
      }
    ],
    "answer": "D",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Slide the sides",
        "body": "All angles are right angles. The vertical sides $CD+EF$ together equal $AB=20$ and the horizontal sides $BC+DE$ together equal $AF=25$. So the perimeter equals that of the $20\\times25$ rectangle: $2(20+25)=90$.\n\n**Answer: (D) 90**"
      }
    ],
