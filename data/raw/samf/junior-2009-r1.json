    "type": "mc",
    "prompt": "Pieter and Jacob share a packet of sweets in the ratio 7 : 5. Pieter gets 14 sweets more than Jacob. The number of sweets that was in the packet is:",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "84"
      },
      {
        "key": "B",
        "text": "24"
      },
      {
        "key": "C",
        "text": "56"
      },
      {
        "key": "D",
        "text": "49"
      },
      {
        "key": "E",
        "text": "26"
      }
    ],
    "answer": "A",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Ratio parts",
        "body": "Pieter has $7x$ and Jacob $5x$ sweets, so $2x=14$ and $x=7$. The packet has $12x=84$ sweets.\n\n**Answer: (A) 84**"
      }
    ],
    "topics": [
