      },
      {
        "key": "D",
        "text": "72"
      },
      {
        "key": "E",
        "text": "54"
      }
    ],
    "answer": "E",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Count rows and columns",
        "body": "Front to back: $2+1+3=6$ rows. Left to right: $3+1+5=9$ desks per row. Total $6\\times9=54$.\n\n**Answer: (E) 54**"
      }
