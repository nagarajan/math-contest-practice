    "type": "mc",
    "prompt": "Anne says Barbara is lying. Barbara says Catherine is lying. Catherine says Barbara is lying. Diane says Anne is lying. How many girls are lying?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "0"
      },
      {
        "key": "B",
        "text": "1"
