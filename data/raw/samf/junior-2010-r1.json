      }
    ],
    "answer": "D",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Look at the factor 55",
        "body": "Only the units digits matter. The product contains the factor $55$, which ends in $5$, and every other factor is odd. An odd number times a number ending in $5$ ends in $5$. (It cannot end in $0$ because no factor is even.)\n\n**Answer: (D) 5**"
      },
      {
        "title": "Multiply the units digits",
        "body": "$9\\cdot7=63\\to3$; $3\\cdot1=3$; $3\\cdot5=15\\to5$; $5\\cdot3=15\\to5$; $5\\cdot9=45\\to5$.\n\n**Answer: (D) 5**"
      }
    ],
