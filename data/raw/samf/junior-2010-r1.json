    "type": "mc",
    "prompt": "In a grade of 100 learners, 40% of the boys scored A symbols and 50% of the girls scored A symbols. Four more boys than girls scored A symbols. The number of boys in the grade is",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "80"
      },
      {
        "key": "B",
        "text": "70"
      },
      {
