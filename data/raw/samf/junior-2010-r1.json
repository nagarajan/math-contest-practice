      {
        "key": "D",
        "text": "5"
      },
      {
        "key": "E",
        "text": "6"
      }
    ],
    "answer": "C",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "List the candidates",
        "body": "A prime larger than 5 cannot end in $2$ or $5$, so the units digit is $3$ or $7$. Candidates: $23, 33, 53, 73, 27, 37, 57, 77$. Remove $33=3\\cdot11$, $27=3^3$, $57=3\\cdot19$, $77=7\\cdot11$. The primes are $23, 37, 53, 73$.\n\n**Answer: (C) 4**"
      }
    ],
