    "timeMinutes": null,
    "type": "mc",
    "prompt": "One and only one of the following pairs of numbers will *not* satisfy the equation $187x-104y=41$. Which one is it?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "$x=3,\\ y=5$"
      },
      {
        "key": "B",
        "text": "$x=107,\\ y=192$"
      },
      {
        "key": "C",
        "text": "$x=211,\\ y=379$"
      },
      {
        "key": "D",
        "text": "$x=314,\\ y=565$"
      },
      {
        "key": "E",
        "text": "$x=419,\\ y=753$"
      }
    ],
    "answer": "D",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Parity",
        "body": "$104y$ is always even and $41$ is odd, so $187x$ must be odd, i.e. $x$ must be odd. Only (D) has an even $x$ (314), so it cannot satisfy the equation.\n\n**Answer: (D)**"
      },
      {
        "title": "Direct check",
