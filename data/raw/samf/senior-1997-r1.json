    "type": "mc",
    "prompt": "$n$ is a number such that $$n\\times n=n+n.$$ How many such numbers are there?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "0"
      },
      {
        "key": "B",
        "text": "1"
      },
      {
        "key": "C",
        "text": "2"
      },
      {
        "key": "D",
        "text": "3"
      },
      {
        "key": "E",
        "text": "infinitely many"
      }
    ],
    "answer": "C",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Solve the equation",
        "body": "$n^2=2n\\iff n(n-2)=0$, so $n=0$ or $n=2$. Both work ($0\\cdot0=0+0$, $2\\cdot2=2+2$). There are exactly two such numbers.\n\n**Answer: (C) 2**"
      }
    ],
