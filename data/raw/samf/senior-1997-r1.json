    "type": "mc",
    "prompt": "If Isaac walks to school and rides his bicycle back home it takes him 90 minutes. If he rides his bicycle both ways it takes him 30 minutes. How many hours would it take him to make the trip to school and back by walking? (Assume that he walks at a constant speed and that he cycles at a constant speed.)",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "2"
      },
      {
        "key": "B",
        "text": "2.5"
      },
      {
        "key": "C",
        "text": "3"
      },
      {
        "key": "D",
        "text": "3.5"
      },
      {
        "key": "E",
        "text": "4"
      }
    ],
    "answer": "B",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "One-way times",
        "body": "Cycling both ways takes 30 minutes, so cycling one way takes 15 minutes. Then walking one way takes $90-15=75$ minutes, and walking both ways takes $150$ minutes $=2.5$ hours.\n\n**Answer: (B) 2.5**"
      }
    ],
    "topics": [
      "rates"
    ],
    "difficulty": 2,
    "duplicateOf": null,
    "reviewNote": null
  },
