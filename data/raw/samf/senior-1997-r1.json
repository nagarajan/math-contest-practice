      }
    ],
    "answer": "E",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Work modulo 3",
        "body": "Squares are $0$ or $1$ modulo 3, so $x^2-3y^2\\equiv x^2\\pmod3$ is $0$ or $1$. But $1997=3\\cdot665+2\\equiv2\\pmod3$. So $x^2-3y^2\\equiv x^2\\not\\equiv2$, and there are no solutions.\n\n**Answer: (E) none**"
      }
    ],
