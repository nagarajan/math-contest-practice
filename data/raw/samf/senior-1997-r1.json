    "timeMinutes": null,
    "type": "mc",
    "prompt": "The triangular numbers are the numbers 1, 3, 6, 10, 15, 21, 28 and so on. How many of the first 250 triangular numbers are divisible by 5?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "100"
      },
      {
        "key": "B",
        "text": "150"
      },
      {
        "key": "C",
        "text": "125"
      },
      {
        "key": "D",
        "text": "75"
      },
      {
        "key": "E",
        "text": "50"
      }
    ],
    "answer": "A",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Use the formula",
        "body": "The $n$-th triangular number is $\\frac{n(n+1)}2$. It is divisible by 5 exactly when $5\\mid n$ or $5\\mid n+1$ (the factor $\\frac12$ does not matter since 5 is odd). That is $n\\equiv0$ or $4\\pmod5$: 2 out of every 5 values of $n$. Among $n=1,\\dots,250$ that is $\\frac25\\cdot250=100$.\n\n**Answer: (A) 100**"
      }
    ],
    "topics": [
      "number-theory",
      "sequences-series"
    ],
    "difficulty": 2,
