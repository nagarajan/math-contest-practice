    "type": "mc",
    "prompt": "The sum of the squares of 4 consecutive natural numbers is 5334. The smallest of these 4 numbers is",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "37"
      },
      {
        "key": "B",
        "text": "41"
      },
      {
        "key": "C",
        "text": "33"
      },
      {
        "key": "D",
        "text": "35"
      },
      {
        "key": "E",
        "text": "29"
      }
    ],
    "answer": "D",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Set up an equation",
        "body": "Let the numbers be $n-1,n,n+1,n+2$. Then $(n-1)^2+n^2+(n+1)^2+(n+2)^2=4n^2+4n+6=5334$, so $n^2+n=1332$ and $(n-36)(n+37)=0$, giving $n=36$. The smallest number is $35$. (Check: $35^2+36^2+37^2+38^2=1225+1296+1369+1444=5334$.)\n\n**Answer: (D) 35**"
      }
    ],
    "topics": [
      "algebra",
      "number-theory"
    ],
    "difficulty": 2,
    "duplicateOf": null,
    "reviewNote": null
  },
