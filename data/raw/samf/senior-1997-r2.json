        "text": "$17\\sqrt5$"
      }
    ],
    "answer": "B",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Subtract the white triangle",
        "body": "The rectangle has area $12\\times7=84$. The white triangle has base 12 and height 7, so its area is $\\frac12\\cdot12\\cdot7=42$. The shaded area is $84-42=42$.\n\n**Answer: (B) 42**"
      }
    ],
