        "text": "360 000"
      },
      {
        "key": "E",
        "text": "450 000"
      }
    ],
    "answer": "D",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Bound the volume",
        "body": "The third side lies between 50 cm and 90 cm. So the volume lies between $50\\times50\\times90=225\\,000$ and $50\\times90\\times90=405\\,000$ cm$^3$. Only $360\\,000$ is in this range.\n\n**Answer: (D) 360 000**"
      }
