        "text": "5"
      },
      {
        "key": "B",
        "text": "15"
      },
      {
        "key": "C",
        "text": "24"
      },
      {
        "key": "D",
        "text": "25"
      },
      {
        "key": "E",
        "text": "30"
      }
    ],
    "answer": "E",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "One of each kind",
        "body": "One coin of each kind is worth $2+5+10+50+100=167$ cents $=$ R1.67. The total is R10.02 $=1002$ cents, and $1002\\div167=6$. So she has 6 coins of each kind, i.e. $6\\times5=30$ coins.\n\n**Answer: (E) 30**"
      }
    ],
