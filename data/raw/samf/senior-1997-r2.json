        "key": "A",
        "text": "$4:\\pi$"
      },
      {
        "key": "B",
        "text": "$2:\\sqrt3$"
      },
      {
        "key": "C",
        "text": "$\\sqrt2:1$"
      },
      {
        "key": "D",
        "text": "$\\pi:3$"
      },
      {
        "key": "E",
        "text": "$\\pi:\\sqrt6$"
      }
    ],
    "answer": "D",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Equilateral triangles",
        "body": "Joining the centre to the vertices splits the hexagon into 6 equilateral triangles whose sides equal the radius $r$. The hexagon's perimeter is $6r$ and the circle's circumference is $2\\pi r$. The ratio is $2\\pi r:6r=\\pi:3$.\n\n**Answer: (D) $\\pi:3$**"
      }
    ],
    "topics": [
