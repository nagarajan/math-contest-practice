        "text": "2"
      },
      {
        "key": "D",
        "text": "9"
      },
      {
        "key": "E",
        "text": "10"
      }
    ],
    "answer": "E",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Write the number as $10m+n$",
        "body": "$(10m+n)-(m+n)=9m=45$, so $m=5$ and $n$ can be any digit $0,\\dots,9$. The numbers are $50,51,\\dots,59$: ten numbers.\n\n**Answer: (E) 10**"
      }
    ],
