    "type": "mc",
    "prompt": "There are 6 black socks, 14 green socks and 8 blue socks in a drawer. What is the smallest number of socks that must be taken out, all at once, in order to be sure to get a matching pair?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "2"
      },
      {
        "key": "B",
        "text": "3"
      },
      {
        "key": "C",
        "text": "4"
      },
      {
        "key": "D",
        "text": "6"
      },
      {
        "key": "E",
        "text": "8"
      }
    ],
    "answer": "C",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Pigeonhole principle",
        "body": "There are only 3 colours, so 3 socks could all be different. A fourth sock must repeat a colour, so 4 socks guarantee a matching pair.\n\n**Answer: (C) 4**"
      }
    ],
    "topics": [
