    "type": "mc",
    "prompt": "The dodecahedron illustrated is a regular solid with 12 faces, each of which is a regular pentagon (5-sided figure). The faces are joined along edges and meet at vertices. For this solid the number of vertices plus the number of edges is",
    "image": "qimages/samf/senior-1998-r2/q12.webp",
    "choices": [
      {
        "key": "A",
        "text": "20"
      },
      {
        "key": "B",
        "text": "42"
      },
      {
        "key": "C",
        "text": "50"
      },
      {
        "key": "D",
        "text": "60"
      },
      {
        "key": "E",
        "text": "72"
      }
    ],
    "answer": "C",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Count incidences",
        "body": "Each of the 12 pentagons has 5 vertices and 5 edges. Three faces meet at each vertex, so $V=\\frac{12\\cdot5}3=20$. Each edge belongs to two faces, so $E=\\frac{12\\cdot5}2=30$. $V+E=50$.\n\n**Answer: (C) 50**"
      },
      {
        "title": "Euler's formula",
        "body": "$V-E+F=2$ with $F=12$ gives $V-E=-10$; with $E=30$ we get $V=20$ again. Sum $=50$.\n\n**Answer: (C) 50**"
      }
    ],
    "topics": [
      "geometry",
      "counting"
    ],
    "difficulty": 2,
    "duplicateOf": null,
    "reviewNote": null
  },
  {
