    "points": 5,
    "timeMinutes": null,
    "type": "mc",
    "prompt": "$ABCD$ is a rectangle. The area of the shaded rectangle is (in the figure, the thin lines from $D$ and from $B$ continue two sides of the shaded rectangle; one vertex of the shaded rectangle lies on $DC$, dividing it into parts 5 and 8, and $AD=6$)",
    "image": "qimages/samf/senior-1998-r2/q07.webp",
    "choices": [
      {
        "key": "A",
        "text": "10"
      },
      {
        "key": "B",
        "text": "14"
      },
      {
        "key": "C",
        "text": "15"
      },
      {
        "key": "D",
        "text": "16"
      },
      {
        "key": "E",
        "text": "18"
      }
    ],
    "answer": "E",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Similar right triangles",
        "body": "Let $P$ be the vertex of the shaded rectangle on $DC$, with $DP=5$ and $PC=8$. The side of the shaded rectangle through $P$, extended, passes through $B$: right triangle $PCB$ has legs $PC=8$, $CB=6$ and hypotenuse $PB=10$. The side of the shaded rectangle through $D$ is parallel to $PB$, and the other side through $P$ is perpendicular to it; so the right triangle formed at $D$ with hypotenuse $DP=5$ is similar to triangle $BPC$ (ratio $\\frac12$), with legs $4$ and $3$. Hence the shaded rectangle has one side $3$ (the distance between the parallel lines through $D$ and $P$). By the symmetry of the figure about the centre of $ABCD$, the part of $PB$ outside the shaded rectangle at the $B$ end also has length 4, so the other side is $PB-4=10-4=6$. Area $=3\\times6=18$.\n\n**Answer: (E) 18**"
      }
    ],
    "topics": [
      "geometry"
    ],
    "difficulty": 3,
    "duplicateOf": null,
    "reviewNote": null
  },
