    "type": "mc",
    "prompt": "Agnes said 'Billy always speaks the truth'. Billy said 'Agnes is lying'. Charlotte said 'Agnes and Billy are both lying'. Who is speaking the truth?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "Only Agnes"
      },
      {
        "key": "B",
        "text": "Only Billy"
      },
      {
        "key": "C",
        "text": "Only Charlotte"
      },
      {
        "key": "D",
        "text": "Both Billy and Charlotte"
      },
      {
        "key": "E",
        "text": "None of them."
      }
    ],
    "answer": "B",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Case analysis",
        "body": "Agnes and Billy contradict each other, so exactly one of them tells the truth (on this occasion). Hence 'Agnes and Billy are both lying' is false, so Charlotte lies. If Agnes were truthful, Billy would always speak the truth, so 'Agnes is lying' would be true: contradiction. So Agnes is lying and Billy's statement is true. Only Billy speaks the truth.\n\n**Answer: (B) Only Billy**"
      }
    ],
    "topics": [
      "logic"
    ],
    "difficulty": 2,
    "duplicateOf": null,
    "reviewNote": null
  },
