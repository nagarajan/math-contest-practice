    "timeMinutes": null,
    "type": "mc",
    "prompt": "In $\\triangle ABC$, $AY=AZ$, $BZ=BX$ and $CX=CY$ (with $X$, $Y$, $Z$ on $BC$, $CA$, $AB$ respectively). The length of $BC$ is $a$, that of $CA$ is $b$ and $BA$ is $c$. The length of $AY$ is",
    "image": "qimages/samf/senior-1998-r2/q10.webp",
    "choices": [
      {
        "key": "A",
        "text": "$\\frac12(a+c-b)$"
      },
      {
        "key": "B",
        "text": "$\\frac12(a+b-c)$"
      },
      {
        "key": "C",
        "text": "$\\frac12(b+c-a)$"
      },
      {
        "key": "D",
        "text": "$\\frac14(2b+a-c)$"
      },
      {
        "key": "E",
        "text": "$\\frac14(2b+c-a)$"
      }
    ],
    "answer": "C",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Tangent lengths",
        "body": "Let $AY=AZ=z$, $BZ=BX=y$, $CX=CY=x$. Then $x+y=a$, $x+z=b$, $y+z=c$. Adding the last two and subtracting the first: $2z=b+c-a$, so $AY=z=\\frac12(b+c-a)$.\n\n**Answer: (C) $\\frac12(b+c-a)$**"
      }
    ],
    "topics": [
      "geometry",
      "algebra"
    ],
    "difficulty": 2,
    "duplicateOf": null,
    "reviewNote": null
  },
