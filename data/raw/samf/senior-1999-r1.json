    "type": "mc",
    "prompt": "Let $x=\\sqrt{0.25}$, $y=\\sqrt[3]{0.124}$ and $z=\\sqrt[4]{0.0626}$. Then",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "$y<z<x$"
      },
      {
        "key": "B",
        "text": "$x<z<y$"
      },
      {
        "key": "C",
        "text": "$z<y<x$"
      },
      {
        "key": "D",
        "text": "$x<y<z$"
      },
      {
        "key": "E",
        "text": "$y<x<z$"
      }
    ],
    "answer": "E",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Compare with $0.5$",
        "body": "$0.5^2=0.25$, $0.5^3=0.125$, $0.5^4=0.0625$. So $x=0.5$; $0.124<0.125$ gives $y<0.5$; $0.0626>0.0625$ gives $z>0.5$. Hence $y<x<z$.\n\n**Answer: (E) $y<x<z$**"
      }
    ],
