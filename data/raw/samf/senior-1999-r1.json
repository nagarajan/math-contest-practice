        "key": "C",
        "text": "359"
      },
      {
        "key": "D",
        "text": "382"
      },
      {
        "key": "E",
        "text": "358"
      }
    ],
    "answer": "A",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Inclusion-exclusion",
        "body": "There are 399 natural numbers below 400. Multiples of 17: $\\lfloor399/17\\rfloor=23$. Multiples of 23: $\\lfloor399/23\\rfloor=17$. Multiples of both ($17\\cdot23=391$): 1. Divisible by 17 or 23: $23+17-1=39$. Not divisible by either: $399-39=360$.\n\n**Answer: (A) 360**"
      }
    ],
