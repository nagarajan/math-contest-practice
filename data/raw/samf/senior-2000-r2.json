        "text": "more than 3"
      }
    ],
    "answer": "D",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Clear denominators",
        "body": "Since $n+16>0$: $5(n+16)<9n$ gives $80<4n$, i.e. $n>20$; and $7n<4(n+16)$ gives $3n<64$, i.e. $n<21\\frac13$. So $20<n<21\\frac13$ and only $n=21$ works.\n\n**Answer: (D) 1**"
      }
