    "type": "mc",
    "prompt": "If\n$$\\frac{3x-5}{x^2-1}=\\frac{A}{x-1}+\\frac{B}{x+1}$$\nis true for all possible values of $x$, then the value of $A^2+B^2$ is",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "25"
      },
      {
        "key": "B",
        "text": "17"
      },
      {
        "key": "C",
        "text": "10"
      },
      {
        "key": "D",
        "text": "18"
      },
      {
        "key": "E",
        "text": "26"
      }
    ],
    "answer": "B",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Match numerators",
        "body": "Over the common denominator, $A(x+1)+B(x-1)=(A+B)x+(A-B)=3x-5$ for all $x$. So $A+B=3$, $A-B=-5$, giving $A=-1$, $B=4$ and $A^2+B^2=1+16=17$.\n\n**Answer: (B) 17**"
      },
      {
        "title": "Substitute values",
        "body": "Put $x=1$ in $3x-5=A(x+1)+B(x-1)$: $-2=2A$, $A=-1$. Put $x=-1$: $-8=-2B$, $B=4$. So $A^2+B^2=17$.\n\n**Answer: (B)**"
      }
    ],
    "topics": [
      "algebra"
    ],
    "difficulty": 2,
    "duplicateOf": null,
    "reviewNote": null,
    "wrongPoints": -1
  },
