    "prompt": "The figure shows a regular pentagon $ABCDE$. The size of angle $DFC$ is",
    "image": "qimages/samf/senior-2002-r1/q07.webp",
    "choices": [
      {
        "key": "A",
        "text": "$36^\\circ$"
      },
      {
