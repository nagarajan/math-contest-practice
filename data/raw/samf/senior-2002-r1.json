    "answer": "A",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Right triangle",
        "body": "Let $M$ have radius $r$. Its centre is at distance $1-r$ above the centre of the large semicircle and at distance $\\frac12+r$ from the centre of either small semicircle, which is $\\frac12$ from the large centre. So $\\left(\\frac12+r\\right)^2=(1-r)^2+\\frac14$, giving $r+\\frac14=1-2r+\\frac14$, i.e. $r=\\frac13$.\n\n**Answer: (A) $\\frac13$**"
      }
