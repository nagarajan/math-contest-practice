    "prompt": "How many two-digit numbers are exactly seven times the sum of their digits?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "4"
      },
      {
        "key": "B",
        "text": "5"
      },
      {
        "key": "C",
        "text": "6"
      },
      {
        "key": "D",
        "text": "7"
      },
      {
        "key": "E",
        "text": "more than 7"
      }
    ],
    "answer": "A",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Equation",
        "body": "With tens digit $T$ and units digit $U$: $10T+U=7(T+U)$, so $3T=6U$, $T=2U$. With $T\\le9$ and $T\\ge1$: $U=1,2,3,4$ giving $21,42,63,84$. Four numbers.\n\n**Answer: (A) 4**"
      }
    ],
