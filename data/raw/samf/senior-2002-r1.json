    "grade": "10-12",
    "points": 5,
    "timeMinutes": null,
    "type": "mc",
    "prompt": "A cyclist notices that her average speed when she has covered exactly half the total distance of her race is 30 km/h. What should her average speed over the second half of the race be if she wants to finish the race with an average speed of 40 km/h?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "45 km/h"
      },
      {
        "key": "B",
        "text": "50 km/h"
      },
      {
        "key": "C",
        "text": "60 km/h"
      },
      {
        "key": "D",
        "text": "54 km/h"
      },
      {
        "key": "E",
        "text": "cannot be determined from the available information"
      }
    ],
    "answer": "C",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Use times",
        "body": "Let each half be $D$. Total time at 40 km/h: $\\frac{2D}{40}=\\frac D{20}$. First half took $\\frac D{30}$. Second half must take $\\frac D{20}-\\frac D{30}=\\frac D{60}$, so the speed is 60 km/h.\n\n**Answer: (C) 60 km/h**"
      },
      {
        "title": "Harmonic mean",
        "body": "Average speed over two equal distances is the harmonic mean: $\\frac{2}{\\frac1{30}+\\frac1S}=40$ gives $\\frac1S=\\frac1{20}-\\frac1{30}=\\frac1{60}$.\n\n**Answer: (C)**"
      }
    ],
    "topics": [
      "rates"
    ],
    "difficulty": 2,
    "duplicateOf": null,
    "reviewNote": null
  },
