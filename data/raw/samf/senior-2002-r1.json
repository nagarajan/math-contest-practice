    "type": "mc",
    "prompt": "Consecutive odd numbers are arranged in rows as shown. If the rows are continued in the same pattern, then the middle number of row 51 is",
    "image": "qimages/samf/senior-2002-r1/q11.webp",
    "choices": [
      {
        "key": "A",
        "text": "2601"
      },
      {
        "key": "B",
        "text": "2500"
      },
      {
        "key": "C",
        "text": "2704"
      },
      {
        "key": "D",
        "text": "2809"
      },
      {
        "key": "E",
        "text": "2401"
      }
    ],
    "answer": "A",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Spot the pattern",
        "body": "Row $k$ has $k$ numbers, so rows $1,\\ldots,k-1$ contain $\\frac{k(k-1)}2$ odd numbers. The middle numbers of rows 1, 3, 5 are $1,9,25=1^2,3^2,5^2$. In general the middle of odd row $k$ is $k^2$: row 51 has middle $51^2=2601$.\n\nCheck: the first number of row $k$ is the $\\left(\\frac{k(k-1)}2+1\\right)$-th odd number, $k(k-1)+1$; the middle is $\\frac{k-1}2$ places later: $k(k-1)+1+(k-1)=k^2$.\n\n**Answer: (A) 2601**"
      }
    ],
    "topics": [
      "patterns"
    ],
    "difficulty": 2,
    "duplicateOf": null,
    "reviewNote": null
  },
