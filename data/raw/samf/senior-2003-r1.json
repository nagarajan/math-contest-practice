  "points": 5,
  "timeMinutes": null,
  "type": "mc",
  "prompt": "Given $q=3\\sqrt3$, $r=1+2\\sqrt3$, $s=3+\\sqrt3$, which of the following is true?",
  "image": null,
  "choices": [
   {
    "key": "A",
    "text": "$q>r>s$"
   },
   {
    "key": "B",
    "text": "$q>s>r$"
   },
   {
    "key": "C",
    "text": "$r>q>s$"
   },
   {
    "key": "D",
    "text": "$s>q>r$"
   },
   {
    "key": "E",
    "text": "$s>r>q$"
   }
  ],
  "answer": "B",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Numerical estimates",
    "body": "Using $\\sqrt3\\approx1.73$: $q\\approx5.20$, $r\\approx4.46$, $s\\approx4.73$. So $q>s>r$.\n\n**Answer: (B)**"
   },
   {
    "title": "Exact comparison",
    "body": "Since $\\sqrt3<2$: $q-s=2\\sqrt3-3>0$ because $2\\sqrt3=\\sqrt{12}>3$. And $s-r=2-\\sqrt3>0$. So $q>s>r$.\n\n**Answer: (B)**"
   }
  ],
  "topics": [
   "algebra",
   "inequalities"
  ],
  "difficulty": 2,
  "duplicateOf": null,
  "reviewNote": null
 },
 {
  "id": "samf-senior-2003-r1-09",
  "bank": "samf",
  "source": {
   "contest": "South African Mathematics Olympiad",
