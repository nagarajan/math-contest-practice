  "grade": "10-12",
  "points": 5,
  "timeMinutes": null,
  "type": "mc",
  "prompt": "Sophie runs the Comrades Marathon every second year. When she has run her seventh Comrades, the sum of all the years in which she has run is 13951. In which year did she run her first Comrades?",
  "image": null,
  "choices": [
   {
    "key": "A",
    "text": "$1978$"
   },
   {
    "key": "B",
    "text": "$1982$"
   },
   {
    "key": "C",
    "text": "$1985$"
   },
   {
    "key": "D",
    "text": "$1987$"
   },
   {
    "key": "E",
    "text": "$1991$"
   }
  ],
  "answer": "D",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Arithmetic progression",
    "body": "If the first year is $y$, the years are $y,y+2,\\dots,y+12$ with sum $7y+42=13951$. So $y=(13951-42)/7=13909/7=1987$.\n\n**Answer: (D) 1987**"
   },
   {
    "title": "Middle term",
    "body": "The average of seven equally spaced years is the fourth year: $13951/7=1993$. The first year is $3$ steps of $2$ earlier: $1993-6=1987$.\n\n**Answer: (D) 1987**"
   }
  ],
  "topics": [
   "algebra",
   "sequences-series"
  ],
  "difficulty": 1,
  "duplicateOf": null,
  "reviewNote": null
 },
 {
