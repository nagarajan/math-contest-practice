  "grade": "10-12",
  "points": 5,
  "timeMinutes": null,
  "type": "mc",
  "prompt": "Determine the smallest positive value of the integer $k$ such that $k^3+2k^2$ is the square of an odd integer.",
  "image": null,
  "choices": [
   {
    "key": "A",
    "text": "$2$"
   },
   {
    "key": "B",
    "text": "$14$"
   },
   {
    "key": "C",
    "text": "$23$"
   },
   {
    "key": "D",
    "text": "$1$"
   },
   {
    "key": "E",
    "text": "$7$"
   }
  ],
  "answer": "E",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Factor",
    "body": "$k^3+2k^2=k^2(k+2)$. For this to be an odd square, $k$ must be odd and $k+2$ must be an odd perfect square. The odd squares are $1,9,25,\\dots$; $k+2=1$ gives $k=-1$ (not positive), $k+2=9$ gives $k=7$. Check: $343+98=441=21^2$.\n\n**Answer: (E) 7**"
   }
  ],
  "topics": [
   "number-theory",
