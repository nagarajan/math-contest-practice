    "text": "$E>0$"
   },
   {
    "key": "B",
    "text": "$450<E<750$"
   },
   {
    "key": "C",
    "text": "$0<E<750$"
   },
   {
    "key": "D",
    "text": "$0<E<450$"
   },
   {
    "key": "E",
    "text": "$E>750$"
   }
  ],
  "answer": "E",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Solve the inequality",
    "body": "We need $60+0.2E<0.3E-15$, i.e. $75<0.1E$, so $E>750$.\n\n**Answer: (E) $E>750$**"
   }
  ],
