  "type": "mc",
  "prompt": "Given that $n!=n\\times(n-1)\\times\\cdots\\times2\\times1$ (e.g. $4!=4\\times3\\times2\\times1=24$), which one of the following numbers is the largest?",
  "image": null,
  "choices": [
   {
    "key": "A",
    "text": "$(70!)(30!)$"
   },
   {
    "key": "B",
    "text": "$(50!)(50!)$"
   },
   {
    "key": "C",
    "text": "$(40!)(60!)$"
   },
   {
    "key": "D",
    "text": "$(80!)(20!)$"
   },
   {
    "key": "E",
    "text": "$100!$"
   }
  ],
  "answer": "E",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Compare the factors",
    "body": "Each expression is a product of $100$ factors. Take $(70!)(30!)$: $100!=70!\\cdot(71\\cdot72\\cdots100)$, and $30!=1\\cdot2\\cdots30$ is smaller than $71\\cdots100$ factor by factor. The same argument works for the others ($100!=a!\\cdot(a+1)\\cdots100$ while $(100-a)!<(a+1)\\cdots100$ when $a\\ge50$). So $100!$ is the largest.\n\n**Answer: (E) $100!$**"
   }
  ],
  "topics": [
   "number-theory",
   "counting"
  ],
  "difficulty": 2,
  "duplicateOf": null,
  "reviewNote": null
 },
 {
