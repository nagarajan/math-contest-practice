  },
  "grade": "10-12",
  "points": 5,
  "timeMinutes": null,
  "type": "mc",
  "prompt": "When $33333^2+22222$ is written as a single decimal number, the sum of its digits is",
  "image": null,
  "choices": [
   {
    "key": "A",
    "text": "$15$"
   },
   {
    "key": "B",
    "text": "$25$"
   },
   {
    "key": "C",
    "text": "$22$"
   },
   {
    "key": "D",
    "text": "$10$"
   },
   {
    "key": "E",
    "text": "$20$"
   }
  ],
  "answer": "D",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Pattern",
    "body": "$3^2+2=11$, $33^2+22=1111$, $333^2+222=111111$, so with $n$ threes the result is $2n$ ones. For $n=5$ it is $1111111111$ (ten ones), with digit sum $10$.\n\n**Answer: (D) 10**"
   },
   {
    "title": "Proof",
    "body": "Write $33\\ldots3^2+22\\ldots2=\\frac{(10^n-1)^2}{9}+\\frac{2(10^n-1)}{9}=\\frac{(10^n-1)(10^n+1)}{9}=\\frac{10^{2n}-1}{9}$, which is $2n$ ones.\n\n**Answer: (D) 10**"
   }
  ],
  "topics": [
   "number-theory",
   "arithmetic"
  ],
  "difficulty": 2,
