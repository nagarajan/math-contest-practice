  "timeMinutes": null,
  "type": "mc",
  "prompt": "If $\\sqrt{\\dfrac{(4+\\sqrt{x+3})^2}{6}+3}=3$, then $x$ is equal to",
  "image": null,
  "choices": [
   {
    "key": "A",
    "text": "$22$"
   },
   {
    "key": "B",
    "text": "$6$"
   },
   {
    "key": "C",
    "text": "$3$"
   },
   {
    "key": "D",
    "text": "$1$"
   },
   {
    "key": "E",
    "text": "$5$"
   }
  ],
  "answer": "D",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Square and solve",
    "body": "Squaring: $\\frac{(4+\\sqrt{x+3})^2}{6}+3=9$, so $(4+\\sqrt{x+3})^2=36$ and $4+\\sqrt{x+3}=\\pm6$. Since a square root is non-negative, $\\sqrt{x+3}=2$, so $x+3=4$ and $x=1$.\n\n**Answer: (D) 1**"
   },
   {
    "title": "Check",
    "body": "$x=1$: $\\sqrt{x+3}=2$, $(4+2)^2/6=6$, $\\sqrt{6+3}=3$. It works, and the solution is unique by the above.\n\n**Answer: (D) 1**"
   }
  ],
  "topics": [
   "algebra"
  ],
  "difficulty": 2,
  "duplicateOf": null,
  "reviewNote": null
 },
 {
