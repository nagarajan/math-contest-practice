 {
  "id": "samf-senior-2003-r1-07",
  "bank": "samf",
  "source": {
   "contest": "South African Mathematics Olympiad",
   "paper": "2003 Senior Round 1",
   "year": 2003,
   "number": 7,
   "url": "https://www.samf.ac.za/content/files/QuestionPapers/s1q2003.pdf"
  },
  "grade": "10-12",
  "points": 5,
  "timeMinutes": null,
  "type": "mc",
  "prompt": "After five games, a rugby team has an average of 28 points per game. In order to increase their average by 2 points, how many points must they score in the sixth game?",
  "image": null,
  "choices": [
   {
    "key": "A",
    "text": "$2$"
   },
   {
    "key": "B",
    "text": "$12$"
   },
   {
    "key": "C",
    "text": "$56$"
   },
   {
    "key": "D",
    "text": "$30$"
   },
   {
    "key": "E",
    "text": "$40$"
   }
  ],
  "answer": "E",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Totals",
    "body": "After five games the total is $5\\times28=140$. For an average of $30$ after six games the total must be $180$, so they need $180-140=40$ points.\n\n**Answer: (E) 40**"
   },
   {
    "title": "Surplus method",
    "body": "Each of the 5 earlier games must be 'topped up' by 2 points to reach the new average: $5\\times2=10$. The new game must score the new average plus this: $30+10=40$.\n\n**Answer: (E) 40**"
   }
  ],
  "topics": [
   "arithmetic",
   "statistics"
  ],
  "difficulty": 1,
  "duplicateOf": null,
  "reviewNote": null
 },
 {
  "id": "samf-senior-2003-r1-08",
  "bank": "samf",
  "source": {
   "contest": "South African Mathematics Olympiad",
