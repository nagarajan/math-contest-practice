  },
  "grade": "10-12",
  "points": 5,
  "timeMinutes": null,
  "type": "mc",
  "prompt": "In the sequence $\\ldots,k,m,n,p,0,1,1,2,3,5,8,\\ldots$ each term is the sum of the two terms on its left. The value of $k$ is",
  "image": null,
  "choices": [
   {
    "key": "A",
    "text": "$-2$"
   },
   {
    "key": "B",
    "text": "$3$"
   },
   {
    "key": "C",
    "text": "$-3$"
   },
   {
    "key": "D",
    "text": "$2$"
   },
   {
    "key": "E",
    "text": "$-1$"
   }
  ],
  "answer": "C",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Work backwards",
    "body": "Each term to the left is a difference: $p+0=1$ gives $p=1$; $n+p=0$ gives $n=-1$; $m+n=p$ gives $m=2$; $k+m=n$ gives $k=-3$.\n\n**Answer: (C) $-3$**"
   }
  ],
  "topics": [
   "sequences-series",
   "patterns"
  ],
  "difficulty": 1,
  "duplicateOf": null,
  "reviewNote": null
 },
