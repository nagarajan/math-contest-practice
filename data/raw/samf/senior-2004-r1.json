  "type": "mc",
  "prompt": "For how many integer values of $n$ is $\\dfrac{n+3}{n-1}$ an integer?",
  "image": null,
  "choices": [
   {
    "key": "A",
    "text": "$7$"
   },
   {
    "key": "B",
    "text": "$6$"
   },
   {
    "key": "C",
    "text": "$5$"
   },
   {
    "key": "D",
    "text": "$2$"
   },
   {
    "key": "E",
    "text": "$8$"
   }
  ],
  "answer": "B",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Split the fraction",
    "body": "$\\frac{n+3}{n-1}=1+\\frac4{n-1}$, so $n-1$ must be a divisor of $4$: $\\pm1,\\pm2,\\pm4$. That gives six values of $n$: $2,0,3,-1,5,-3$.\n\n**Answer: (B) 6**"
   }
  ],
  "topics": [
   "number-theory"
  ],
  "difficulty": 2,
  "duplicateOf": null,
  "reviewNote": null
 },
 {
