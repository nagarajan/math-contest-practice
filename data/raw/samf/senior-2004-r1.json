  "type": "mc",
  "prompt": "In the diagram $ABCD$ is a rectangle with $AB=\\sqrt3$ and $BC=1$. $AFED$ and $FBGH$ are squares. The length of $HE$ is",
  "image": "qimages/samf/senior-2004-r1/q11.webp",
  "choices": [
   {
    "key": "A",
    "text": "$2-\\sqrt3$"
   },
   {
    "key": "B",
    "text": "$2\\sqrt3-3$"
   },
   {
    "key": "C",
    "text": "$\\frac{\\sqrt3}{6}$"
   },
   {
    "key": "D",
    "text": "$7\\sqrt3-12$"
   },
   {
    "key": "E",
    "text": "$\\sqrt3+2$"
   }
  ],
  "answer": "A",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Subtract lengths",
    "body": "$AF=AD=1$, so $BF=BG=\\sqrt3-1$. $HE=GC=BC-BG=1-(\\sqrt3-1)=2-\\sqrt3$.\n\n**Answer: (A) $2-\\sqrt3$**"
   }
  ],
  "topics": [
   "geometry"
  ],
  "difficulty": 1,
