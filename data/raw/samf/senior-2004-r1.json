  "points": 5,
  "timeMinutes": null,
  "type": "mc",
  "prompt": "$ABCD$ is a parallelogram. $F$ is the midpoint of $AD$ and $N$ is the midpoint of $AB$. The ratio of the area of $\\triangle AFN$ to the area of quadrilateral $FNCD$ is",
  "image": "qimages/samf/senior-2004-r1/q14.webp",
  "choices": [
   {
    "key": "A",
    "text": "$\\frac27$"
   },
   {
    "key": "B",
    "text": "$\\frac16$"
   },
   {
    "key": "C",
    "text": "$\\frac15$"
   },
   {
    "key": "D",
    "text": "$\\frac14$"
   },
   {
    "key": "E",
    "text": "$\\frac13$"
   }
  ],
  "answer": "C",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Compare areas",
    "body": "Let $AB=b$ and the height be $h$; the area of $ABCD$ is $bh$. Triangle $AFN$ has area $\\frac12\\cdot\\frac b2\\cdot\\frac h2=\\frac18bh$. Triangle $NBC$ has area $\\frac12\\cdot\\frac b2\\cdot h=\\frac14bh$. So $FNCD=bh-\\frac18bh-\\frac14bh=\\frac58bh$ and the ratio is $\\frac{1/8}{5/8}=\\frac15$.\n\n**Answer: (C) $\\frac15$**"
   }
  ],
  "topics": [
   "geometry"
  ],
  "difficulty": 2,
  "duplicateOf": null,
  "reviewNote": null
 },
