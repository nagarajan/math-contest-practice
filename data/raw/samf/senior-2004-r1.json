    "text": "$16$"
   },
   {
    "key": "B",
    "text": "$8$"
   },
   {
    "key": "C",
    "text": "$4\\sqrt2$"
   },
   {
    "key": "D",
    "text": "$12$"
   },
   {
    "key": "E",
    "text": "$4\\pi$"
   }
  ],
  "answer": "A",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Radii",
    "body": "The small square has side $2$, which is two radii, so the radius is $1$. The large square has side equal to four radii, $4$, hence area $16$.\n\n**Answer: (A) 16**"
   }
  ],
