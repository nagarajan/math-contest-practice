   }
  ],
  "answer": "B",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Square it",
    "body": "Let $p=\\sqrt{2+\\sqrt3}$, $q=\\sqrt{2-\\sqrt3}$. Then $pq=\\sqrt{4-3}=1$ and $(p-q)^2=p^2+q^2-2pq=4-2=2$. Since $p>q$, $p-q=\\sqrt2$.\n\n**Answer: (B) $\\sqrt2$**"
   }
  ],
