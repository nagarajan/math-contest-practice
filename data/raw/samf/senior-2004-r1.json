  "type": "mc",
  "prompt": "$1-\\dfrac{1-\\dfrac{1/2}{1+1/2}}{1+\\dfrac{1+1/2}{1-1/2}}$ equals",
  "image": null,
  "choices": [
   {
    "key": "A",
    "text": "$\\frac79$"
   },
   {
    "key": "B",
    "text": "$\\frac56$"
   },
   {
    "key": "C",
    "text": "$\\frac12$"
   },
   {
    "key": "D",
    "text": "$\\frac13$"
   },
   {
    "key": "E",
    "text": "$\\frac34$"
   }
  ],
  "answer": "B",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Simplify step by step",
    "body": "$\\frac{1/2}{3/2}=\\frac13$, so the numerator is $1-\\frac13=\\frac23$. $\\frac{3/2}{1/2}=3$, so the denominator is $1+3=4$. Then $1-\\frac{2/3}{4}=1-\\frac16=\\frac56$.\n\n**Answer: (B) $\\frac56$**"
   }
  ],
  "topics": [
   "fractions-decimals",
   "arithmetic"
  ],
