  "grade": "10-12",
  "points": 5,
  "timeMinutes": null,
  "type": "mc",
  "prompt": "The number of prime numbers $p$ such that $p+1$ is a square is",
  "image": null,
  "choices": [
   {
    "key": "A",
    "text": "$1$"
   },
   {
    "key": "B",
    "text": "$0$"
   },
   {
    "key": "C",
    "text": "$4$"
   },
   {
    "key": "D",
    "text": "$3$"
   },
   {
    "key": "E",
    "text": "infinite"
   }
  ],
  "answer": "A",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Factorise",
    "body": "If $p+1=k^2$ then $p=(k-1)(k+1)$. A prime has only the factors $1$ and $p$, so $k-1=1$, $k=2$, $p=3$. This is the only one.\n\n**Answer: (A) 1**"
   }
  ],
  "topics": [
   "number-theory"
  ],
  "difficulty": 2,
