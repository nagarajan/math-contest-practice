  "type": "mc",
  "prompt": "Ann is three times as old as Carol will be next year. In 12 years' time Betty will be three times as old as Ann is now, and she is now eight times as old as Carol is. Betty's age is now",
  "image": null,
  "choices": [
   {
    "key": "A",
    "text": "$12$"
   },
   {
    "key": "B",
    "text": "$9$"
   },
   {
    "key": "C",
    "text": "$24$"
   },
   {
    "key": "D",
    "text": "$18$"
   },
   {
    "key": "E",
    "text": "$20$"
   }
  ],
  "answer": "C",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Equations",
    "body": "Let the present ages be $A,B,C$: $A=3(C+1)$, $B+12=3A$, $B=8C$. Then $8C+12=9(C+1)$, so $C=3$, $A=12$, $B=24$.\n\n**Answer: (C) 24**"
   }
  ],
