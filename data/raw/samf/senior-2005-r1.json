  "type": "mc",
  "prompt": "The number 2005 is made up of exactly two zeros and two other digits whose sum is 7. The number of 4-digit numbers with these properties is",
  "image": null,
  "choices": [
   {
    "key": "A",
    "text": "$9$"
   },
   {
    "key": "B",
    "text": "$11$"
   },
   {
    "key": "C",
    "text": "$24$"
   },
   {
    "key": "D",
    "text": "$6$"
   },
   {
    "key": "E",
    "text": "$18$"
   }
  ],
  "answer": "E",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Count",
    "body": "The two non-zero digits, in order, form one of $6$ ordered pairs with sum $7$: $(1,6),(2,5),(3,4),(4,3),(5,2),(6,1)$. The zeros can then be placed in $3$ ways, since the first digit must be non-zero: $ab00$, $a0b0$, $a00b$. Total $6\\times3=18$.\n\n**Answer: (E) 18**"
   }
  ],
  "topics": [
   "counting"
  ],
  "difficulty": 2,
  "duplicateOf": null,
