    "key": "A",
    "text": "$24$"
   },
   {
    "key": "B",
    "text": "$4$"
   },
   {
    "key": "C",
    "text": "$48$"
   },
   {
    "key": "D",
    "text": "$15$"
   },
   {
    "key": "E",
    "text": "$12$"
   }
  ],
  "answer": "A",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Express x and y",
    "body": "$x=\\frac h{12}$, $y=\\frac h8$, so $x+y=h\\left(\\frac1{12}+\\frac18\\right)=\\frac{5h}{24}=5$ and $h=24$.\n\n**Answer: (A) 24**"
   }
  ],
  "topics": [
