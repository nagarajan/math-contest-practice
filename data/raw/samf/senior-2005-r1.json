   }
  ],
  "answer": "C",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Name the areas",
    "body": "The six triangles are $APQ,APR,APS,AQR,AQS,ARS$. Let $[APQ]=x$ and $[ARS]=y$. $AQR$ is the smallest, area $1$, and $APS$ the largest, of area $4$: $x+1+y=4$, so $x+y=3$. The areas are $x,\\ x+1,\\ 4,\\ 1,\\ 1+y,\\ y$, with sum $3(x+y)+4=13$. The average is $\\frac{13}6$.\n\n**Answer: (C) $\\frac{13}6$**"
   }
