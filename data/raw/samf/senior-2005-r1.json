 {
  "id": "samf-senior-2005-r1-09",
  "bank": "samf",
  "source": {
   "contest": "South African Mathematics Olympiad",
   "paper": "2005 Senior Round 1",
   "year": 2005,
   "number": 9,
   "url": "https://www.samf.ac.za/content/files/QuestionPapers/s1q2005.pdf"
  },
  "grade": "10-12",
  "points": 5,
  "timeMinutes": null,
  "type": "mc",
  "prompt": "If $0<x<y<1$, which one of the following is not necessarily true?",
  "image": null,
  "choices": [
   {
    "key": "A",
    "text": "$(x-y)^2<x^2$"
   },
   {
    "key": "B",
    "text": "$(x-y)^2<y^2$"
   },
   {
    "key": "C",
    "text": "$x^2<2y^2$"
   },
   {
    "key": "D",
    "text": "$x^3-y^3<x^2$"
   },
   {
    "key": "E",
    "text": "$y^3-x^3<y^3$"
   }
  ],
  "answer": "A",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Counterexample",
    "body": "Take $x=0.1$, $y=0.9$: $(x-y)^2=0.64>x^2=0.01$, so (A) fails. The others always hold: $0<y-x<y$ gives (B); $x<y$ gives (C); $x^3-y^3<0<x^2$ gives (D); $y^3-x^3<y^3$ since $x^3>0$ gives (E).\n\n**Answer: (A)**"
   }
  ],
  "topics": [
   "inequalities",
   "algebra"
  ],
  "difficulty": 2,
  "duplicateOf": null,
  "reviewNote": null
 },
