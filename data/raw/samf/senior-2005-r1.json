    "text": "$50^\\circ$"
   },
   {
    "key": "C",
    "text": "$60^\\circ$"
   },
   {
    "key": "D",
    "text": "$75^\\circ$"
   },
   {
    "key": "E",
    "text": "$80^\\circ$"
   }
  ],
  "answer": "D",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Angle chase",
    "body": "$\\angle AFE=180^\\circ-120^\\circ=60^\\circ$. $AC$ is a diagonal of the square, so $\\angle FAE=45^\\circ$. In triangle $AEF$: $\\angle AEF=180^\\circ-60^\\circ-45^\\circ=75^\\circ$.\n\n**Answer: (D) $75^\\circ$**"
   }
  ],
