  "grade": "10-12",
  "points": 5,
  "timeMinutes": null,
  "type": "mc",
  "prompt": "The digits of the numbers from 20 to 59 inclusive are typed in one long line. Below that the digits of the numbers from 21 to 60 are typed:\n\n$$\\begin{array}{l}202122232425\\cdots59\\\\212223242526\\cdots60\\end{array}$$\n\nThe number of times that a digit on the top line has the same digit directly below it is",
  "image": null,
  "choices": [
   {
    "key": "A",
    "text": "$44$"
   },
   {
    "key": "B",
    "text": "$36$"
   },
   {
    "key": "C",
    "text": "$54$"
   },
   {
    "key": "D",
    "text": "$32$"
   },
   {
    "key": "E",
    "text": "$40$"
   }
  ],
  "answer": "B",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Pairs of numbers",
    "body": "Each number $n$ in the top line sits above $n+1$ in the bottom line. For $n$ from $20$ to $29$ the units digits differ, and the tens digits agree for $n=20,\\dots,28$ (nine of the ten; $29$ and $30$ differ). The same holds for each of the four groups of ten, so the total is $9\\times4=36$.\n\n**Answer: (B) 36**"
   }
  ],
  "topics": [
   "counting",
   "patterns"
  ],
  "difficulty": 2,
  "duplicateOf": null,
  "reviewNote": null
 },
 {
