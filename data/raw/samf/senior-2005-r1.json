  "type": "mc",
  "prompt": "Adam and Brian find a jumble of $n$ ropes lying on the floor. Each takes hold of one loose end. The probability that they are both holding the same rope is",
  "image": null,
  "choices": [
   {
    "key": "A",
    "text": "$\\frac1{n-1}$"
   },
   {
    "key": "B",
    "text": "$\\frac1{2n-1}$"
   },
   {
    "key": "C",
    "text": "$\\frac1n$"
   },
   {
    "key": "D",
    "text": "$\\frac1{2n}$"
   },
   {
    "key": "E",
    "text": "$\\frac{2n-1}{2n}$"
   }
  ],
  "answer": "B",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Count ends",
    "body": "There are $2n$ ends. Adam picks one; this leaves $2n-1$ ends for Brian, exactly one of which belongs to the same rope. The probability is $\\frac1{2n-1}$.\n\n**Answer: (B) $\\frac1{2n-1}$**"
   }
  ],
  "topics": [
   "probability"
  ],
  "difficulty": 2,
  "duplicateOf": null,
