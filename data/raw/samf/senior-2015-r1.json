    "answerUnit": null,
    "solutions": [
      {
        "title": "Find the triple",
        "body": "Let the numbers be $x<y<z$. If $x\\ge2$ then $y\\ge3$, $z\\ge4$ and the sum is at least $9$, too big. So $x=1$ and $y+z=6$ with $2\\le y<z$, giving only $y=2,z=4$. The product is $1\\times2\\times4=8$.\n\n**Answer: (D) 8**"
      },
      {
        "title": "List the partitions",
        "body": "The partitions of $7$ into three different positive integers: $1+2+4$ only (since $1+3+3$ and $2+2+3$ repeat a number). Product $8$.\n\n**Answer: (D) 8**"
      }
    ],
