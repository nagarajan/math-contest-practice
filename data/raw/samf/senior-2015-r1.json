    "answerUnit": null,
    "solutions": [
      {
        "title": "Expand and factorise",
        "body": "$x^2+5x-84=-48$, so $x^2+5x-36=0$, i.e. $(x+9)(x-4)=0$. Hence $x=4$ or $x=-9$.\n\n**Answer: (C)**"
      },
      {
        "title": "Check the options",
        "body": "For $x=4$: $(-3)(16)=-48$. For $x=-9$: $(-16)(3)=-48$. Both work and no other option contains two roots.\n\n**Answer: (C)**"
      }
