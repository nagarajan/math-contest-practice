    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Gold balance",
        "body": "The mixture has $0.5$ g of gold. Adding $x$ g gives $\\dfrac{0.5+x}{5+x}=0.2$, so $0.5+x=1+0.2x$, $0.8x=0.5$ and $x=0.625$.\n\n**Answer: (E) 0.625**"
      },
      {
        "title": "Other metal stays the same",
        "body": "The other metal is $4.5$ g, and it must become $80\\%$ of the new total, so the total is $4.5/0.8=5.625$ g and $5.625-5=0.625$ g of gold was added.\n\n**Answer: (E) 0.625**"
      }
