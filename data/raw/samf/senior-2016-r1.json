    "type": "mc",
    "prompt": "If $169!=1\\times2\\times3\\times\\cdots\\times169$ is written as the product of prime numbers, how many times would 13 appear as a factor?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "12"
      },
      {
        "key": "B",
        "text": "13"
      },
      {
        "key": "C",
        "text": "14"
      },
      {
        "key": "D",
        "text": "15"
      },
      {
        "key": "E",
        "text": "16"
      }
    ],
    "answer": "C",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Legendre's formula",
        "body": "The exponent of $13$ in $169!$ is $\\lfloor169/13\\rfloor+\\lfloor169/169\\rfloor=13+1=14$.\n\n**Answer: (C) 14**"
      },
      {
        "title": "Count multiples",
        "body": "The multiples of $13$ up to $169$ are $13,26,\\dots,169$: that is $13$ numbers, each contributing one factor $13$, and $169=13^2$ contributes one extra. Total $14$.\n\n**Answer: (C) 14**"
      }
    ],
