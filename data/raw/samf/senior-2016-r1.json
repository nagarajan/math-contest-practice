    "type": "mc",
    "prompt": "Which term must be removed from the sequence $\\frac12,\\frac14,\\frac16,\\frac1{10}$ and $\\frac1{12}$ so that the sum of the remaining terms is equal to 1?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "$\\frac12$"
      },
      {
        "key": "B",
        "text": "$\\frac14$"
      },
      {
        "key": "C",
        "text": "$\\frac16$"
      },
      {
        "key": "D",
        "text": "$\\frac1{10}$"
      },
      {
        "key": "E",
        "text": "$\\frac1{12}$"
      }
    ],
    "answer": "D",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Common denominator 60",
        "body": "$\\frac12+\\frac14+\\frac16+\\frac1{10}+\\frac1{12}=\\frac{30+15+10+6+5}{60}=\\frac{66}{60}=1+\\frac1{10}$. The excess over $1$ is $\\frac1{10}$, which is one of the terms: remove it.\n\n**Answer: (D) $\\frac1{10}$**"
      }
    ],
    "topics": [
      "fractions-decimals"
    ],
