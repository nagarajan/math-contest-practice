    "type": "mc",
    "prompt": "Mrs. Habana turns 45 years old in 2016 and her son 17. In which year will Mrs. Habana turn double her son's age?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "2033"
      },
      {
        "key": "B",
        "text": "2044"
      },
      {
        "key": "C",
        "text": "2031"
      },
      {
        "key": "D",
        "text": "2040"
      },
      {
        "key": "E",
        "text": "2027"
      }
    ],
    "answer": "E",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Equation",
        "body": "After $x$ years: $45+x=2(17+x)$, so $x=11$ and the year is $2016+11=2027$.\n\n**Answer: (E) 2027**"
      },
      {
        "title": "Age difference",
        "body": "The age difference stays $45-17=28$ years. She is double his age exactly when he is $28$. He is $17$ now, so this happens in $11$ years: $2027$.\n\n**Answer: (E) 2027**"
      }
    ],
    "topics": [
      "algebra",
      "arithmetic"
    ],
    "difficulty": 1,
