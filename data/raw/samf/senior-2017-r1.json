    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Trapezium",
        "body": "Let $T$ be the foot of the perpendicular from $A$ to $YH$ and $G$ the foot from $P$. Then $GT=PA=12$, $YG=18-12=6$, and $PG=\\sqrt{10^2-6^2}=8=AT$. Also $TH=\\sqrt{17^2-8^2}=15$, so $YH=18+15=33$. Area $=\\frac12(12+33)\\cdot8=180$.\n\n**Answer: (B) 180**"
      }
