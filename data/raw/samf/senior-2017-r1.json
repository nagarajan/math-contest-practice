    "type": "mc",
    "prompt": "Which number from the set $\\{-2;-1;0;1;2\\}$ is the smallest value of $n$ for which $3^n\\cdot3^3$ is a perfect square?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "$-2$"
      },
      {
        "key": "B",
        "text": "$-1$"
      },
      {
        "key": "C",
        "text": "0"
      },
      {
        "key": "D",
        "text": "1"
      },
      {
        "key": "E",
        "text": "2"
      }
    ],
    "answer": "B",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Add exponents",
        "body": "$3^n\\cdot3^3=3^{n+3}$, a perfect square exactly when $n+3$ is even. Among $-2,-1,0,1,2$ the odd values of $n$ are $-1$ and $1$; the smallest is $-1$ (check: $3^2=9$).\n\n**Answer: (B) $-1$**"
      }
    ],
    "topics": [
      "number-theory",
      "algebra"
    ],
    "difficulty": 1,
