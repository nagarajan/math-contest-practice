    "timeMinutes": null,
    "type": "mc",
    "prompt": "The length of each side of a triangle is a different even integer. If the triangle has non-zero area, what is the minimum perimeter that it can have?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "14"
      },
      {
        "key": "B",
        "text": "16"
      },
      {
        "key": "C",
        "text": "18"
      },
      {
        "key": "D",
        "text": "20"
      },
      {
        "key": "E",
        "text": "22"
      }
    ],
    "answer": "C",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Triangle inequality",
        "body": "Let the sides be even integers $a<b<c$ with $c<a+b$. If $a=2$ then $c<b+2$, so $c=b+1$, which is odd: impossible. So $a\\ge4$, $b\\ge6$, $c\\ge8$, and $4,6,8$ is a triangle ($4+6>8$). The minimum perimeter is $18$.\n\n**Answer: (C) 18**"
      }
    ],
    "topics": [
      "geometry",
      "number-theory"
    ],
    "difficulty": 2,
    "duplicateOf": null,
    "reviewNote": null
  },
