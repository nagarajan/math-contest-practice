        "text": "3"
      }
    ],
    "answer": "C",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Eliminate a",
        "body": "Subtract $3\\times$(first) from the second: $-b-2c=-30$. Subtract $5\\times$(first) from the third: $-2b-3c=-51$. So $b+2c=30$ and $2b+3c=51$. Subtract twice the first from the second: $-c=-9$, so $c=9$.\n\n**Answer: (C) 9**"
      }
