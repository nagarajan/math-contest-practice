    "type": "mc",
    "prompt": "In a list of six consecutive positive integers the sum of the three smallest numbers is $N$ and the sum of the three largest numbers is $M$. Which one of the following is true?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "$N=M+9$"
      },
      {
        "key": "B",
        "text": "$M=N+9$"
      },
      {
        "key": "C",
        "text": "$M+N=9$"
      },
      {
        "key": "D",
        "text": "$3M+3N=9$"
      },
      {
        "key": "E",
        "text": "$3M-3N=12$"
      }
    ],
    "answer": "B",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Shift by 3",
        "body": "Each of the three largest numbers is $3$ more than the corresponding one of the three smallest, so $M=N+3\\cdot3=N+9$.\n\n**Answer: (B)**"
      }
    ],
    "topics": [
      "algebra"
    ],
