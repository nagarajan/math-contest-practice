    "prompt": "A container has a mass of 36 kg when it is a quarter full and when it is one-third full it has a mass of 40 kg. What is the mass of the empty container in kg?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "24"
      },
      {
        "key": "B",
        "text": "36"
      },
      {
        "key": "C",
        "text": "48"
      },
      {
        "key": "D",
        "text": "18"
      },
      {
        "key": "E",
        "text": "20"
      }
    ],
    "answer": "A",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Two equations",
        "body": "Let the container have mass $x$ and the contents when full $y$. Then $x+\\frac y4=36$ and $x+\\frac y3=40$. Subtracting: $\\frac y{12}=4$, $y=48$, so $x=36-12=24$.\n\n**Answer: (A) 24**"
      }
    ],
