        "text": "1"
      },
      {
        "key": "D",
        "text": "2"
      },
      {
        "key": "E",
        "text": "3"
      }
    ],
    "answer": "C",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Evaluate",
        "body": "$4<\\sqrt{23}<5$, so $\\lceil\\sqrt{23}\\rceil=5$. $-4<-3.2<-3$, so $\\lfloor-3.2\\rfloor=-4$. The sum is $1$.\n\n**Answer: (C) 1**"
      }
