    "timeMinutes": null,
    "type": "mc",
    "prompt": "A straight line passes through the points $(2;3)$ and $(4;7)$. Which one of the following points is also on the line?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "$(3;5)$"
      },
      {
        "key": "B",
        "text": "$(1;2)$"
      },
      {
        "key": "C",
        "text": "$(4;5)$"
      },
      {
        "key": "D",
        "text": "$(0;2)$"
      },
      {
        "key": "E",
        "text": "$(2;4)$"
      }
    ],
    "answer": "A",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Equation of the line",
        "body": "The gradient is $\\frac{7-3}{4-2}=2$, so $y-3=2(x-2)$, i.e. $y=2x-1$. Only $(3;5)$ satisfies it.\n\n**Answer: (A) $(3;5)$**"
      },
      {
        "title": "Midpoint",
        "body": "$(3;5)$ is the midpoint of $(2;3)$ and $(4;7)$, so it lies on the line through them. The other options are not on the line $y=2x-1$.\n\n**Answer: (A)**"
      }
    ],
    "topics": [
      "algebra",
      "geometry"
    ],
    "difficulty": 1,
    "duplicateOf": null,
    "reviewNote": null
  },
  {
