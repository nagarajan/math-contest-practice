      }
    ],
    "answer": "A",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Difference of squares",
        "body": "$1009^2-1008^2=(1009-1008)(1009+1008)=1\\times2017=2017$.\n\n**Answer: (A) 2017**"
      }
    ],
