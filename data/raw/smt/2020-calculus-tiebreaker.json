    "prompt": "Compute\n$$\\int_1^2\\frac{x-1}{x^2\\ln x+x}\\,dx.$$",
    "image": null,
    "choices": null,
    "answer": "ln(1/2+ln(2))",
    "acceptedAnswers": null,
