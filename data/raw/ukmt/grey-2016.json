    "wrongPoints": null,
    "timeMinutes": null,
    "type": "mc",
    "prompt": "A train has five carriages, each containing at least one passenger. Two passengers are said to be 'neighbours' if either they are in the same carriage or they are in adjacent carriages. Each passenger has exactly five or exactly ten neighbours. How many passengers are there on the train?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "13"
      },
      {
        "key": "B",
        "text": "15"
      },
      {
        "key": "C",
        "text": "17"
      },
      {
        "key": "D",
        "text": "20"
      },
      {
        "key": "E",
        "text": "There is more than one answer."
      }
    ],
    "answer": "C",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Neighbour counts",
        "body": "Let carriages hold $p,q,r,s,t$ passengers. A passenger in carriage 1 has $p-1+q$ neighbours, which is 5 or 10; in carriage 2, $p+q+r-1$. Since $r\\ge1$ we get $p+q=6$ and $r=5$. By symmetry $s+t=6$. Total $6+5+6=17$.\n\n**Answer: (C) 17**"
      }
    ],
    "topics": [
