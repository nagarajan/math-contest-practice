    "type": "mc",
    "prompt": "Three equilateral triangles are cut from the corners of a large equilateral triangle to form an irregular hexagon, as shown in the diagram. The perimeter of the large equilateral triangle is 60 cm. The perimeter of the irregular hexagon is 40 cm. What is the sum of the perimeters of the triangles that were cut from the large triangle?",
    "image": "qimages/ukmt/grey-2016/q09.webp",
    "choices": [
      {
        "key": "A",
        "text": "60 cm"
      },
      {
        "key": "B",
        "text": "66 cm"
      },
      {
        "key": "C",
        "text": "72 cm"
      },
      {
        "key": "D",
        "text": "75 cm"
      },
      {
        "key": "E",
        "text": "81 cm"
      }
    ],
    "answer": "A",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Compare perimeters",
        "body": "Let the cut-off triangles have sides $x,y,z$. The large triangle has side 20. The hexagon's perimeter is $40=60-(x+y+z)$, so $x+y+z=20$. The three small triangles have total perimeter $3(x+y+z)=60$ cm.\n\n**Answer: (A) 60 cm**"
      }
    ],
    "topics": [
      "geometry"
    ],
    "difficulty": 2,
    "duplicateOf": null,
    "reviewNote": null
  },
