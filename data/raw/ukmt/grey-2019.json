  "wrongPoints": null,
  "timeMinutes": null,
  "type": "mc",
  "prompt": "The expression $2-0-1-9$ contains four digits and three minus signs. What is the largest value that can be obtained by inserting exactly one pair of brackets into the expression?",
  "image": null,
  "choices": [
   {
    "key": "A",
    "text": "13"
   },
   {
    "key": "B",
    "text": "12"
   },
   {
    "key": "C",
    "text": "10"
   },
   {
    "key": "D",
    "text": "9"
   },
   {
    "key": "E",
    "text": "8"
   }
  ],
  "answer": "B",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Only plus and minus signs can appear",
    "body": "Whatever brackets are inserted, the expression becomes $2\\pm0\\pm1\\pm9$ (each of $0,1,9$ is either added or subtracted). The largest conceivable value is $2+0+1+9=12$.\n\nIt is reached: $2-(0-1-9)=2-0+1+9=12$, because the brackets turn the two minus signs after the 0 into plus signs.\n\n**Answer: (B) 12**"
   }
  ],
  "topics": [
   "arithmetic",
   "algebra"
  ],
  "difficulty": 1,
  "duplicateOf": null,
  "reviewNote": null
 },
 {
