  "type": "mc",
  "prompt": "Kerry writes a list of all the integers from 1 to $n$ on a whiteboard. She uses the digit 0 five times and the digit 9 six times. What is the value of $n$?",
  "image": null,
  "choices": [
   {
    "key": "A",
    "text": "39"
   },
   {
    "key": "B",
    "text": "49"
   },
   {
    "key": "C",
    "text": "59"
   },
   {
    "key": "D",
    "text": "69"
   },
   {
    "key": "E",
    "text": "99"
   }
  ],
  "answer": "C",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Count the zeros, then the nines",
    "body": "Zeros: the numbers 10, 20, 30, 40, 50 each contain one 0, and 60 would give a sixth. So $n<60$.\n\nNines: 9, 19, 29, 39, 49, 59 each contain one 9. To have six nines we need $n\\ge59$.\n\nSo $n=59$, and indeed 0 appears 5 times and 9 appears 6 times.\n\n**Answer: (C) 59**"
   }
  ],
  "topics": [
   "counting",
   "number-theory"
  ],
  "difficulty": 1,
  "duplicateOf": null,
  "reviewNote": null
 },
