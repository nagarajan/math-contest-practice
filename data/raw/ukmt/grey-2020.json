 {
  "id": "ukmt-grey-2020-20",
  "bank": "ukmt",
  "source": {
   "contest": "UKMT Grey Kangaroo",
   "paper": "2020",
   "year": 2020,
   "number": 20,
   "url": "https://ukmt.org.uk/wp-content/uploads/2023/08/KangGrey20.pdf"
  },
  "grade": "8",
  "points": 6,
  "blankPoints": null,
  "wrongPoints": null,
  "timeMinutes": null,
  "type": "mc",
  "prompt": "Harriet writes a positive integer on each edge of a square. She also writes at each vertex the product of the integers on the two edges that meet at that vertex. The sum of the integers at the vertices is 15. What is the sum of the integers on the edges of the square?",
  "image": null,
  "choices": [
   {
    "key": "A",
    "text": "6"
   },
   {
    "key": "B",
    "text": "7"
   },
   {
    "key": "C",
    "text": "8"
   },
   {
    "key": "D",
    "text": "10"
   },
   {
    "key": "E",
    "text": "15"
   }
  ],
  "answer": "C",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Factorise the sum",
    "body": "Let the edge integers be $u,v,w,x$ in order round the square. The vertex numbers are $uv,vw,wx,xu$, with sum $uv+vw+wx+xu=(u+w)(v+x)=15$.\n\nBoth $u+w$ and $v+x$ are at least 2, so $15=3\\times5$ (the factor 1 and the factor 15 are impossible). Hence $\\{u+w,\\;v+x\\}=\\{3,5\\}$ and the sum of all four edge integers is $3+5=8$.\n\n**Answer: (C) 8**"
   }
  ],
  "topics": [
   "algebra",
   "number-theory"
  ],
  "difficulty": 3,
