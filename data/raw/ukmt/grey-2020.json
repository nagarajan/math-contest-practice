  "type": "mc",
  "prompt": "John always walks to and from school at the same speed. When he walks to school along the road and walks back using a short cut across the fields, he walks for 50 minutes. When he uses the short cut both ways, he walks for 30 minutes. How long does it take him when he walks along the road both ways?",
  "image": null,
  "choices": [
   {
    "key": "A",
    "text": "60 minutes"
   },
   {
    "key": "B",
    "text": "65 minutes"
   },
   {
    "key": "C",
    "text": "70 minutes"
   },
   {
    "key": "D",
    "text": "75 minutes"
   },
   {
    "key": "E",
    "text": "80 minutes"
   }
  ],
  "answer": "C",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Find the time for one way",
    "body": "Using the short cut both ways takes 30 minutes, so the short cut one way takes 15 minutes. The road one way plus the short cut one way takes 50 minutes, so the road one way takes $50-15=35$ minutes. The road both ways takes $2\\times35=70$ minutes.\n\n**Answer: (C) 70 minutes**"
   },
   {
    "title": "Use letters",
    "body": "Let the road take $r$ minutes and the short cut $s$ minutes one way. Then $r+s=50$ and $2s=30$, so $s=15$, $r=35$ and $2r=70$.\n\n**Answer: (C) 70 minutes**"
   }
  ],
  "topics": [
   "rates",
   "algebra"
  ],
  "difficulty": 1,
  "duplicateOf": null,
  "reviewNote": null
 },
