    "type": "mc",
    "prompt": "The front number plate of Max's car fell off. He put it back upside down but luckily this didn't make any difference. Which of the following could be Max's number plate?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "04 NSN 40"
      },
      {
        "key": "B",
        "text": "80 BNB 08"
      },
      {
        "key": "C",
        "text": "03 HNH 30"
      },
      {
        "key": "D",
        "text": "08 XBX 80"
      },
      {
        "key": "E",
        "text": "60 HOH 09"
      }
    ],
    "answer": "E",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Rotate each plate by 180 degrees",
        "body": "Turning a plate upside down reverses the order of the symbols and turns each symbol through $180^\\circ$. So the plate must read the same after this, which needs every symbol to look like a symbol after being turned: 0, 8, H, N, O, S, X look the same, and 6 and 9 turn into each other.\n\n- A: the 4 does not look like a 4 upside down.\n- B and D: B is not a symbol that survives being turned upside down.\n- C: the 3 does not survive.\n- E: `60 HOH 09` reversed is `90 HOH 06`, and turning each symbol gives `60 HOH 09`. It works.\n\n**Answer: (E) 60 HOH 09**"
      }
    ],
    "topics": [
      "logic",
      "spatial"
    ],
    "difficulty": 1,
    "duplicateOf": null,
    "reviewNote": null
  },
