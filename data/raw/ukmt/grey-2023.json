    "prompt": "What is the sum of the largest three-digit multiple of 4 and the smallest four-digit multiple of 3?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "1996"
      },
      {
        "key": "B",
        "text": "1997"
      },
      {
        "key": "C",
        "text": "1998"
      },
      {
        "key": "D",
        "text": "1999"
      },
      {
        "key": "E",
        "text": "2000"
      }
    ],
    "answer": "C",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Find both numbers",
        "body": "The largest three-digit multiple of 4: $1000=4\\times250$ has four digits, so take $1000-4=996$. The smallest four-digit multiple of 3: $1000=3\\times333+1$, so the next multiple is $3\\times334=1002$.\n\nSum: $996+1002=1998$.\n\n**Answer: (C) 1998**"
      },
      {
        "title": "Pair them around 1000",
        "body": "$996=1000-4$ and $1002=1000+2$. The extra and missing amounts are $-4$ and $+2$, so the sum is $2000-2=1998$.\n\n**Answer: (C) 1998**"
      }
    ],
    "topics": [
      "arithmetic",
      "number-theory"
    ],
