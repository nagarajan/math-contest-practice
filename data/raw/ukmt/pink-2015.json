    "prompt": "Which of the following is neither a square nor a cube?",
    "image": null,
    "choices": [
      {
        "key": "A",
        "text": "$2^9$"
      },
      {
        "key": "B",
        "text": "$3^{10}$"
      },
      {
        "key": "C",
        "text": "$4^{11}$"
      },
      {
        "key": "D",
        "text": "$5^{12}$"
      },
      {
        "key": "E",
        "text": "$6^{13}$"
      }
    ],
    "answer": "E",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Use exponent laws",
        "body": "$2^9=(2^3)^3$ is a cube. $3^{10}=(3^5)^2$ is a square. $4^{11}=(2^{11})^2$ is a square. $5^{12}=(5^4)^3$ is a cube. $6^{13}$: the exponent 13 is neither even nor a multiple of 3, and 6 is not itself a square or cube, so it is neither.\n\n**Answer: (E) $6^{13}$**"
      }
    ],
    "topics": [
