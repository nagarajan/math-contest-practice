  "type": "mc",
  "prompt": "The lengths of two sides of a triangle are 5 cm and 2 cm. The length of the third side in cm is an odd integer. What is the length of the third side?",
  "image": null,
  "choices": [
   {
    "key": "A",
    "text": "1 cm"
   },
   {
    "key": "B",
    "text": "3 cm"
   },
   {
    "key": "C",
    "text": "5 cm"
   },
   {
    "key": "D",
    "text": "7 cm"
   },
   {
    "key": "E",
    "text": "9 cm"
   }
  ],
  "answer": "C",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Use the triangle inequality",
    "body": "In a triangle each side is shorter than the sum of the other two and longer than their difference. So the third side is less than $5+2=7$ and more than $5-2=3$ cm. The only odd integer strictly between 3 and 7 is 5.\n\n**Answer: (C) 5 cm**"
   }
  ],
