  "blankPoints": null,
  "wrongPoints": null,
  "timeMinutes": null,
  "type": "mc",
  "prompt": "Eight congruent semicircles are drawn inside a square of side-length 4. Each semicircle begins at a vertex of the square and ends at a midpoint of an edge of the square. What is the area of the non-shaded part of the square?",
  "image": "qimages/ukmt/pink-2018/q11.webp",
  "choices": [
   {
    "key": "A",
    "text": "$2\\pi$"
   },
   {
    "key": "B",
    "text": "$3\\pi+2$"
   },
   {
    "key": "C",
    "text": "8"
   },
   {
    "key": "D",
    "text": "$6+\\pi$"
   },
   {
    "key": "E",
    "text": "$3\\pi$"
   }
  ],
  "answer": "C",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Slide the curved pieces",
    "body": "Divide the square of side 4 into 16 unit squares. The curved pieces can be slid (as in the official solution) so that the shaded part exactly fills 8 of the unit squares. So the shaded area is 8 and the non-shaded area is $16-8=8$.\n\n**Answer: (C) 8**"
   },
   {
    "title": "Calculate with the semicircles",
    "body": "Each semicircle has radius 1 (its diameter runs from a vertex to the midpoint of an edge), so its area is $\\frac\\pi2$. At each corner two semicircles overlap in a lens of area $2\\left(\\frac\\pi4-\\frac12\\right)=\\frac\\pi2-1$, and this lens is the white part at the corner.\n\nThe shaded region at one corner has area (the two semicircles) minus (twice the lens): $2\\times\\frac\\pi2-2\\left(\\frac\\pi2-1\\right)=2$. With four corners the shaded area is $4\\times2=8$, so the non-shaded part has area $16-8=8$.\n\n**Answer: (C) 8**"
   }
  ],
  "topics": [
   "geometry",
   "measurement"
  ],
  "difficulty": 2,
  "duplicateOf": null,
  "reviewNote": null
 },
