  "type": "mc",
  "prompt": "The diagram shows a shape made from ten squares of side-length 1 cm, joined edge to edge. What is the length of its perimeter, in centimetres?",
  "image": "qimages/ukmt/pink-2020/q01.webp",
  "choices": [
   {
    "key": "A",
    "text": "14"
   },
   {
    "key": "B",
    "text": "18"
   },
   {
    "key": "C",
    "text": "30"
   },
   {
    "key": "D",
    "text": "32"
   },
   {
    "key": "E",
    "text": "40"
   }
  ],
  "answer": "B",
  "acceptedAnswers": null,
  "answerUnit": null,
  "solutions": [
   {
    "title": "Count the outside edges",
    "body": "Each square has 4 sides, giving $10\\times4=40$ sides. Each pair of squares that share an edge hides 2 of these. In the shape there are 7 side-by-side pairs (1 in the top row, 5 in the middle row, 1 in the bottom row) and 4 pairs one above the other, so 11 shared edges. The perimeter is $40-2\\times11=18$ cm.\n\n**Answer: (B) 18**"
   },
   {
    "title": "Walk round the outline",
    "body": "Count the unit edges along the boundary: tracing the outline of the figure gives 18 unit edges, so the perimeter is 18 cm.\n\n**Answer: (B) 18**"
   }
  ],
  "topics": [
   "geometry",
   "measurement"
  ],
  "difficulty": 1,
