    "blankPoints": null,
    "wrongPoints": null,
    "timeMinutes": null,
    "type": "mc",
    "prompt": "The bases of the two touching squares shown lie on the same straight line. The lengths of the diagonals of the larger square and the smaller square are 10 cm and 8 cm respectively. $P$ is the centre of the smaller square. What is the area, in $\\mathrm{cm}^2$, of the shaded triangle $PQR$?",
    "image": "qimages/ukmt/pink-2022/q22.webp",
    "choices": [
      {
        "key": "A",
        "text": "18"
      },
      {
        "key": "B",
        "text": "20"
      },
      {
        "key": "C",
        "text": "22"
      },
      {
        "key": "D",
        "text": "24"
      },
      {
        "key": "E",
        "text": "26"
      }
    ],
    "answer": "B",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Find a right angle",
        "body": "Let $S$ be the point on the line where the two squares touch, $R$ the top-left corner of the larger square and $Q$ the top-right corner of the smaller square. The diagonal $RS$ of the larger square goes up and to the left from $S$ at $45^\\circ$ to the line, and the diagonal $SQ$ of the smaller square goes up and to the right from $S$ at $45^\\circ$ to the line. So $\\angle RSQ=45^\\circ+45^\\circ=90^\\circ$.\n\nTriangle $RSQ$ is right-angled with legs $RS=10$ and $SQ=8$, so its area is $\\frac12\\cdot10\\cdot8=40$ cm$^2$.\n\n$P$ is the centre of the smaller square, so it is the midpoint of the diagonal $SQ$. Triangles $PQR$ and $RSQ$ have the same height from $R$ and bases $PQ=\\frac12 SQ$, so the area of $PQR$ is $\\frac12\\cdot40=20$ cm$^2$.\n\n**Answer: (B) 20**"
      }
    ],
    "topics": [
      "geometry"
    ],
    "difficulty": 2,
    "duplicateOf": null,
    "reviewNote": null
