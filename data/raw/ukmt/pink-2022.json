    "type": "mc",
    "prompt": "Five squares and two right-angled triangles are positioned as shown. The areas of three squares are $3\\ \\mathrm{m}^2$, $7\\ \\mathrm{m}^2$ and $22\\ \\mathrm{m}^2$ as shown. What is the area, in $\\mathrm{m}^2$, of the square with the question mark?",
    "image": "qimages/ukmt/pink-2022/q07.webp",
    "choices": [
      {
        "key": "A",
        "text": "18"
      },
      {
        "key": "B",
        "text": "19"
      },
      {
        "key": "C",
        "text": "20"
      },
      {
        "key": "D",
        "text": "21"
      },
      {
        "key": "E",
        "text": "22"
      }
    ],
    "answer": "A",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Pythagoras with areas",
        "body": "The central square is built on the hypotenuse of both right-angled triangles. By Pythagoras, the square on the hypotenuse has area equal to the sum of the areas of the squares on the other two sides.\n\nLeft triangle: central square $=22+3=25$. Right triangle: $25=7+{?}$, so the unknown area is $25-7=18$.\n\n**Answer: (A) 18**"
      }
    ],
    "topics": [
      "geometry"
    ],
    "difficulty": 1,
    "duplicateOf": null,
    "reviewNote": null
