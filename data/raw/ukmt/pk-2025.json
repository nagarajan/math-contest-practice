    "type": "mc",
    "prompt": "Otto reflects the number 2025 in the mirror on its left.\n\nWhat is the difference between 2025 and its reflection?",
    "image": "qimages/ukmt/pk-2025/q04.webp",
    "choices": [
      {
        "key": "A",
        "text": "350"
      },
      {
        "key": "B",
        "text": "477"
      },
      {
        "key": "C",
        "text": "480"
      },
      {
        "key": "D",
        "text": "2840"
      },
      {
        "key": "E",
        "text": "2997"
      }
    ],
    "answer": "C",
    "acceptedAnswers": null,
    "answerUnit": null,
    "solutions": [
      {
        "title": "Draw the reflection",
        "body": "In the mirror the order of the digits is reversed and each digit is flipped. The 5 looks like a 2, the 2 looks like a 5, and the 0 looks like a 0. So the reflection reads $2505$.\n\nThe difference is $2505-2025=480$.\n\n**Answer: (C) 480**"
      },
      {
        "title": "Compare place by place",
        "body": "$2505$ and $2025$ have the same thousands digit and the same units digit. They differ in the hundreds ($5$ against $0$) and the tens ($0$ against $2$). So the difference is $500-20=480$.\n\n**Answer: (C) 480**"
      }
    ],
