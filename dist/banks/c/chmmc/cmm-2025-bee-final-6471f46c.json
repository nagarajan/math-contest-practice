{"chmmc-cmm-2025-bee-final-01":{"prompt":"Find an antiderivative: $$\\int \\sqrt x\\,e^{\\sqrt x}\\,dx$$","answer":"$e^{\\sqrt x}\\left(2x-4\\sqrt x+4\\right)+C$"},"chmmc-cmm-2025-bee-final-02":{"prompt":"Find an antiderivative: $$\\int \\sin(\\sin(\\cos x))\\cos(\\cos x)\\sin x\\,dx$$","answer":"$\\cos(\\sin(\\cos x))+C$"},"chmmc-cmm-2025-bee-final-03":{"prompt":"Find an antiderivative: $$\\int \\operatorname{arcsec}(\\sqrt x)\\,dx$$","answer":"$x\\operatorname{arcsec}\\sqrt x-\\sqrt{x-1}+C$"},"chmmc-cmm-2025-bee-final-04":{"prompt":"Evaluate $$\\int_0^1\\big|1-|1-|1-x|\\,|\\big|\\,dx$$","answer":"1/2","answerDisplay":"$\\frac12$"},"chmmc-cmm-2025-bee-final-05":{"prompt":"Find an antiderivative: $$\\int \\frac{x^2+1}{1-x}\\,dx$$","answer":"$-\\frac{x^2}2-x-2\\ln|1-x|+C$"},"chmmc-cmm-2025-bee-final-06":{"prompt":"Evaluate $$\\int_1^{\\pi/3}\\sec x\\left(\\tan x\\ln x+\\frac1x\\right)dx$$","answer":"2*ln(pi/3)","answerDisplay":"$2\\ln\\frac\\pi3$"},"chmmc-cmm-2025-bee-final-07":{"prompt":"Evaluate $$\\int_0^1\\ln^7\\!\\left(\\frac1x\\right)dx$$","answer":"5040","answerDisplay":"$5040$"},"chmmc-cmm-2025-bee-final-08":{"prompt":"Find an antiderivative: $$\\int \\frac{2x-9\\sqrt x+9}{(x-3\\sqrt x)^{1/3}}\\,dx$$","answer":"$\\frac65\\left(x-3\\sqrt x\\right)^{5/3}+C$"},"chmmc-cmm-2025-bee-final-09":{"prompt":"Find an antiderivative: $$\\int \\frac{x^3+3x^2+3x}{x^4+4x^3+6x^2+4x+1}\\,dx$$","answer":"$\\ln|x+1|+\\frac1{3(x+1)^3}+C$"},"chmmc-cmm-2025-bee-final-10":{"prompt":"Find an antiderivative: $$\\int e^x\\tan(e^x)\\,dx$$","answer":"$\\ln|\\sec(e^x)|+C$"},"chmmc-cmm-2025-bee-final-11":{"prompt":"Find an antiderivative: $$\\int \\sin(\\arccos x)\\,dx$$","answer":"$\\frac12\\left(x\\sqrt{1-x^2}+\\arcsin x\\right)+C$"},"chmmc-cmm-2025-bee-final-12":{"prompt":"Find an antiderivative: $$\\int \\frac{3x+2}{x^2+3x+2}\\,dx$$","answer":"$4\\ln|x+2|-\\ln|x+1|+C$"},"chmmc-cmm-2025-bee-final-13":{"prompt":"Find an antiderivative: $$\\int (e^x-1)^{-1}\\,dx$$","answer":"$\\ln\\left|1-e^{-x}\\right|+C$"},"chmmc-cmm-2025-bee-final-14":{"prompt":"Find an antiderivative: $$\\int \\frac1{x\\sqrt{x^{2025}-1}}\\,dx$$","answer":"$\\frac2{2025}\\arctan\\sqrt{x^{2025}-1}+C$"},"chmmc-cmm-2025-bee-final-15":{"prompt":"Find an antiderivative: $$\\int xe^x(\\sin x+\\cos x)\\,dx$$","answer":"$xe^x\\sin x-\\frac{e^x(\\sin x-\\cos x)}2+C$","reviewNote":"The slide prints no limits (an indefinite integral), but the official answer slide gives (e(sin 1 + cos 1) - 1)/2, the value for the interval 0 to 1; an antiderivative is stored here."},"chmmc-cmm-2025-bee-final-16":{"prompt":"Evaluate $$\\int_0^1\\left((1-x^{25})^{1/20}-(1-x^{20})^{1/25}\\right)dx$$","answer":"0","answerDisplay":"$0$"},"chmmc-cmm-2025-bee-final-17":{"prompt":"Find an antiderivative: $$\\int \\frac1{x+x^e}\\,dx$$","answer":"$\\ln x-\\frac{1}{e-1}\\ln\\left(1+x^{e-1}\\right)+C\\quad(x>0)$"},"chmmc-cmm-2025-bee-final-18":{"prompt":"Find an antiderivative: $$\\int \\frac{(x-1)e^x}{(x+1)^3}\\,dx$$","answer":"$\\frac{e^x}{(x+1)^2}+C$"},"chmmc-cmm-2025-bee-final-19":{"prompt":"Find an antiderivative: $$\\int \\frac{\\cos4x+1}{\\cot x-\\tan x}\\,dx$$","answer":"$-\\frac{\\cos4x}8+C$"},"chmmc-cmm-2025-bee-final-20":{"prompt":"Find an antiderivative: $$\\int \\sec^2x\\csc^3x\\,dx$$","answer":"$\\sec x+\\frac32\\ln\\left|\\tan\\frac x2\\right|-\\frac12\\csc x\\cot x+C$","reviewNote":"The official answer slide (tan x - 2 cot x - cot^3 x / 3 + C) is the antiderivative of sec^2 x csc^4 x, not of the printed sec^2 x csc^3 x; the antiderivative here was derived for the printed integrand."},"chmmc-cmm-2025-bee-final-21":{"prompt":"Find an antiderivative: $$\\int \\frac{x+\\sin x}{1+\\cos x}\\,dx$$","answer":"$x\\tan\\frac x2+C$"},"chmmc-cmm-2025-bee-final-22":{"prompt":"Find an antiderivative: $$\\int \\frac{1-x}{\\sqrt{8-5x^2}}\\,dx$$","answer":"$\\frac{\\sqrt{8-5x^2}}5+\\frac1{\\sqrt5}\\arcsin\\left(\\sqrt{\\tfrac58}\\,x\\right)+C$"},"chmmc-cmm-2025-bee-final-23":{"prompt":"Find an antiderivative: $$\\int \\arctan\\!\\left(\\sqrt{\\frac{1-\\sin x}{1+\\sin x}}\\right)dx$$","answer":"$\\frac{\\pi x}4-\\frac{x^2}4+C\\quad(-\\tfrac\\pi2\\le x\\le\\tfrac\\pi2)$"},"chmmc-cmm-2025-bee-final-24":{"prompt":"Evaluate $$\\int_{-4}^{4}e^{|x|}\\{x\\}\\,dx$$","answer":"e^4-1","answerDisplay":"$e^4-1$"},"chmmc-cmm-2025-bee-final-25":{"prompt":"Evaluate $$\\int_{-\\infty}^{\\infty}\\frac{e^{-x^2}}{1+e^{x^{2025}\\cos x}}\\,dx$$","answer":"sqrt(pi)/2","answerDisplay":"$\\frac{\\sqrt\\pi}{2}$"},"chmmc-cmm-2025-bee-final-26":{"prompt":"Evaluate $$\\int_0^{\\pi/2}\\frac{\\cos x-\\sin x}{2025-x^2+\\frac{\\pi x}2}\\,dx$$","answer":"0","answerDisplay":"$0$"},"chmmc-cmm-2025-bee-final-27":{"prompt":"Evaluate $$\\int_0^{2026\\pi}\\frac1{1+e^{\\sin x}}\\,dx$$","answer":"1013*pi","answerDisplay":"$1013\\pi$"},"chmmc-cmm-2025-bee-final-28":{"prompt":"Find an antiderivative: $$\\int \\frac{(1-\\cos x)^{3/10}}{(1+\\cos x)^{13/10}}\\,dx$$","answer":"$\\frac58\\tan^{8/5}\\frac x2+C\\quad(0<x<\\pi)$"},"chmmc-cmm-2025-bee-final-29":{"prompt":"Evaluate $$\\int_{-\\pi/2}^{\\pi/2}\\left(x^2+\\ln\\frac{\\pi-x}{\\pi+x}\\right)\\cos x\\,dx$$","answer":"pi^2/2-4","answerDisplay":"$\\frac{\\pi^2}2-4$"},"chmmc-cmm-2025-bee-final-30":{"prompt":"Find an antiderivative: $$\\int \\frac1{\\cos^2x+2025}\\,dx$$","answer":"$\\frac1{45\\sqrt{2026}}\\arctan\\left(\\frac{45\\tan x}{\\sqrt{2026}}\\right)+C$","reviewNote":"The slide prints an indefinite integral, but the official answer slide shows sqrt(2/13)*pi, which is not an antiderivative of 1/(cos^2 x + 2025); the antiderivative here was derived directly (derivative checked numerically)."},"chmmc-cmm-2025-bee-final-31":{"prompt":"Find an antiderivative: $$\\int \\frac{\\sin2x-\\sin^2x}{\\cos2x-\\cos^2x}\\,dx$$","answer":"$x-2\\ln|\\sin x|+C$"},"chmmc-cmm-2025-bee-final-32":{"prompt":"Find an antiderivative: $$\\int \\left(\\sin x\\ln x-\\frac{\\cos x}x\\right)dx$$","answer":"$-\\cos x\\ln x+C$"},"chmmc-cmm-2025-bee-final-33":{"prompt":"Find an antiderivative: $$\\int \\frac{x^2-1}{x^4+1}\\,dx$$","answer":"$\\frac1{2\\sqrt2}\\ln\\left|\\frac{x^2-\\sqrt2x+1}{x^2+\\sqrt2x+1}\\right|+C$"},"chmmc-cmm-2025-bee-final-34":{"prompt":"Find an antiderivative: $$\\int \\sqrt{\\frac{\\ln\\left(x+\\sqrt{1+x^2}\\right)}{1+x^2}}\\,dx$$","answer":"$\\frac23\\ln^{3/2}\\left(x+\\sqrt{1+x^2}\\right)+C\\quad(x>0)$"},"chmmc-cmm-2025-bee-final-35":{"prompt":"Find an antiderivative: $$\\int \\frac1{x\\,(x^{2025}+2)}\\,dx$$","answer":"$\\frac1{4050}\\ln\\left|\\frac{x^{2025}}{x^{2025}+2}\\right|+C$"},"chmmc-cmm-2025-bee-final-36":{"prompt":"Find an antiderivative: $$\\int \\frac1{\\sin^4x+\\cos^4x}\\,dx$$","answer":"$\\frac1{\\sqrt2}\\left[\\arctan\\left(\\sqrt2\\tan x+1\\right)+\\arctan\\left(\\sqrt2\\tan x-1\\right)\\right]+C$"},"chmmc-cmm-2025-bee-final-37":{"prompt":"Find an antiderivative: $$\\int x\\ln^2x\\,dx$$","answer":"$\\frac{x^2\\left(2\\ln^2x-2\\ln x+1\\right)}4+C$"},"chmmc-cmm-2025-bee-final-38":{"prompt":"Find an antiderivative: $$\\int \\frac{\\cos^3x+\\cos^5x}{\\sin^2x+\\sin^4x}\\,dx$$","answer":"$\\sin x-2\\csc x-6\\arctan(\\sin x)+C$"},"chmmc-cmm-2025-bee-final-39":{"prompt":"Find an antiderivative: $$\\int \\frac1{4+5\\sin x}\\,dx$$","answer":"$\\frac13\\ln\\left|\\frac{2\\tan\\frac x2+1}{\\tan\\frac x2+2}\\right|+C$"},"chmmc-cmm-2025-bee-final-40":{"prompt":"Evaluate $$\\int_{\\pi/6}^{\\pi/3}\\frac{\\sin x+\\cos x}{\\sqrt{\\sin2x}}\\,dx$$","answer":"2*arcsin((sqrt(3)-1)/2)","answerDisplay":"$2\\arcsin\\frac{\\sqrt3-1}{2}$"},"chmmc-cmm-2025-bee-final-41":{"prompt":"Find an antiderivative: $$\\int -e^x\\sqrt{4e^{2x}-9}\\,dx$$","answer":"$\\frac94\\ln\\left|\\frac{2e^x+\\sqrt{4e^{2x}-9}}3\\right|-\\frac12e^x\\sqrt{4e^{2x}-9}+C$"},"chmmc-cmm-2025-bee-final-42":{"prompt":"Find an antiderivative: $$\\int \\frac{\\sqrt[3]x}{1+x}\\,dx$$","answer":"$3\\sqrt[3]x-\\ln\\left|\\sqrt[3]x+1\\right|+\\frac12\\ln\\left(x^{2/3}-x^{1/3}+1\\right)-\\sqrt3\\arctan\\frac{2\\sqrt[3]x-1}{\\sqrt3}+C$"},"chmmc-cmm-2025-bee-final-43":{"prompt":"Evaluate $$\\int_0^\\infty\\frac{\\sin(\\sqrt3x)-\\sin\\left(\\frac x{\\sqrt3}\\right)}{x}\\,e^{-x^2}\\,dx.$$","answer":"$\\frac\\pi2\\left(\\operatorname{erf}\\frac{\\sqrt3}2-\\operatorname{erf}\\frac{\\sqrt3}6\\right)\\approx0.72637$","reviewNote":"The official answer slide gives pi/6 (about 0.5236), but the integral is (pi/2)(erf(sqrt3/2) - erf(1/(2 sqrt3))) = 0.72637 by differentiation under the integral sign and by numerical integration."},"chmmc-cmm-2025-bee-final-44":{"prompt":"Evaluate $$\\int_0^1\\frac{x^3}{(3+2x^2)^2}\\,dx$$","answer":"ln(5/3)/8-1/20","answerDisplay":"$\\frac18\\ln\\frac53-\\frac1{20}$"},"chmmc-cmm-2025-bee-final-45":{"prompt":"Evaluate $$\\int_0^1\\arctan(x^2-x+1)\\,dx$$","answer":"ln(2)","answerDisplay":"$\\ln2$"},"chmmc-cmm-2025-bee-final-46":{"prompt":"Evaluate $$\\int_0^\\infty e^{-x^2}\\cos(2x)\\,dx$$","answer":"sqrt(pi)/(2*e)","answerDisplay":"$\\frac{\\sqrt\\pi}{2e}$"},"chmmc-cmm-2025-bee-final-47":{"prompt":"Find an antiderivative: $$\\int \\frac1{2+2\\sin x+\\cos x}\\,dx$$","answer":"$\\ln\\left|\\frac{\\tan\\frac x2+1}{\\tan\\frac x2+3}\\right|+C$"},"chmmc-cmm-2025-bee-final-48":{"prompt":"Find an antiderivative: $$\\int \\prod_{k=1}^{n-1}\\sqrt{2x^2-2x^2\\cos\\left(\\frac{2\\pi k}n\\right)}\\,dx$$","answer":"$x|x|^{n-1}+C$ (equal to $x^n+C$ for $x\\ge0$)"}}