{"smt-2013-calculus-tiebreaker-01":{"prompt":"Compute $\\displaystyle\\int_{e^{e^e}}^{\\infty}\\frac{dx}{x(\\log x)(\\log\\log x)(\\log\\log\\log x)^{4/3}}$.","answer":"3"},"smt-2013-calculus-tiebreaker-02":{"prompt":"For which integers $1\\le m\\le10$ is it true that $$\\int_0^\\pi(\\cos x)(\\cos2x)\\cdots(\\cos mx)\\,dx=0\\,?$$","answer":"$m\\in\\{1,2,5,6,9,10\\}$ (exactly the $m\\equiv1,2\\pmod4$)"},"smt-2013-calculus-tiebreaker-03":{"prompt":"Let $f(x)=\\displaystyle\\sum_{n=0}^{\\infty}\\frac{\\sin nx}{n!}$. Compute $f\\!\\left(\\frac\\pi3\\right)$.","answer":"e^(1/2)*sin(sqrt(3)/2)","answerDisplay":"$e^{1/2}\\sin\\dfrac{\\sqrt3}{2}$"}}