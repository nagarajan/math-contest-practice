{"bank":"mathleague","grades":[4],"papers":[["mathleague/2004-05-g4",{"contest":"Math League","paper":"2004-05 Grade 4 Contest","year":2005,"url":"https://www.mathleague.com/index.php/annualcontestinformation/samplecontests"}],["mathleague/2012-13-g4",{"contest":"Math League","paper":"2012-13 Grade 4 Contest","year":2013,"url":"https://www.mathleague.com/index.php/annualcontestinformation/samplecontests"}],["mathleague/2018-19-g4",{"contest":"Math League","paper":"2018-19 Grade 4 Contest","year":2019,"url":"https://www.mathleague.com/index.php/annualcontestinformation/samplecontests"}]],"questions":[{"id":"mathleague-2004-05-g4-01","type":"mc","prompt":"How many 10¢ gumballs can I buy for \\$1?","choices":[{"key":"A","text":"2"},{"key":"B","text":"5"},{"key":"C","text":"10"},{"key":"D","text":"20"}],"answer":"C","topics":["money","arithmetic"],"difficulty":1,"p":0,"n":1},{"id":"mathleague-2004-05-g4-02","type":"mc","prompt":"$2 \\times 0 \\times 0 \\times 5 =$","choices":[{"key":"A","text":"0"},{"key":"B","text":"10"},{"key":"C","text":"100"},{"key":"D","text":"2005"}],"answer":"A","topics":["arithmetic"],"difficulty":1,"p":0,"n":2},{"id":"mathleague-2004-05-g4-03","type":"mc","prompt":"Ork the stork delivers 2 babies every day. How many babies does Ork deliver in one week?","choices":[{"key":"A","text":"2"},{"key":"B","text":"7"},{"key":"C","text":"14"},{"key":"D","text":"21"}],"answer":"C","topics":["arithmetic","time-calendar"],"difficulty":1,"p":0,"n":3},{"id":"mathleague-2004-05-g4-04","type":"mc","prompt":"What number is 5 less than 2 more than 52?","choices":[{"key":"A","text":"47"},{"key":"B","text":"49"},{"key":"C","text":"54"},{"key":"D","text":"57"}],"answer":"B","topics":["arithmetic"],"difficulty":1,"p":0,"n":4},{"id":"mathleague-2004-05-g4-05","type":"mc","prompt":"My birthday was Monday. Two days before my birthday was","choices":[{"key":"A","text":"Saturday"},{"key":"B","text":"Sunday"},{"key":"C","text":"Wednesday"},{"key":"D","text":"Friday"}],"answer":"A","topics":["time-calendar"],"difficulty":1,"p":0,"n":5},{"id":"mathleague-2004-05-g4-06","type":"mc","prompt":"$15-14+13-12+11-10+9-8+7-6+5-4 =$","choices":[{"key":"A","text":"6"},{"key":"B","text":"7"},{"key":"C","text":"12"},{"key":"D","text":"114"}],"answer":"A","topics":["arithmetic","patterns"],"difficulty":1,"p":0,"n":6},{"id":"mathleague-2004-05-g4-07","type":"mc","prompt":"What time is it 45 minutes after 4:45?","choices":[{"key":"A","text":"4:00"},{"key":"B","text":"5:00"},{"key":"C","text":"5:15"},{"key":"D","text":"5:30"}],"answer":"D","topics":["time-calendar"],"difficulty":1,"p":0,"n":7},{"id":"mathleague-2004-05-g4-08","type":"mc","prompt":"2 dollars + 20 pennies = 1 dollar + $\\underline{\\;?\\;}$ pennies","choices":[{"key":"A","text":"100"},{"key":"B","text":"120"},{"key":"C","text":"200"},{"key":"D","text":"220"}],"answer":"B","topics":["money"],"difficulty":1,"p":0,"n":8},{"id":"mathleague-2004-05-g4-09","type":"mc","prompt":"Divide $205 \\times 205$ by 205. The quotient is","choices":[{"key":"A","text":"1"},{"key":"B","text":"2"},{"key":"C","text":"25"},{"key":"D","text":"205"}],"answer":"D","topics":["arithmetic"],"difficulty":1,"p":0,"n":9},{"id":"mathleague-2004-05-g4-10","type":"mc","prompt":"A small wheel on my wheelchair has a diameter that's 16 cm long. This small wheel's radius is $\\underline{\\;?\\;}$ cm long.","choices":[{"key":"A","text":"4"},{"key":"B","text":"8"},{"key":"C","text":"32"},{"key":"D","text":"196"}],"answer":"B","topics":["geometry","measurement"],"difficulty":1,"p":0,"n":10},{"id":"mathleague-2004-05-g4-11","type":"mc","prompt":"$1 \\times (2+3) \\times 4 =$","choices":[{"key":"A","text":"10"},{"key":"B","text":"14"},{"key":"C","text":"20"},{"key":"D","text":"24"}],"answer":"C","topics":["arithmetic"],"difficulty":1,"p":0,"n":11},{"id":"mathleague-2004-05-g4-12","type":"mc","prompt":"How many 0s are needed to write the numeral for *ten thousand*?","choices":[{"key":"A","text":"3"},{"key":"B","text":"4"},{"key":"C","text":"5"},{"key":"D","text":"6"}],"answer":"B","topics":["arithmetic"],"difficulty":1,"p":0,"n":12},{"id":"mathleague-2004-05-g4-13","type":"mc","prompt":"$60 \\times 60 = 20 \\times 20 \\times \\underline{\\;?\\;}$","choices":[{"key":"A","text":"3"},{"key":"B","text":"9"},{"key":"C","text":"80"},{"key":"D","text":"900"}],"answer":"B","topics":["arithmetic"],"difficulty":1,"p":0,"n":13},{"id":"mathleague-2004-05-g4-14","type":"mc","prompt":"Three friends and I put dimes in a piggy bank. After the 4 of us put in equal numbers of dimes, I had 3 dimes left over. I put those in the piggy bank too. The total number of dimes we put in the bank *could* have been","choices":[{"key":"A","text":"23"},{"key":"B","text":"24"},{"key":"C","text":"25"},{"key":"D","text":"26"}],"answer":"A","topics":["number-theory","arithmetic"],"difficulty":2,"p":0,"n":14},{"id":"mathleague-2004-05-g4-15","type":"mc","prompt":"$(8-3) \\times (2-1) =$","choices":[{"key":"A","text":"1"},{"key":"B","text":"3"},{"key":"C","text":"5"},{"key":"D","text":"9"}],"answer":"C","topics":["arithmetic"],"difficulty":1,"p":0,"n":15},{"id":"mathleague-2004-05-g4-16","type":"mc","prompt":"Each of the following is divisible by 6 *except*","choices":[{"key":"A","text":"3366"},{"key":"B","text":"4422"},{"key":"C","text":"6630"},{"key":"D","text":"6633"}],"answer":"D","topics":["number-theory"],"difficulty":1,"p":0,"n":16},{"id":"mathleague-2004-05-g4-17","type":"mc","prompt":"I'm thinking of a number. When I multiply it by 5, the product is 0. When I multiply the number by 6 instead of by 5, the product is","choices":[{"key":"A","text":"0"},{"key":"B","text":"1"},{"key":"C","text":"6"},{"key":"D","text":"12"}],"answer":"A","topics":["arithmetic","logic"],"difficulty":1,"p":0,"n":17},{"id":"mathleague-2004-05-g4-18","type":"mc","prompt":"10 hundreds + 100 tens = $\\underline{\\;?\\;}$ ones","choices":[{"key":"A","text":"1000"},{"key":"B","text":"2000"},{"key":"C","text":"10 000"},{"key":"D","text":"20 000"}],"answer":"B","topics":["arithmetic"],"difficulty":1,"p":0,"n":18},{"id":"mathleague-2004-05-g4-19","type":"mc","prompt":"The perimeter of my square hammock is 64. How long is each side of my hammock?","choices":[{"key":"A","text":"4"},{"key":"B","text":"8"},{"key":"C","text":"16"},{"key":"D","text":"32"}],"answer":"C","topics":["geometry","measurement"],"difficulty":1,"p":0,"n":19},{"id":"mathleague-2004-05-g4-20","type":"mc","prompt":"If I fold my square hammock exactly in half, the two halves *cannot* be","choices":[{"key":"A","text":"triangles"},{"key":"B","text":"rectangles"},{"key":"C","text":"polygons"},{"key":"D","text":"squares"}],"answer":"D","topics":["geometry","spatial"],"difficulty":2,"p":0,"n":20},{"id":"mathleague-2004-05-g4-21","type":"mc","prompt":"The smallest whole number divisible by both 8 and 12 is","choices":[{"key":"A","text":"4"},{"key":"B","text":"16"},{"key":"C","text":"24"},{"key":"D","text":"48"}],"answer":"C","topics":["number-theory"],"difficulty":1,"p":0,"n":21},{"id":"mathleague-2004-05-g4-22","type":"mc","prompt":"The product of 2005 and any odd number is *always*","choices":[{"key":"A","text":"2005"},{"key":"B","text":"even"},{"key":"C","text":"odd"},{"key":"D","text":"prime"}],"answer":"C","topics":["number-theory"],"difficulty":1,"p":0,"n":22},{"id":"mathleague-2004-05-g4-23","type":"mc","prompt":"The product of 2 different whole numbers is 7. Their sum is","choices":[{"key":"A","text":"6"},{"key":"B","text":"7"},{"key":"C","text":"8"},{"key":"D","text":"14"}],"answer":"C","topics":["number-theory"],"difficulty":1,"p":0,"n":23},{"id":"mathleague-2004-05-g4-24","type":"mc","prompt":"The sum of 2 positive whole numbers is greater than their product if one of the numbers is","choices":[{"key":"A","text":"1"},{"key":"B","text":"2"},{"key":"C","text":"3"},{"key":"D","text":"4"}],"answer":"A","topics":["arithmetic","logic"],"difficulty":2,"p":0,"n":24},{"id":"mathleague-2004-05-g4-25","type":"mc","prompt":"When I look at our alphabet, I see that the letter $\\underline{\\;?\\;}$ has four times as many letters before it as after it.","choices":[{"key":"A","text":"E"},{"key":"B","text":"G"},{"key":"C","text":"T"},{"key":"D","text":"U"}],"answer":"D","topics":["logic","arithmetic"],"difficulty":2,"p":0,"n":25},{"id":"mathleague-2004-05-g4-26","type":"mc","prompt":"I have 22¢. If I doubled the number of nickels I have, I would then have 37¢. Exactly how many nickels do I have?","choices":[{"key":"A","text":"3"},{"key":"B","text":"4"},{"key":"C","text":"5"},{"key":"D","text":"6"}],"answer":"A","topics":["money","logic"],"difficulty":2,"p":0,"n":26},{"id":"mathleague-2004-05-g4-27","type":"mc","prompt":"If paper clips cost 48¢ a dozen, then $\\underline{\\;?\\;}$ paper clips cost \\$1.","choices":[{"key":"A","text":"24"},{"key":"B","text":"25"},{"key":"C","text":"26"},{"key":"D","text":"96"}],"answer":"B","topics":["money","rates"],"difficulty":2,"p":0,"n":27},{"id":"mathleague-2004-05-g4-28","type":"mc","prompt":"Lee, Pat, and Sam bought ice pops. Lee bought 3 times as many as Pat. Sam bought twice as many as Lee. If Sam bought 18 ice pops, how many did Pat buy?","choices":[{"key":"A","text":"1"},{"key":"B","text":"3"},{"key":"C","text":"6"},{"key":"D","text":"9"}],"answer":"B","topics":["arithmetic","logic"],"difficulty":2,"p":0,"n":28},{"id":"mathleague-2004-05-g4-29","type":"mc","prompt":"Along a straight road, an ice cream vendor is 2 km from the bus and 5 km from the train. The *least* possible distance between the bus and the train is","choices":[{"key":"A","text":"3 km"},{"key":"B","text":"5 km"},{"key":"C","text":"7 km"},{"key":"D","text":"10 km"}],"answer":"A","topics":["measurement","logic"],"difficulty":2,"p":0,"n":29},{"id":"mathleague-2004-05-g4-30","type":"mc","prompt":"My giant sunflower doubles its size every day. On Saturday, it is $\\underline{\\;?\\;}$ times as big as it was on the preceding Sunday.","choices":[{"key":"A","text":"2"},{"key":"B","text":"6"},{"key":"C","text":"49"},{"key":"D","text":"64"}],"answer":"D","topics":["patterns","time-calendar"],"difficulty":2,"p":0,"n":30},{"id":"mathleague-2012-13-g4-01","type":"mc","prompt":"$2 \\times 0 \\times 1 \\times 3 =$","choices":[{"key":"A","text":"0"},{"key":"B","text":"6"},{"key":"C","text":"12"},{"key":"D","text":"2013"}],"answer":"A","topics":["arithmetic"],"difficulty":1,"p":1,"n":1},{"id":"mathleague-2012-13-g4-02","type":"mc","prompt":"Rollo delivers 3 packages to each of the 4 houses on Sixth Street. Rollo delivers a total of $\\underline{\\;?\\;}$ packages.","choices":[{"key":"A","text":"7"},{"key":"B","text":"12"},{"key":"C","text":"13"},{"key":"D","text":"72"}],"answer":"B","topics":["arithmetic"],"difficulty":1,"p":1,"n":2},{"id":"mathleague-2012-13-g4-03","type":"mc","prompt":"What is the remainder when $16 + 16 + 16 + 16$ is divided by 4?","choices":[{"key":"A","text":"16"},{"key":"B","text":"4"},{"key":"C","text":"2"},{"key":"D","text":"0"}],"answer":"D","topics":["arithmetic","number-theory"],"difficulty":1,"p":1,"n":3},{"id":"mathleague-2012-13-g4-04","type":"mc","prompt":"Which of the following is a factor of 380?","choices":[{"key":"A","text":"3"},{"key":"B","text":"6"},{"key":"C","text":"8"},{"key":"D","text":"10"}],"answer":"D","topics":["number-theory"],"difficulty":1,"p":1,"n":4},{"id":"mathleague-2012-13-g4-05","type":"mc","prompt":"If there are 8 pencils in each box, how many pencils are in 80 boxes?","choices":[{"key":"A","text":"10"},{"key":"B","text":"88"},{"key":"C","text":"640"},{"key":"D","text":"808"}],"answer":"C","topics":["arithmetic"],"difficulty":1,"p":1,"n":5},{"id":"mathleague-2012-13-g4-06","type":"mc","prompt":"$(60 \\div 5) \\times 4 =$","choices":[{"key":"A","text":"3"},{"key":"B","text":"16"},{"key":"C","text":"48"},{"key":"D","text":"96"}],"answer":"C","topics":["arithmetic"],"difficulty":1,"p":1,"n":6},{"id":"mathleague-2012-13-g4-07","type":"mc","prompt":"Stan earns two dimes for every glass of lemonade he sells. If Stan earned \\$20, how many glasses of lemonade did he sell?","choices":[{"key":"A","text":"10"},{"key":"B","text":"20"},{"key":"C","text":"40"},{"key":"D","text":"100"}],"answer":"D","topics":["money","arithmetic"],"difficulty":1,"p":1,"n":7},{"id":"mathleague-2012-13-g4-08","type":"mc","prompt":"How many whole numbers are greater than 9 and less than 60?","choices":[{"key":"A","text":"49"},{"key":"B","text":"50"},{"key":"C","text":"51"},{"key":"D","text":"59"}],"answer":"B","topics":["counting"],"difficulty":1,"p":1,"n":8},{"id":"mathleague-2012-13-g4-09","type":"mc","prompt":"Sue sits on a seesaw waiting for her friend Seth. Seth left on a Saturday and will be back seventeen days later. Seth will be back on a","choices":[{"key":"A","text":"Sunday"},{"key":"B","text":"Tuesday"},{"key":"C","text":"Thursday"},{"key":"D","text":"Friday"}],"answer":"B","topics":["time-calendar"],"difficulty":1,"p":1,"n":9},{"id":"mathleague-2012-13-g4-10","type":"mc","prompt":"The greatest odd factor of 30 is","choices":[{"key":"A","text":"5"},{"key":"B","text":"6"},{"key":"C","text":"15"},{"key":"D","text":"21"}],"answer":"C","topics":["number-theory"],"difficulty":1,"p":1,"n":10},{"id":"mathleague-2012-13-g4-11","type":"mc","prompt":"Wayne goes to bed exactly 65 minutes after 8:30 P.M. At what time does Wayne go to bed?","choices":[{"key":"A","text":"9:05 P.M."},{"key":"B","text":"9:25 P.M."},{"key":"C","text":"9:35 P.M."},{"key":"D","text":"9:45 P.M."}],"answer":"C","topics":["time-calendar"],"difficulty":1,"p":1,"n":11},{"id":"mathleague-2012-13-g4-12","type":"mc","prompt":"Roy has rowed his rowboat 1000 m from where he started. Roy has rowed his rowboat $\\underline{\\;?\\;}$ cm.","choices":[{"key":"A","text":"10"},{"key":"B","text":"100"},{"key":"C","text":"10 000"},{"key":"D","text":"100 000"}],"answer":"D","topics":["measurement"],"difficulty":1,"p":1,"n":12},{"id":"mathleague-2012-13-g4-13","type":"mc","prompt":"My pocketful of coins includes quarters, dimes, nickels, and exactly 8 pennies. Of the following, which could be the total value of my pocketful of coins?","choices":[{"key":"A","text":"\\$14.56"},{"key":"B","text":"\\$16.32"},{"key":"C","text":"\\$18.85"},{"key":"D","text":"\\$21.93"}],"answer":"D","topics":["money","number-theory"],"difficulty":2,"p":1,"n":13},{"id":"mathleague-2012-13-g4-14","type":"mc","prompt":"$4 \\times 4 \\times 20 \\times 20 = 80 \\times$ $\\underline{\\;?\\;}$","choices":[{"key":"A","text":"80"},{"key":"B","text":"20"},{"key":"C","text":"4"},{"key":"D","text":"2"}],"answer":"A","topics":["arithmetic"],"difficulty":1,"p":1,"n":14},{"id":"mathleague-2012-13-g4-15","type":"mc","prompt":"If the sum of the lengths of the sides of a rhombus is 24, then each side of the rhombus has a length of","choices":[{"key":"A","text":"3"},{"key":"B","text":"4"},{"key":"C","text":"6"},{"key":"D","text":"8"}],"answer":"C","topics":["geometry","measurement"],"difficulty":1,"p":1,"n":15},{"id":"mathleague-2012-13-g4-16","type":"mc","prompt":"If 20 years ago Allen was half as old as he is today, how old was he 10 years ago?","choices":[{"key":"A","text":"20"},{"key":"B","text":"30"},{"key":"C","text":"40"},{"key":"D","text":"50"}],"answer":"B","topics":["algebra","arithmetic"],"difficulty":2,"p":1,"n":16},{"id":"mathleague-2012-13-g4-17","type":"mc","prompt":"If the sum of 7 whole numbers is even, at most $\\underline{\\;?\\;}$ of the numbers could be odd.","choices":[{"key":"A","text":"6"},{"key":"B","text":"4"},{"key":"C","text":"3"},{"key":"D","text":"1"}],"answer":"A","topics":["number-theory","logic"],"difficulty":2,"p":1,"n":17},{"id":"mathleague-2012-13-g4-18","type":"mc","prompt":"(10 hundreds) + (10 ones) = $\\underline{\\;?\\;}$ tens","choices":[{"key":"A","text":"10"},{"key":"B","text":"101"},{"key":"C","text":"110"},{"key":"D","text":"1010"}],"answer":"B","topics":["arithmetic"],"difficulty":1,"p":1,"n":18},{"id":"mathleague-2012-13-g4-19","type":"mc","prompt":"Sam loves spaghetti and meatballs. He prepares a plate of spaghetti with some meatballs. If the number of meatballs is divisible by 4, 5, 6, 7, and 8, there must be at least $\\underline{\\;?\\;}$ meatballs.","choices":[{"key":"A","text":"210"},{"key":"B","text":"420"},{"key":"C","text":"840"},{"key":"D","text":"6720"}],"answer":"C","topics":["number-theory"],"difficulty":2,"p":1,"n":19},{"id":"mathleague-2012-13-g4-20","type":"mc","prompt":"The number that is 25 less than the number that is 50 less than 125 is","choices":[{"key":"A","text":"0"},{"key":"B","text":"25"},{"key":"C","text":"50"},{"key":"D","text":"75"}],"answer":"C","topics":["arithmetic"],"difficulty":1,"p":1,"n":20},{"id":"mathleague-2012-13-g4-21","type":"mc","prompt":"The product of 2 odd numbers is always","choices":[{"key":"A","text":"divisible by 3"},{"key":"B","text":"odd"},{"key":"C","text":"prime"},{"key":"D","text":"even"}],"answer":"B","topics":["number-theory"],"difficulty":1,"p":1,"n":21},{"id":"mathleague-2012-13-g4-22","type":"mc","prompt":"Charlie grills 3 hot dogs for every 8 hamburgers he grills. If he grills 48 hamburgers, he grills $\\underline{\\;?\\;}$ hot dogs.","choices":[{"key":"A","text":"18"},{"key":"B","text":"43"},{"key":"C","text":"80"},{"key":"D","text":"128"}],"answer":"A","topics":["rates","arithmetic"],"difficulty":1,"p":1,"n":22},{"id":"mathleague-2012-13-g4-23","type":"mc","prompt":"Today is my birthday. If my age in months is 99 greater than my age in years, how many years old am I now?","choices":[{"key":"A","text":"9"},{"key":"B","text":"11"},{"key":"C","text":"12"},{"key":"D","text":"14"}],"answer":"A","topics":["algebra","time-calendar"],"difficulty":2,"p":1,"n":23},{"id":"mathleague-2012-13-g4-24","type":"mc","prompt":"The radius of a circle is half the length of the side of a square. The square's perimeter is equal to the diameter of the circle multiplied by","choices":[{"key":"A","text":"2"},{"key":"B","text":"4"},{"key":"C","text":"8"},{"key":"D","text":"16"}],"answer":"B","topics":["geometry"],"difficulty":1,"p":1,"n":24},{"id":"mathleague-2012-13-g4-25","type":"mc","prompt":"When each of the following is divided by 8, only $\\underline{\\;?\\;}$ has a remainder that is a prime number.","choices":[{"key":"A","text":"548"},{"key":"B","text":"569"},{"key":"C","text":"678"},{"key":"D","text":"778"}],"answer":"D","topics":["number-theory"],"difficulty":2,"p":1,"n":25},{"id":"mathleague-2012-13-g4-26","type":"mc","prompt":"My aunt can fold 16 paper cranes in 4 minutes. My uncle can fold 15 paper cranes in 5 minutes. How long would it take them to fold 42 cranes if they work together at those rates?","choices":[{"key":"A","text":"6 minutes"},{"key":"B","text":"9 minutes"},{"key":"C","text":"12 minutes"},{"key":"D","text":"13 minutes"}],"answer":"A","topics":["rates"],"difficulty":2,"p":1,"n":26},{"id":"mathleague-2012-13-g4-27","type":"mc","prompt":"If $1 + 3 + 5 + 7 + 9 + \\ldots + 99 = 2500$, then $3 + 5 + 7 + 9 + \\ldots + 101 =$","choices":[{"key":"A","text":"2500"},{"key":"B","text":"2600"},{"key":"C","text":"2601"},{"key":"D","text":"2700"}],"answer":"B","topics":["patterns","arithmetic"],"difficulty":2,"p":1,"n":27},{"id":"mathleague-2012-13-g4-28","type":"mc","prompt":"Alfonse's high chair is 10 times as tall as his cat. His cat is 8 times as tall as his pet rat. His rat is 6 times as tall as his pet cricket. If his cricket is 4 mm tall, how tall is Alfonse's high chair?","choices":[{"key":"A","text":"28 mm"},{"key":"B","text":"480 mm"},{"key":"C","text":"960 mm"},{"key":"D","text":"1920 mm"}],"answer":"D","topics":["arithmetic","measurement"],"difficulty":1,"p":1,"n":28},{"id":"mathleague-2012-13-g4-29","type":"mc","prompt":"Ray runs every other day. If he ran for the first time last month on a Monday, then he ran for the tenth time last month on a","choices":[{"key":"A","text":"Monday"},{"key":"B","text":"Tuesday"},{"key":"C","text":"Friday"},{"key":"D","text":"Sunday"}],"answer":"C","topics":["time-calendar","patterns"],"difficulty":2,"p":1,"n":29},{"id":"mathleague-2012-13-g4-30","type":"mc","prompt":"How many of the whole numbers less than 100 are 10 greater than an odd whole number?","choices":[{"key":"A","text":"45"},{"key":"B","text":"46"},{"key":"C","text":"90"},{"key":"D","text":"91"}],"answer":"A","topics":["counting","number-theory"],"difficulty":2,"p":1,"n":30},{"id":"mathleague-2018-19-g4-01","type":"mc","prompt":"Which of the following sums and products is an odd number?","choices":[{"key":"A","text":"$2018 \\times 2019$"},{"key":"B","text":"$2019 \\times 2020$"},{"key":"C","text":"$2018 + 2019$"},{"key":"D","text":"$2019 + 2021$"}],"answer":"C","topics":["arithmetic","number-theory"],"difficulty":1,"p":2,"n":1},{"id":"mathleague-2018-19-g4-02","type":"mc","prompt":"If Zach multiplied the whole number on his shirt by itself, which of the following could be his result?","choices":[{"key":"A","text":"24"},{"key":"B","text":"25"},{"key":"C","text":"26"},{"key":"D","text":"27"}],"answer":"B","topics":["arithmetic","number-theory"],"difficulty":1,"p":2,"n":2},{"id":"mathleague-2018-19-g4-03","type":"mc","prompt":"What is the product of 49 ones?","choices":[{"key":"A","text":"1"},{"key":"B","text":"7"},{"key":"C","text":"49"},{"key":"D","text":"50"}],"answer":"A","topics":["arithmetic"],"difficulty":1,"p":2,"n":3},{"id":"mathleague-2018-19-g4-04","type":"mc","prompt":"4 dozen socks = $\\underline{\\;?\\;}$ pairs of socks","choices":[{"key":"A","text":"2"},{"key":"B","text":"24"},{"key":"C","text":"48"},{"key":"D","text":"96"}],"answer":"B","topics":["arithmetic","measurement"],"difficulty":1,"p":2,"n":4},{"id":"mathleague-2018-19-g4-05","type":"mc","prompt":"If the number of months in a year is divided by the number of days in a week, what is the remainder?","choices":[{"key":"A","text":"0"},{"key":"B","text":"2"},{"key":"C","text":"5"},{"key":"D","text":"7"}],"answer":"C","topics":["arithmetic","time-calendar"],"difficulty":1,"p":2,"n":5},{"id":"mathleague-2018-19-g4-06","type":"mc","prompt":"Henry the Hamster first danced on November 1, 2018. By April 1, 2019, for how many months had he been dancing?","choices":[{"key":"A","text":"5"},{"key":"B","text":"6"},{"key":"C","text":"7"},{"key":"D","text":"8"}],"answer":"A","topics":["time-calendar"],"difficulty":1,"p":2,"n":6},{"id":"mathleague-2018-19-g4-07","type":"mc","prompt":"$20 - 18 + 20 - 18 + 20 - 18 = ?$","choices":[{"key":"A","text":"2"},{"key":"B","text":"4"},{"key":"C","text":"6"},{"key":"D","text":"8"}],"answer":"C","topics":["arithmetic"],"difficulty":1,"p":2,"n":7},{"id":"mathleague-2018-19-g4-08","type":"mc","prompt":"What is the ones digit in the product $12 \\times 13 \\times 14$?","choices":[{"key":"A","text":"2"},{"key":"B","text":"4"},{"key":"C","text":"6"},{"key":"D","text":"8"}],"answer":"B","topics":["arithmetic","number-theory"],"difficulty":1,"p":2,"n":8},{"id":"mathleague-2018-19-g4-09","type":"mc","prompt":"Which of the following is greatest?","choices":[{"key":"A","text":"$1 \\times 2 \\times 12$"},{"key":"B","text":"$2 \\times 3 \\times 4$"},{"key":"C","text":"$4 \\times 2 \\times 2$"},{"key":"D","text":"$2 \\times 4 \\times 4$"}],"answer":"D","topics":["arithmetic"],"difficulty":1,"p":2,"n":9},{"id":"mathleague-2018-19-g4-10","type":"mc","prompt":"Sandra uses two entire erasers for every 15 questions she answers. If erasers come in packs of 12, at least how many packs does she need for her 100-question test?","choices":[{"key":"A","text":"2"},{"key":"B","text":"3"},{"key":"C","text":"4"},{"key":"D","text":"5"}],"answer":"A","topics":["arithmetic","rates"],"difficulty":2,"p":2,"n":10},{"id":"mathleague-2018-19-g4-11","type":"mc","prompt":"The greatest whole-number multiple of 7 that is less than 100 is","choices":[{"key":"A","text":"91"},{"key":"B","text":"93"},{"key":"C","text":"97"},{"key":"D","text":"98"}],"answer":"D","topics":["number-theory","arithmetic"],"difficulty":1,"p":2,"n":11},{"id":"mathleague-2018-19-g4-12","type":"mc","prompt":"The digit $\\underline{\\;?\\;}$ appears only one time in the sum of 654 and 456.","choices":[{"key":"A","text":"0"},{"key":"B","text":"1"},{"key":"C","text":"2"},{"key":"D","text":"3"}],"answer":"A","topics":["arithmetic"],"difficulty":1,"p":2,"n":12},{"id":"mathleague-2018-19-g4-13","type":"mc","prompt":"Ella wears a sweater of a different color each day of the week—red for Sundays, blue for Mondays, etc. Each of her many sweaters is one of 7 different colors. She donates each sweater to charity after wearing it 4 times! The least number of sweaters Ella wears during December is","choices":[{"key":"A","text":"7"},{"key":"B","text":"8"},{"key":"C","text":"10"},{"key":"D","text":"12"}],"answer":"C","topics":["time-calendar","logic"],"difficulty":2,"p":2,"n":13},{"id":"mathleague-2018-19-g4-14","type":"mc","prompt":"How many whole numbers greater than 10 and less than 200 can be written using only even digits?","choices":[{"key":"A","text":"16"},{"key":"B","text":"20"},{"key":"C","text":"25"},{"key":"D","text":"50"}],"answer":"B","topics":["counting"],"difficulty":2,"p":2,"n":14},{"id":"mathleague-2018-19-g4-15","type":"mc","prompt":"Noah has a soccer game every day and scores two goals in every game. How many weeks will it take him to score 56 goals?","choices":[{"key":"A","text":"3"},{"key":"B","text":"4"},{"key":"C","text":"5"},{"key":"D","text":"18"}],"answer":"B","topics":["rates","time-calendar"],"difficulty":1,"p":2,"n":15},{"id":"mathleague-2018-19-g4-16","type":"mc","prompt":"Chris ran each lap of his 10-lap race in 90 seconds. After running for 6 minutes, how many laps did Chris have *left* to run?","choices":[{"key":"A","text":"3"},{"key":"B","text":"4"},{"key":"C","text":"5"},{"key":"D","text":"6"}],"answer":"D","topics":["rates","measurement"],"difficulty":1,"p":2,"n":16},{"id":"mathleague-2018-19-g4-17","type":"mc","prompt":"How many pairs of unequal whole numbers greater than 40 and less than 60 sum to 100?","choices":[{"key":"A","text":"9"},{"key":"B","text":"10"},{"key":"C","text":"18"},{"key":"D","text":"20"}],"answer":"A","topics":["counting","arithmetic"],"difficulty":1,"p":2,"n":17},{"id":"mathleague-2018-19-g4-18","type":"mc","prompt":"$2 \\times 4 \\times 5 \\times 25 = ?$","choices":[{"key":"A","text":"$6 \\times 125$"},{"key":"B","text":"$6 \\times 150$"},{"key":"C","text":"$8 \\times 150$"},{"key":"D","text":"$10 \\times 100$"}],"answer":"D","topics":["arithmetic"],"difficulty":1,"p":2,"n":18},{"id":"mathleague-2018-19-g4-19","type":"mc","prompt":"The average of 3 numbers is a whole number. If one number is 2, and the other 2 numbers are equal, the other numbers could each be","choices":[{"key":"A","text":"3"},{"key":"B","text":"4"},{"key":"C","text":"5"},{"key":"D","text":"6"}],"answer":"C","topics":["statistics","arithmetic"],"difficulty":2,"p":2,"n":19},{"id":"mathleague-2018-19-g4-20","type":"mc","prompt":"\\$2000 – 200¢ + \\$20 – 2¢ =","choices":[{"key":"A","text":"\\$1999.98"},{"key":"B","text":"\\$2017.80"},{"key":"C","text":"\\$2017.98"},{"key":"D","text":"\\$2020.20"}],"answer":"C","topics":["money","fractions-decimals"],"difficulty":1,"p":2,"n":20},{"id":"mathleague-2018-19-g4-21","type":"mc","prompt":"Joey has only large and small boxes. In each large box there are exactly four small boxes. If Joey has 20 boxes total, the lowest possible number of small boxes that Joey has is","choices":[{"key":"A","text":"4"},{"key":"B","text":"5"},{"key":"C","text":"15"},{"key":"D","text":"16"}],"answer":"D","topics":["logic","arithmetic"],"difficulty":2,"p":2,"n":21},{"id":"mathleague-2018-19-g4-22","type":"mc","prompt":"How many whole numbers between 100 and 200 are divisible by both 4 and 6?","choices":[{"key":"A","text":"6"},{"key":"B","text":"7"},{"key":"C","text":"8"},{"key":"D","text":"10"}],"answer":"C","topics":["number-theory"],"difficulty":2,"p":2,"n":22},{"id":"mathleague-2018-19-g4-23","type":"mc","prompt":"Jake bought cheese slices to put on his daily sandwich. If he puts 6 cheese slices on each sandwich, then one day he will have 2 cheese slices left over. If he puts 5 cheese slices on each sandwich, then one day he will have 3 cheese slices left over. He could have started with $\\underline{\\;?\\;}$ cheese slices.","choices":[{"key":"A","text":"13"},{"key":"B","text":"14"},{"key":"C","text":"26"},{"key":"D","text":"38"}],"answer":"D","topics":["number-theory"],"difficulty":2,"p":2,"n":23},{"id":"mathleague-2018-19-g4-24","type":"mc","prompt":"In Olive's kingdom, castles have 8 beds and homes have 2 beds. If there are 48 beds and 3 castles, how many homes are there?","choices":[{"key":"A","text":"12"},{"key":"B","text":"16"},{"key":"C","text":"24"},{"key":"D","text":"48"}],"answer":"A","topics":["arithmetic","algebra"],"difficulty":1,"p":2,"n":24},{"id":"mathleague-2018-19-g4-25","type":"mc","prompt":"How many whole numbers greater than 100 and less than 1000 have all three digits different from one another?","choices":[{"key":"A","text":"648"},{"key":"B","text":"720"},{"key":"C","text":"729"},{"key":"D","text":"900"}],"answer":"A","topics":["counting"],"difficulty":2,"p":2,"n":25},{"id":"mathleague-2018-19-g4-26","type":"mc","prompt":"Of the following intervals, which includes the most prime numbers?","choices":[{"key":"A","text":"20 and 30"},{"key":"B","text":"30 and 40"},{"key":"C","text":"40 and 50"},{"key":"D","text":"50 and 60"}],"answer":"C","topics":["number-theory"],"difficulty":2,"p":2,"n":26},{"id":"mathleague-2018-19-g4-27","type":"mc","prompt":"Simona has only dimes and quarters, which total exactly one dollar. If she has at least one dime and at least one quarter, how many coins **must** she have all together?","choices":[{"key":"A","text":"4"},{"key":"B","text":"7"},{"key":"C","text":"9"},{"key":"D","text":"10"}],"answer":"B","topics":["money","logic"],"difficulty":2,"p":2,"n":27},{"id":"mathleague-2018-19-g4-28","type":"mc","prompt":"Briana can solve 6 puzzle cubes in 4 minutes, and Avima can solve 5 puzzle cubes in 6 minutes. At these rates, Briana can solve one cube $\\underline{\\;?\\;}$ seconds more quickly than Avima can.","choices":[{"key":"A","text":"24"},{"key":"B","text":"27"},{"key":"C","text":"30"},{"key":"D","text":"32"}],"answer":"D","topics":["rates"],"difficulty":2,"p":2,"n":28},{"id":"mathleague-2018-19-g4-29","type":"mc","prompt":"$\\underline{\\;?\\;}$ is the product of exactly 2 prime numbers.","choices":[{"key":"A","text":"2018"},{"key":"B","text":"2020"},{"key":"C","text":"3018"},{"key":"D","text":"3020"}],"answer":"A","topics":["number-theory"],"difficulty":3,"p":2,"n":29},{"id":"mathleague-2018-19-g4-30","type":"mc","prompt":"At most how many 1-by-3 rectangles that do not overlap can fit in a 5-by-7 rectangle?","choices":[{"key":"A","text":"9"},{"key":"B","text":"10"},{"key":"C","text":"11"},{"key":"D","text":"12"}],"answer":"C","topics":["geometry","spatial"],"difficulty":3,"p":2,"n":30}]}